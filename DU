(function () {
  'use strict';

  const LIST_SELECTOR = "#upgrade-deed-real-estate-number";

  // إعدادات التوجيه والأسهم
  const MAX_CLICKS = 6;
  const CLICK_INTERVAL = 100;
  const SCROLL_TIMES = 3;
  const SCROLL_INTERVAL = 500;

  function delay(ms) {
    return new Promise(resolve => setTimeout(resolve, ms));
  }

  function getOrderIdFromUrl() {
    const params = new URLSearchParams(window.location.search);
    return params.get("caseId") || params.get("requestId") || (document.body.innerText.match(/\bDU\d+\b/)?.[0] || null);
  }

  // ==========================================
  // 1. النزول لأسفل الصفحة لضمان تحميل العناصر
  // ==========================================
  async function scrollToBottomRepeated(times = SCROLL_TIMES, interval = SCROLL_INTERVAL) {
    for (let i = 1; i <= times; i++) {
      const heightBefore = document.body.scrollHeight;
      window.scrollTo({
        top: heightBefore,
        behavior: "smooth"
      });
      await delay(interval);
    }
  }

  // ==========================================
  // 2. الضغط على زر السهم للانتقال للمراجعة
  // ==========================================
  async function navigateToReviewStep() {
    let clicked = 0;
    let retries = 0;
    const maxRetries = 20; // مهلة انتظار ظهور السهم أول مرة (10 ثوانٍ)

    while (clicked < MAX_CLICKS && retries < maxRetries) {
      const img = document.querySelector('button img[src$="left.svg"]');

      if (!img) {
        retries++;
        await delay(500);
        continue;
      }

      const btn = img.closest("button");
      if (!btn) {
        retries++;
        await delay(500);
        continue;
      }

      try {
        btn.dispatchEvent(
          new MouseEvent("click", {
            bubbles: true,
            cancelable: true,
            view: window
          })
        );
        clicked++;
      } catch (error) {
        console.error("[DU Detail] Click error:", error);
      }

      await delay(CLICK_INTERVAL);
    }

    await delay(500);
    await scrollToBottomRepeated();
  }

  // ==========================================
  // 3. انتظار وظهور قائمة الـ PCP
  // ==========================================
  function waitForElement(selector, timeout = 15000) {
    return new Promise((resolve, reject) => {
      const el = document.querySelector(selector);
      if (el) return resolve(el);

      const observer = new MutationObserver(() => {
        const target = document.querySelector(selector);
        if (target) {
          observer.disconnect();
          resolve(target);
        }
      });

      observer.observe(document.body, { childList: true, subtree: true });

      setTimeout(() => {
        observer.disconnect();
        reject(new Error(`تعذر العثور على القائمة: ${selector}`));
      }, timeout);
    });
  }

  // ==========================================
  // 4. استخراج القيم والتمييز البصري
  // ==========================================
  async function executeExtraction() {
    const orderId = getOrderIdFromUrl();

    try {
      // أ- الانتقال أولاً عبر الضغط على الأسهم والتمرير
      await navigateToReviewStep();

      // ب- انتظار ظهور قائمة أرقام العقارات / الصكوك
      const listElement = await waitForElement(LIST_SELECTOR, 15000);
      listElement.classList.add("du-highlight-green");

      await delay(300);

      const extractedValues = [];

      if (listElement.tagName.toLowerCase() === "select") {
        const options = [...listElement.options].filter(o => o.value && o.value.trim() !== "");
        options.forEach(opt => {
          const txt = opt.text.trim();
          if (txt && !extractedValues.includes(txt)) extractedValues.push(txt);
        });
      } else {
        const subItems = listElement.querySelectorAll("li, tr, div[role='option'], .option, span, p");
        if (subItems.length > 0) {
          subItems.forEach(item => {
            const val = item.innerText.trim();
            if (val && !extractedValues.includes(val)) {
              extractedValues.push(val);
              item.classList.add("du-highlight-green");
              const badge = document.createElement("span");
              badge.className = "du-badge-check";
              badge.textContent = "✓";
              item.prepend(badge);
            }
          });
        } else {
          const directVal = listElement.value || listElement.innerText.trim();
          if (directVal) {
            extractedValues.push(directVal);
            const badge = document.createElement("span");
            badge.className = "du-badge-check";
            badge.textContent = "✓";
            listElement.parentNode.insertBefore(badge, listElement.nextSibling);
          }
        }
      }

      if (extractedValues.length === 0) {
        throw new Error("القائمة لا تحتوي على صكوك/عقارات");
      }

      // ج- إرسال البيانات الناجحة للـ Background ليغلق التبويب
      chrome.runtime.sendMessage({
        action: "DATA_EXTRACTED_SUCCESS",
        orderId: orderId,
        deedNumbers: extractedValues
      });

    } catch (err) {
      console.warn("[DU Detail Extractor]:", err.message);
      // د- إرسال تقرير الفشل ليغلق Background التبويب ويتابع ما بعده
      chrome.runtime.sendMessage({
        action: "EXTRACTION_FAILED",
        orderId: orderId,
        reason: err.message
      });
    }
  }

  // بدء التنفيذ بعد استقرار الصفحة
  if (document.readyState === "complete") {
    setTimeout(executeExtraction, 600);
  } else {
    window.addEventListener("load", () => setTimeout(executeExtraction, 600));
  }
})();
