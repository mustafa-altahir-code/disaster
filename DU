(function () {
  'use strict';

  function isExtensionValid() {
    return typeof chrome !== "undefined" && chrome.runtime && !!chrome.runtime.id;
  }

  const TABLE_SELECTOR = "#__next > div > div.w-full.p-8.transition-all.duration-700 > div > div:nth-child(2) > div > div.mt-9.my-5 > div > div.overflow-x-auto.w-full > table > tbody";
  const PAGINATION_CONTAINER = "ul.rc-pagination";
  const ACTIVE_PAGE_SELECTOR = "li.rc-pagination-item-active";
  const NEXT_PAGE_SELECTOR = "li.rc-pagination-next";

  // orderId -> { index, page, orderDate, lastUpdate, statusText, values, status: "pending" | "done" | "failed" }
  const tasksMap = new Map();

  let running = false;
  let globalCounter = 0;
  let selectedConcurrency = 2;
  let activeWorkersCount = 0;

  // ===== بناء الواجهة التفاعلية (HUD) مع الأعمدة الجديدة =====
  const panel = document.createElement('div');
  panel.id = "du-crawler-hud";
  panel.style.cssText = `
    position: fixed;
    bottom: 20px;
    right: 20px;
    width: 880px;
    height: 600px;
    background: #0f172a;
    color: #38bdf8;
    z-index: 999999;
    font-family: system-ui, -apple-system, sans-serif;
    border: 1px solid #334155;
    box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.7);
    border-radius: 8px;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    direction: rtl;
  `;

  panel.innerHTML = `
    <!-- الرأس والأزرار -->
    <div style="padding: 10px 14px; display:flex; justify-content:space-between; align-items:center; background:#1e293b; border-bottom:1px solid #334155">
      <b style="color:#f8fafc; font-size:14px">DU Crawler Panel (مستخرج البيانات الموسع)</b>
      <div style="display:flex; gap:6px">
        <button id="du-btn-toggle" style="background:#16a34a;color:#fff;border:none;padding:5px 12px;border-radius:4px;cursor:pointer;font-weight:600">بدء</button>
        <button id="du-btn-retry" style="background:#d97706;color:#fff;border:none;padding:5px 12px;border-radius:4px;cursor:pointer;font-weight:600">إعادة الفاشل (0)</button>
        <button id="du-btn-clean" style="background:#334155;color:#e2e8f0;border:none;padding:5px 10px;border-radius:4px;cursor:pointer">تفريغ</button>
        <button id="du-btn-csv" style="background:#0284c7;color:#fff;border:none;padding:5px 12px;border-radius:4px;cursor:pointer;font-weight:600">تصدير CSV</button>
      </div>
    </div>

    <!-- شريط النطاق واختيار عدد التابات -->
    <div style="padding: 6px 14px; background:#1e293b; border-bottom:1px solid #334155; font-size:12px; display:flex; align-items:center; justify-content:space-between; color:#94a3b8">
      <div style="display:flex; align-items:center; gap:8px">
        <span>نطاق الصفحات:</span>
        <label style="display:flex; align-items:center; gap:3px">من:
          <input type="number" id="du-page-start" min="1" placeholder="الحالية" style="width:55px; background:#0f172a; border:1px solid #475569; color:#f8fafc; padding:2px; border-radius:3px; text-align:center" />
        </label>
        <label style="display:flex; align-items:center; gap:3px">إلى:
          <input type="number" id="du-page-end" min="1" placeholder="الكل" style="width:55px; background:#0f172a; border:1px solid #475569; color:#f8fafc; padding:2px; border-radius:3px; text-align:center" />
        </label>
      </div>

      <div style="display:flex; align-items:center; gap:6px">
        <span>عدد التابات بالتوازي:</span>
        <select id="du-concurrency-select" style="background:#0f172a; border:1px solid #475569; color:#38bdf8; padding:2px 8px; border-radius:3px; font-weight:bold; cursor:pointer">
          <option value="1">1 تاب (مستقر جداً)</option>
          <option value="2" selected>2 تابات (متوازن وسريع)</option>
          <option value="3">3 تابات</option>
          <option value="4">4 تابات</option>
        </select>
      </div>
    </div>

    <!-- الإحصائيات المباشرة -->
    <div style="padding: 6px 14px; background:#0f172a; border-bottom:1px solid #334155; font-size:12px; display:flex; justify-content:space-between; color:#94a3b8">
      <span>المرحلة: <b id="du-phase-text" style="color:#f59e0b">جاهز</b></span>
      <span>الصفحة: <b id="du-page-num" style="color:#f8fafc">-</b></span>
      <span>المكتمل: <b id="du-done-count" style="color:#4ade80">0</b> / <b id="du-total-count" style="color:#38bdf8">0</b></span>
      <span>التابات النشطة: <b id="du-active-slots" style="color:#38bdf8">0/2</b></span>
    </div>

    <!-- جدول عرض النتائج -->
    <div style="flex:1; overflow-y:auto; padding:6px;">
      <table style="width:100%; border-collapse:collapse; font-size:11px; text-align:right">
        <thead>
          <tr style="background:#1e293b; color:#94a3b8">
            <th style="padding:6px; border-bottom:1px solid #334155; width:5%; text-align:center">#</th>
            <th style="padding:6px; border-bottom:1px solid #334155; width:6%; text-align:center">الصفحة</th>
            <th style="padding:6px; border-bottom:1px solid #334155; width:15%">Case no</th>
            <th style="padding:6px; border-bottom:1px solid #334155; width:16%">تاريخ الطلب</th>
            <th style="padding:6px; border-bottom:1px solid #334155; width:16%">آخر تحديث</th>
            <th style="padding:6px; border-bottom:1px solid #334155; width:18%">حالة الطلب</th>
            <th style="padding:6px; border-bottom:1px solid #334155; width:24%">Pcp</th>
          </tr>
        </thead>
        <tbody id="du-table-body"></tbody>
      </table>
    </div>
  `;

  document.body.appendChild(panel);

  const btnToggle = panel.querySelector("#du-btn-toggle");
  const btnRetry = panel.querySelector("#du-btn-retry");
  const btnClean = panel.querySelector("#du-btn-clean");
  const btnCsv = panel.querySelector("#du-btn-csv");
  const inputStartPage = panel.querySelector("#du-page-start");
  const inputEndPage = panel.querySelector("#du-page-end");
  const selectConcurrency = panel.querySelector("#du-concurrency-select");
  const tableBody = panel.querySelector("#du-table-body");

  const lblPhase = panel.querySelector("#du-phase-text");
  const lblPage = panel.querySelector("#du-page-num");
  const lblDoneCount = panel.querySelector("#du-done-count");
  const lblTotalCount = panel.querySelector("#du-total-count");
  const lblActiveSlots = panel.querySelector("#du-active-slots");

  selectConcurrency.onchange = () => {
    selectedConcurrency = parseInt(selectConcurrency.value, 10) || 2;
    lblActiveSlots.textContent = `${activeWorkersCount}/${selectedConcurrency}`;
  };

  btnToggle.onclick = () => {
    running = !running;
    btnToggle.textContent = running ? "إيقاف مؤقت" : "بدء";
    btnToggle.style.background = running ? "#dc2626" : "#16a34a";

    if (running) {
      startMasterProcess();
    } else {
      lblPhase.textContent = "متوقف مؤقتاً";
      chrome.runtime.sendMessage({ action: "FORCE_STOP" });
    }
  };

  btnRetry.onclick = () => {
    if (running) return;

    const failedKeys = [...tasksMap.entries()].filter(([_, d]) => d.status === "failed");
    if (failedKeys.length === 0) {
      alert("لا توجد طلبات فاشلة لإعادة محاولتها.");
      return;
    }

    failedKeys.forEach(([_, d]) => {
      d.status = "pending";
      d.values = ["إعادة المحاولة..."];
    });

    renderUI();
    running = true;
    btnToggle.textContent = "إيقاف مؤقت";
    btnToggle.style.background = "#dc2626";

    lblPhase.textContent = `إعادة محاولة ${failedKeys.length} طلب فاشل...`;
    processPendingOrdersBatch();
  };

  btnClean.onclick = () => {
    tasksMap.clear();
    globalCounter = 0;
    activeWorkersCount = 0;
    renderUI();
  };

  btnCsv.onclick = exportCSV;

  function requestOrderExtraction(orderId, url) {
    return new Promise((resolve) => {
      if (!isExtensionValid() || !running) {
        return resolve({ status: "STOPPED", orderId });
      }

      chrome.runtime.sendMessage({
        action: "PROCESS_ORDER_CONCURRENT",
        orderId: orderId,
        url: url,
        concurrency: selectedConcurrency
      }, (res) => {
        if (chrome.runtime.lastError) {
          resolve({ status: "FAILED", orderId, reason: chrome.runtime.lastError.message });
        } else {
          resolve(res || { status: "FAILED", orderId, reason: "لا توجد استجابة" });
        }
      });
    });
  }

  // ===== دوال الترقيم ومسح الصفحات =====

  function getActivePageNumber() {
    const pag = document.querySelector(PAGINATION_CONTAINER);
    if (!pag) return null;
    const activeItem = pag.querySelector(ACTIVE_PAGE_SELECTOR);
    return activeItem ? parseInt(activeItem.innerText.trim(), 10) : null;
  }

  function isNextDisabled() {
    const pag = document.querySelector(PAGINATION_CONTAINER);
    if (!pag) return true;
    const nextLi = pag.querySelector(NEXT_PAGE_SELECTOR);
    return !nextLi || nextLi.classList.contains("rc-pagination-disabled") || nextLi.getAttribute("aria-disabled") === "true";
  }

  function getFirstDUInTable() {
    const firstRow = document.querySelector(`${TABLE_SELECTOR} tr`);
    return firstRow ? (firstRow.innerText.match(/\bDU\d+\b/)?.[0] || null) : null;
  }

  async function clickPageDirectly(page) {
    const pag = document.querySelector(PAGINATION_CONTAINER);
    if (!pag) return false;

    const items = [...pag.querySelectorAll("li.rc-pagination-item")];
    const targetLi = items.find(li => li.innerText.trim() === String(page));

    if (targetLi) {
      const clickEl = targetLi.querySelector("a, button") || targetLi;
      clickEl.click();
      return true;
    }

    const nextLi = pag.querySelector(NEXT_PAGE_SELECTOR);
    if (nextLi && !isNextDisabled()) {
      const clickEl = nextLi.querySelector("a, button") || nextLi;
      clickEl.click();
      return true;
    }
    return false;
  }

  async function navigateAndWait(targetPage, oldFirstDU, timeout = 12000) {
    const start = Date.now();
    await clickPageDirectly(targetPage);

    while (Date.now() - start < timeout) {
      if (!running) return false;
      const activeNum = getActivePageNumber();
      const currentFirstDU = getFirstDUInTable();

      if (activeNum === targetPage && currentFirstDU && currentFirstDU !== oldFirstDU) {
        await new Promise(r => setTimeout(r, 1200));
        return true;
      }
      await new Promise(r => setTimeout(r, 400));
    }
    return false;
  }

  // استخراج الأعمدة: 1 (رقم الطلب)، 2 (تاريخ الطلب)، 5 (آخر تحديث)، 6 (حالة الطلب)
  async function scanOrdersOnCurrentPage(pageNumber) {
    let list = [];
    let attempts = 0;

    while (attempts < 6) {
      if (!running) return [];
      attempts++;

      const tbody = document.querySelector(TABLE_SELECTOR);
      if (tbody) {
        const rows = tbody.querySelectorAll("tr");
        list = [];

        rows.forEach(row => {
          const cols = row.querySelectorAll("td");
          if (cols.length < 6) return;

          const match = row.innerText.match(/\bDU\d+\b/);
          if (match) {
            const orderId = match[0];
            const orderDate = cols[1]?.innerText?.trim().replace(/\s+/g, ' ') || "-";
            const lastUpdate = cols[4]?.innerText?.trim().replace(/\s+/g, ' ') || "-";
            const statusText = cols[5]?.innerText?.trim().replace(/\s+/g, ' ') || "-";

            list.push({ orderId, orderDate, lastUpdate, statusText });
          }
        });

        if (list.length >= 10 || (attempts >= 4 && list.length > 0)) break;
      }
      await new Promise(r => setTimeout(r, 500));
    }

    list.forEach(item => {
      if (!tasksMap.has(item.orderId)) {
        globalCounter++;
        tasksMap.set(item.orderId, {
          index: globalCounter,
          page: pageNumber,
          orderDate: item.orderDate,
          lastUpdate: item.lastUpdate,
          statusText: item.statusText,
          values: ["قيد الانتظار..."],
          status: "pending"
        });
      }
    });

    renderUI();
    return list;
  }

  // ===== معالجة الاستخراج بالتوازي =====

  async function processPendingOrdersBatch() {
    const pendingList = [...tasksMap.entries()].filter(([_, d]) => d.status === "pending");

    if (pendingList.length === 0) {
      lblPhase.textContent = "لا توجد طلبات قيد الانتظار.";
      running = false;
      btnToggle.textContent = "بدء";
      btnToggle.style.background = "#16a34a";
      return;
    }

    let pointer = 0;

    async function worker() {
      while (pointer < pendingList.length && running) {
        const currentIndex = pointer++;
        const [orderId, data] = pendingList[currentIndex];

        activeWorkersCount++;
        lblActiveSlots.textContent = `${activeWorkersCount}/${selectedConcurrency}`;

        const targetUrl = `https://ops.rer.sa/deed-upgrade-case-view?caseId=${orderId}`;
        const result = await requestOrderExtraction(orderId, targetUrl);

        activeWorkersCount = Math.max(0, activeWorkersCount - 1);
        lblActiveSlots.textContent = `${activeWorkersCount}/${selectedConcurrency}`;

        if (result.status === "SUCCESS") {
          data.values = result.deedNumbers || [];
          data.status = "done";
        } else {
          data.values = [`⚠️ ${result.reason || "فشل"}`];
          data.status = "failed";
        }

        renderUI();
        await new Promise(r => setTimeout(r, 300));
      }
    }

    const workers = [];
    const poolSize = Math.min(selectedConcurrency, pendingList.length);
    for (let i = 0; i < poolSize; i++) {
      workers.push(worker());
    }

    await Promise.all(workers);

    if (running) {
      const remainingFailed = [...tasksMap.values()].filter(d => d.status === "failed").length;
      if (remainingFailed > 0) {
        lblPhase.textContent = `اكتملت المعالجة (يوجد ${remainingFailed} طلب فاشل، يمكنك الضغط على إعادة الفاشل).`;
        lblPhase.style.color = "#d97706";
      } else {
        lblPhase.textContent = "اكتملت جميع العمليات بنجاح 100%!";
        lblPhase.style.color = "#22c55e";
      }

      btnToggle.textContent = "بدء";
      btnToggle.style.background = "#16a34a";
      running = false;
    }
  }

  // ===== التدفق العام =====

  async function startMasterProcess() {
    selectedConcurrency = parseInt(selectConcurrency.value, 10) || 2;
    const startVal = parseInt(inputStartPage.value, 10);
    const endVal = parseInt(inputEndPage.value, 10);

    let activeNum = getActivePageNumber() || 1;
    let targetPage = (!isNaN(startVal) && startVal >= 1) ? startVal : activeNum;

    // المرحلة 1: المسح واستخراج بيانات الأعمدة
    lblPhase.textContent = "المرحلة 1: تجميع الطلبات وبيانات الأعمدة";
    lblPhase.style.color = "#f59e0b";

    if (activeNum !== targetPage) {
      lblPhase.textContent = `انتقال لصفحة البداية: ${targetPage}...`;
      const oldDU = getFirstDUInTable();
      await navigateAndWait(targetPage, oldDU);
    }

    while (running) {
      const currentPage = getActivePageNumber() || targetPage;
      lblPage.textContent = currentPage;

      if (!isNaN(endVal) && currentPage > endVal) break;

      lblPhase.textContent = `مسح طلبات صفحة ${currentPage}...`;
      await scanOrdersOnCurrentPage(currentPage);

      if (!isNaN(endVal) && currentPage >= endVal) break;
      if (isNextDisabled()) break;

      const nextPage = currentPage + 1;
      lblPhase.textContent = `الانتقال لصفحة ${nextPage}...`;
      const oldDU = getFirstDUInTable();
      const moved = await navigateAndWait(nextPage, oldDU);

      if (!moved) break;
      targetPage = nextPage;
    }

    if (!running) return;

    // المرحلة 2: استخراج الصكوك
    lblPhase.textContent = `المرحلة 2: استخراج الصكوك (${selectedConcurrency} تابات بالتوازي)`;
    lblPhase.style.color = "#4ade80";

    await processPendingOrdersBatch();
  }

  function renderUI() {
    const done = [...tasksMap.values()].filter(t => t.status === "done").length;
    const failed = [...tasksMap.values()].filter(t => t.status === "failed").length;

    lblDoneCount.textContent = done;
    lblTotalCount.textContent = tasksMap.size;
    btnRetry.textContent = `إعادة الفاشل (${failed})`;

    tableBody.innerHTML = [...tasksMap.entries()]
      .map(([orderId, data]) => `
        <tr>
          <td style="padding:4px; border-bottom:1px solid #1e293b; text-align:center; color:#94a3b8; font-weight:bold">${data.index}</td>
          <td style="padding:4px; border-bottom:1px solid #1e293b; text-align:center; color:#e2e8f0"><span style="background:#334155; padding:1px 5px; border-radius:3px">${data.page}</span></td>
          <td style="padding:4px; border-bottom:1px solid #1e293b; font-family:monospace; color:#38bdf8">${orderId}</td>
          <td style="padding:4px; border-bottom:1px solid #1e293b; color:#94a3b8">${data.orderDate}</td>
          <td style="padding:4px; border-bottom:1px solid #1e293b; color:#94a3b8">${data.lastUpdate}</td>
          <td style="padding:4px; border-bottom:1px solid #1e293b; color:#cbd5e1">${data.statusText}</td>
          <td style="padding:4px; border-bottom:1px solid #1e293b; color:#f1f5f9">
            ${data.values.map(v => `<span style="display:inline-block; background:${data.status === 'done' ? '#1e293b' : (data.status === 'failed' ? '#7f1d1d' : '#334155')}; padding:2px 6px; margin:1px; border-radius:3px; font-size:10px; border:1px solid ${data.status === 'done' ? '#334155' : (data.status === 'failed' ? '#ef4444' : '#475569')}">${v}</span>`).join('')}
          </td>
        </tr>
      `).join('');
  }

  // ===== تصدير CSV مع كامل الأعمدة الجديدة =====
  function exportCSV() {
    if (tasksMap.size === 0) {
      alert("لا توجد بيانات متاحة للتصدير.");
      return;
    }

    const rows = [["#", "Page", "Case no", "Order Date", "Last Update", "Status", "Pcp"]];

    tasksMap.forEach((data, caseNo) => {
      const pcpCombined = data.values.join(" | ");
      const escape = (val) => `"${String(val || '').replace(/"/g, '""')}"`;

      rows.push([
        data.index,
        data.page,
        escape(caseNo),
        escape(data.orderDate),
        escape(data.lastUpdate),
        escape(data.statusText),
        escape(pcpCombined)
      ]);
    });

    const csvContent = "\uFEFF" + rows.map(r => r.join(",")).join("\n");
    const blob = new Blob([csvContent], { type: "text/csv;charset=utf-8;" });
    const url = URL.createObjectURL(blob);

    const a = document.createElement("a");
    a.href = url;
    a.download = `DU_Full_Export_${new Date().toISOString().slice(0, 10)}.csv`;
    a.click();
    URL.revokeObjectURL(url);
  }
})();
