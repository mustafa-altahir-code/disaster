المشكلة التي ظهرت (فتح التبويبات بدون توقف + خطأ انتهاء المهلة) سببها ثغرة تدفق (Race Condition) بين content_search.js و background.js:
 * حلقة التكرار السريعة (while loop): كانت دالة dispatchProcessWorkers() ترسل أوامر فتح التبويبات بالتتابع خلف بعضها في أجزاء من الثانية قبل أن يُنشئ المتصفح التبويب فعلياً، مما جعل المتصفح يفتح عشرات التبويبات دفعة واحدة فينهار المعالج والذاكرة، وتتأخر استجابة الصفحات فتظهر رسالة: انتهت المهلة بانتظار العنصر.
 * غياب إدارة الطابور المركزية داخل background.js: كان من المفترض ألا يقوم content_search بفتح أي تبويب مباشرة، بل يُسلّم القائمة كاملة إلى background.js، وهو المسؤول الحصري عن قفل العدد (Active Tabs Semaphore) بحيث لا يفتح تبويباً جديداً إلا بعد إغلاق التبويب السابق تماماً.
الحل الجذري المطبق:
 * نقل التحكم في فتح التبويبات بالكامل إلى background.js:
   * لوحة التحكم ترسل قائمة الطلبات كاملة مع الحد الأقصى المطلوب (مثلاً: 1 أو 2 أو 3).
   * الـ background يحتفظ بـ Semaphore صارم؛ إذا اخترت 1 فلن يوجد في المتصفح سوى تبويب واحد فقط لا غير حتى ينتهي ويُغلق.
 * إغلاق التبويب حتى عند الفشل بعد مهلة:
   * التبويب الذي يفشل أو تنتهي مهلته كان يظل مفتوحاً ويعلق العداد. الآن يتم تسجيل الخطأ وإغلاقه فوراً لتفريغ الخانة للطلب التالي.
 * زيادة مهلة انتظار العنصر في صفحة التفاصيل:
   * ضبط المهلة إلى 20 ثانية مع تأخير زمني بسيط (Stagger Delay = 800ms) بين فتح كل تبويب وآخر لتقليل الضغط على سيرفر المنصة.
1. background.js (إدارة الطابور والتحكم الصارم بعدد التبويبات)
استبدل محتوى background.js بالكامل بهذا الكود:
// ===================================================
// DU Crawler - Centralized Queue Manager (Strict Concurrency)
// ===================================================

let maxConcurrent = 1; // الافتراضي
let activeCount = 0;
const pendingQueue = []; // قائمة الطلبات المنتظرة: [{ orderId, url }]
const runningTasks = new Map(); // tabId -> { orderId, searchTabId }
let mainSearchTabId = null;

// معالجة الطابور بصرامة
function pumpQueue() {
  if (pendingQueue.length === 0 || activeCount >= maxConcurrent) {
    return;
  }

  while (activeCount < maxConcurrent && pendingQueue.length > 0) {
    const item = pendingQueue.shift();
    activeCount++;

    chrome.tabs.create({ url: item.url, active: false }, (newTab) => {
      if (chrome.runtime.lastError || !newTab) {
        activeCount = Math.max(0, activeCount - 1);
        // إعادة المحاولة في حال تعذر فتح التبويب
        pendingQueue.unshift(item);
        return;
      }

      runningTasks.set(newTab.id, {
        orderId: item.orderId,
        searchTabId: mainSearchTabId
      });

      // إشعار لوحة البحث بعدد التابات النشطة الحقيقي
      notifySearchTab("SLOTS_UPDATED", { activeCount, remaining: pendingQueue.length });
    });
  }
}

function notifySearchTab(action, payload = {}) {
  if (mainSearchTabId) {
    chrome.tabs.sendMessage(mainSearchTabId, { action, ...payload }, () => {
      if (chrome.runtime.lastError) { /* ignore */ }
    });
  }
}

chrome.runtime.onMessage.addListener((message, sender, sendResponse) => {

  // 1. بدء تشغيل قائمة الطلبات من لوحة التحكم
  if (message.action === "START_BATCH_EXTRACTION") {
    mainSearchTabId = sender.tab ? sender.tab.id : null;
    maxConcurrent = message.concurrency || 1;
    
    // تفريغ أي طابور قديم وإضافة الطلبات الجديدة
    pendingQueue.length = 0;
    message.items.forEach(item => pendingQueue.push(item));

    sendResponse({ status: "QUEUE_ACCEPTED", total: pendingQueue.length });
    pumpQueue();
    return true;
  }

  // 2. إيقاف مؤقت للعملية
  if (message.action === "PAUSE_BATCH_EXTRACTION") {
    pendingQueue.length = 0;
    sendResponse({ status: "PAUSED" });
    return true;
  }

  // 3. وصول البيانات بنجاح من صفحة الطلب
  if (message.action === "DATA_EXTRACTED_SUCCESS") {
    const senderTabId = sender.tab ? sender.tab.id : null;
    const task = runningTasks.get(senderTabId);

    if (task && task.searchTabId) {
      chrome.tabs.sendMessage(task.searchTabId, {
        action: "RECORD_SUCCESS",
        orderId: message.orderId || task.orderId,
        deedNumbers: message.deedNumbers || []
      }, () => {
        if (chrome.runtime.lastError) { /* ignore */ }
      });
    }

    // إغلاق التبويب فوراً وتحرير الخانة في الطابور
    if (senderTabId) {
      setTimeout(() => {
        chrome.tabs.remove(senderTabId, () => {
          runningTasks.delete(senderTabId);
          activeCount = Math.max(0, activeCount - 1);
          notifySearchTab("SLOTS_UPDATED", { activeCount, remaining: pendingQueue.length });
          pumpQueue(); // تشغيل الطلب التالي
        });
      }, 600);
    }
  }

  // 4. حدوث خطأ أو انتهاء المهلة في صفحة الطلب
  if (message.action === "EXTRACTION_FAILED") {
    const senderTabId = sender.tab ? sender.tab.id : null;
    const task = runningTasks.get(senderTabId);

    if (task && task.searchTabId) {
      chrome.tabs.sendMessage(task.searchTabId, {
        action: "RECORD_FAILURE",
        orderId: message.orderId || task.orderId,
        reason: message.reason || "خطأ غير محدد"
      }, () => {
        if (chrome.runtime.lastError) { /* ignore */ }
      });
    }

    // إغلاق التبويب حتى لا يعلق المتصفح بعد تسجيل الخطأ
    if (senderTabId) {
      setTimeout(() => {
        chrome.tabs.remove(senderTabId, () => {
          runningTasks.delete(senderTabId);
          activeCount = Math.max(0, activeCount - 1);
          notifySearchTab("SLOTS_UPDATED", { activeCount, remaining: pendingQueue.length });
          pumpQueue(); // تشغيل الطلب التالي
        });
      }, 1000);
    }
  }
});

// في حال تم إغلاق التبويب يدوياً
chrome.tabs.onRemoved.addListener((closedTabId) => {
  if (runningTasks.has(closedTabId)) {
    runningTasks.delete(closedTabId);
    activeCount = Math.max(0, activeCount - 1);
    notifySearchTab("SLOTS_UPDATED", { activeCount, remaining: pendingQueue.length });
    pumpQueue();
  }
});

2. content_search.js (تجميع الطلبات وإرسالها كدفعة واحدة للطابور)
استبدل محتوى content_search.js بالكامل:
(function () {
  'use strict';

  function isExtensionValid() {
    return typeof chrome !== "undefined" && chrome.runtime && !!chrome.runtime.id;
  }

  const TABLE_SELECTOR = "#__next > div > div.w-full.p-8.transition-all.duration-700 > div > div:nth-child(2) > div > div.mt-9.my-5 > div > div.overflow-x-auto.w-full > table > tbody";
  const PAGINATION_CONTAINER = "ul.rc-pagination";
  const ACTIVE_PAGE_SELECTOR = "li.rc-pagination-item-active";
  const NEXT_PAGE_SELECTOR = "li.rc-pagination-next";

  // orderId -> { index, page, values, status: "pending" | "done" | "failed" }
  const tasksMap = new Map();

  let running = false;
  let maxConcurrent = 1;
  let globalCounter = 0;

  // ===== بناء الواجهة التفاعلية (HUD) =====
  const panel = document.createElement('div');
  panel.id = "du-crawler-hud";
  panel.style.cssText = `
    position: fixed;
    bottom: 20px;
    right: 20px;
    width: 700px;
    height: 600px;
    background: #0f172a;
    color: #38bdf8;
    z-index: 999999;
    font-family: system-ui, -apple-system, sans-serif;
    border: 1px solid #334155;
    box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.7);
    border-radius: 8px;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    direction: rtl;
  `;

  panel.innerHTML = `
    <!-- الرأس والأزرار -->
    <div style="padding: 10px 14px; display:flex; justify-content:space-between; align-items:center; background:#1e293b; border-bottom:1px solid #334155">
      <b style="color:#f8fafc; font-size:14px">DU Crawler (طابور صارم ومنع فتح التابات المفرط)</b>
      <div style="display:flex; gap:6px">
        <button id="du-btn-toggle" style="background:#16a34a;color:#fff;border:none;padding:5px 14px;border-radius:4px;cursor:pointer;font-weight:600">بدء</button>
        <button id="du-btn-clean" style="background:#334155;color:#e2e8f0;border:none;padding:5px 12px;border-radius:4px;cursor:pointer">تفريغ</button>
        <button id="du-btn-csv" style="background:#0284c7;color:#fff;border:none;padding:5px 14px;border-radius:4px;cursor:pointer;font-weight:600">تصدير CSV</button>
      </div>
    </div>

    <!-- الإعدادات والتابات -->
    <div style="padding: 6px 14px; background:#1e293b; border-bottom:1px solid #334155; font-size:12px; display:flex; align-items:center; justify-content:space-between; color:#94a3b8">
      <div style="display:flex; align-items:center; gap:8px">
        <span>النطاق:</span>
        <label style="display:flex; align-items:center; gap:3px">من:
          <input type="number" id="du-page-start" min="1" placeholder="الحالية" style="width:55px; background:#0f172a; border:1px solid #475569; color:#f8fafc; padding:2px; border-radius:3px; text-align:center" />
        </label>
        <label style="display:flex; align-items:center; gap:3px">إلى:
          <input type="number" id="du-page-end" min="1" placeholder="الكل" style="width:55px; background:#0f172a; border:1px solid #475569; color:#f8fafc; padding:2px; border-radius:3px; text-align:center" />
        </label>
      </div>

      <div style="display:flex; align-items:center; gap:6px">
        <span>أقصى عدد تابات بالخلفية:</span>
        <select id="du-concurrency-select" style="background:#0f172a; border:1px solid #475569; color:#38bdf8; padding:2px 8px; border-radius:3px; font-weight:bold; cursor:pointer">
          <option value="1" selected>1 تاب (أضمن خيار بدون أخطاء)</option>
          <option value="2">2 تابات</option>
          <option value="3">3 تابات</option>
        </select>
      </div>
    </div>

    <!-- الإحصائيات المباشرة -->
    <div style="padding: 6px 14px; background:#0f172a; border-bottom:1px solid #334155; font-size:12px; display:flex; justify-content:space-between; color:#94a3b8">
      <span>المرحلة: <b id="du-phase-text" style="color:#f59e0b">جاهز</b></span>
      <span>الصفحة: <b id="du-page-num" style="color:#f8fafc">-</b></span>
      <span>المكتمل: <b id="du-done-count" style="color:#4ade80">0</b> / <b id="du-total-count" style="color:#38bdf8">0</b></span>
      <span>التابات النشطة فعلياً: <b id="du-active-slots" style="color:#f59e0b">0/1</b></span>
    </div>

    <!-- جدول عرض النتائج -->
    <div style="flex:1; overflow-y:auto; padding:6px;">
      <table style="width:100%; border-collapse:collapse; font-size:12px; text-align:right">
        <thead>
          <tr style="background:#1e293b; color:#94a3b8">
            <th style="padding:6px; border-bottom:1px solid #334155; width:8%; text-align:center">#</th>
            <th style="padding:6px; border-bottom:1px solid #334155; width:10%; text-align:center">الصفحة</th>
            <th style="padding:6px; border-bottom:1px solid #334155; width:26%">Case no (DU)</th>
            <th style="padding:6px; border-bottom:1px solid #334155; width:56%">Pcp (القيم المستخرجة)</th>
          </tr>
        </thead>
        <tbody id="du-table-body"></tbody>
      </table>
    </div>
  `;

  document.body.appendChild(panel);

  const btnToggle = panel.querySelector("#du-btn-toggle");
  const btnClean = panel.querySelector("#du-btn-clean");
  const btnCsv = panel.querySelector("#du-btn-csv");
  const inputStartPage = panel.querySelector("#du-page-start");
  const inputEndPage = panel.querySelector("#du-page-end");
  const selectConcurrency = panel.querySelector("#du-concurrency-select");
  const tableBody = panel.querySelector("#du-table-body");

  const lblPhase = panel.querySelector("#du-phase-text");
  const lblPage = panel.querySelector("#du-page-num");
  const lblDoneCount = panel.querySelector("#du-done-count");
  const lblTotalCount = panel.querySelector("#du-total-count");
  const lblActiveSlots = panel.querySelector("#du-active-slots");

  selectConcurrency.onchange = () => {
    maxConcurrent = parseInt(selectConcurrency.value, 10) || 1;
    lblActiveSlots.textContent = `0/${maxConcurrent}`;
  };

  btnToggle.onclick = () => {
    running = !running;
    btnToggle.textContent = running ? "إيقاف مؤقت" : "بدء";
    btnToggle.style.background = running ? "#dc2626" : "#16a34a";

    if (running) {
      startMasterProcess();
    } else {
      lblPhase.textContent = "متوقف مؤقتاً";
      chrome.runtime.sendMessage({ action: "PAUSE_BATCH_EXTRACTION" });
    }
  };

  btnClean.onclick = () => {
    tasksMap.clear();
    globalCounter = 0;
    renderUI();
  };

  btnCsv.onclick = exportCSV;

  // ===== استقبال إشعارات الطابور من Background =====
  chrome.runtime.onMessage.addListener((msg) => {
    if (!isExtensionValid()) return;

    if (msg.action === "SLOTS_UPDATED") {
      lblActiveSlots.textContent = `${msg.activeCount}/${maxConcurrent}`;
      if (msg.activeCount === 0 && msg.remaining === 0 && running) {
        lblPhase.textContent = "اكتملت جميع العمليات بنجاح!";
        lblPhase.style.color = "#22c55e";
        btnToggle.textContent = "بدء";
        btnToggle.style.background = "#16a34a";
        running = false;
      }
    }

    if (msg.action === "RECORD_SUCCESS") {
      const task = tasksMap.get(msg.orderId);
      if (task) {
        task.values = msg.deedNumbers || [];
        task.status = "done";
        renderUI();
      }
    }

    if (msg.action === "RECORD_FAILURE") {
      const task = tasksMap.get(msg.orderId);
      if (task) {
        task.values = [`⚠️ ${msg.reason}`];
        task.status = "failed";
        renderUI();
      }
    }
  });

  // ===== دوال التنقل بالصفحات (المرحلة 1) =====

  function getActivePageNumber() {
    const pag = document.querySelector(PAGINATION_CONTAINER);
    if (!pag) return null;
    const activeItem = pag.querySelector(ACTIVE_PAGE_SELECTOR);
    return activeItem ? parseInt(activeItem.innerText.trim(), 10) : null;
  }

  function isNextDisabled() {
    const pag = document.querySelector(PAGINATION_CONTAINER);
    if (!pag) return true;
    const nextLi = pag.querySelector(NEXT_PAGE_SELECTOR);
    return !nextLi || nextLi.classList.contains("rc-pagination-disabled") || nextLi.getAttribute("aria-disabled") === "true";
  }

  function getFirstDUInTable() {
    const firstRow = document.querySelector(`${TABLE_SELECTOR} tr`);
    return firstRow ? (firstRow.innerText.match(/\bDU\d+\b/)?.[0] || null) : null;
  }

  async function clickPageDirectly(page) {
    const pag = document.querySelector(PAGINATION_CONTAINER);
    if (!pag) return false;

    const items = [...pag.querySelectorAll("li.rc-pagination-item")];
    const targetLi = items.find(li => li.innerText.trim() === String(page));

    if (targetLi) {
      const clickEl = targetLi.querySelector("a, button") || targetLi;
      clickEl.click();
      return true;
    }

    const nextLi = pag.querySelector(NEXT_PAGE_SELECTOR);
    if (nextLi && !isNextDisabled()) {
      const clickEl = nextLi.querySelector("a, button") || nextLi;
      clickEl.click();
      return true;
    }
    return false;
  }

  async function navigateAndWait(targetPage, oldFirstDU, timeout = 12000) {
    const start = Date.now();
    await clickPageDirectly(targetPage);

    while (Date.now() - start < timeout) {
      if (!running) return false;
      const activeNum = getActivePageNumber();
      const currentFirstDU = getFirstDUInTable();

      if (activeNum === targetPage && currentFirstDU && currentFirstDU !== oldFirstDU) {
        await new Promise(r => setTimeout(r, 1200));
        return true;
      }
      await new Promise(r => setTimeout(r, 400));
    }
    return false;
  }

  async function scanOrdersOnCurrentPage(pageNumber) {
    let list = [];
    let attempts = 0;

    while (attempts < 6) {
      if (!running) return [];
      attempts++;

      const tbody = document.querySelector(TABLE_SELECTOR);
      if (tbody) {
        const rows = tbody.querySelectorAll("tr");
        list = [];

        rows.forEach(row => {
          const match = row.innerText.match(/\bDU\d+\b/);
          if (match) list.push(match[0]);
        });

        if (list.length >= 10 || (attempts >= 4 && list.length > 0)) break;
      }
      await new Promise(r => setTimeout(r, 500));
    }

    list.forEach(orderId => {
      if (!tasksMap.has(orderId)) {
        globalCounter++;
        tasksMap.set(orderId, {
          index: globalCounter,
          page: pageNumber,
          values: ["قيد الانتظار..."],
          status: "pending"
        });
      }
    });

    renderUI();
    return list;
  }

  // ===== إدارة المسار الكامل =====

  async function startMasterProcess() {
    maxConcurrent = parseInt(selectConcurrency.value, 10) || 1;
    const startVal = parseInt(inputStartPage.value, 10);
    const endVal = parseInt(inputEndPage.value, 10);

    let activeNum = getActivePageNumber() || 1;
    let targetPage = (!isNaN(startVal) && startVal >= 1) ? startVal : activeNum;

    // المرحلة 1: المسح السريع
    lblPhase.textContent = "المرحلة 1: تجميع أرقام الطلبات من الصفحات";
    lblPhase.style.color = "#f59e0b";

    if (activeNum !== targetPage) {
      lblPhase.textContent = `انتقال لصفحة البداية: ${targetPage}...`;
      const oldDU = getFirstDUInTable();
      await navigateAndWait(targetPage, oldDU);
    }

    while (running) {
      const currentPage = getActivePageNumber() || targetPage;
      lblPage.textContent = currentPage;

      if (!isNaN(endVal) && currentPage > endVal) break;

      lblPhase.textContent = `مسح طلبات صفحة ${currentPage}...`;
      await scanOrdersOnCurrentPage(currentPage);

      if (!isNaN(endVal) && currentPage >= endVal) break;
      if (isNextDisabled()) break;

      const nextPage = currentPage + 1;
      lblPhase.textContent = `الانتقال لصفحة ${nextPage}...`;
      const oldDU = getFirstDUInTable();
      const moved = await navigateAndWait(nextPage, oldDU);

      if (!moved) break;
      targetPage = nextPage;
    }

    if (!running) return;

    // المرحلة 2: إرسال القائمة لـ background لإدارتها بصرامة
    lblPhase.textContent = `المرحلة 2: بدء الاستخراج عبر التبويبات (${maxConcurrent} كحد أقصى)`;
    lblPhase.style.color = "#4ade80";

    const itemsToProcess = [];
    tasksMap.forEach((data, orderId) => {
      if (data.status === "pending") {
        itemsToProcess.push({
          orderId: orderId,
          url: `https://ops.rer.sa/deed-upgrade-case-view?caseId=${orderId}`
        });
      }
    });

    if (itemsToProcess.length === 0) {
      lblPhase.textContent = "لا توجد طلبات جديدة بحاجة للمعالجة.";
      running = false;
      btnToggle.textContent = "بدء";
      btnToggle.style.background = "#16a34a";
      return;
    }

    chrome.runtime.sendMessage({
      action: "START_BATCH_EXTRACTION",
      items: itemsToProcess,
      concurrency: maxConcurrent
    });
  }

  function renderUI() {
    const done = [...tasksMap.values()].filter(t => t.status === "done" || t.status === "failed").length;
    lblDoneCount.textContent = done;
    lblTotalCount.textContent = tasksMap.size;

    tableBody.innerHTML = [...tasksMap.entries()]
      .map(([orderId, data]) => `
        <tr>
          <td style="padding:5px; border-bottom:1px solid #1e293b; text-align:center; color:#94a3b8; font-weight:bold">${data.index}</td>
          <td style="padding:5px; border-bottom:1px solid #1e293b; text-align:center; color:#e2e8f0"><span style="background:#334155; padding:1px 6px; border-radius:3px">${data.page}</span></td>
          <td style="padding:5px; border-bottom:1px solid #1e293b; font-family:monospace; color:#38bdf8">${orderId}</td>
          <td style="padding:5px; border-bottom:1px solid #1e293b; color:#f1f5f9">
            ${data.values.map(v => `<span style="display:inline-block; background:${data.status === 'done' ? '#1e293b' : '#334155'}; padding:2px 8px; margin:2px; border-radius:4px; font-size:11px; border:1px solid ${data.status === 'done' ? '#334155' : '#475569'}">${v}</span>`).join('')}
          </td>
        </tr>
      `).join('');
  }

  function exportCSV() {
    if (tasksMap.size === 0) {
      alert("لا توجد بيانات متاحة للتصدير.");
      return;
    }

    const rows = [["#", "Page", "Case no", "Pcp"]];

    tasksMap.forEach((data, caseNo) => {
      const pcpCombined = data.values.join(" | ");
      const escapedPcp = `"${pcpCombined.replace(/"/g, '""')}"`;
      rows.push([data.index, data.page, caseNo, escapedPcp]);
    });

    const csvContent = "\uFEFF" + rows.map(r => r.join(",")).join("\n");
    const blob = new Blob([csvContent], { type: "text/csv;charset=utf-8;" });
    const url = URL.createObjectURL(blob);

    const a = document.createElement("a");
    a.href = url;
    a.download = `DU_Extract_${new Date().toISOString().slice(0, 10)}.csv`;
    a.click();
    URL.revokeObjectURL(url);
  }
})();

3. content_detail.js (زيادة مهلة الانتظار وحماية التبويب من التجمد)
استبدل محتوى content_detail.js بهذا الكود لضمان عدم حدوث Timeout عند بطء السيرفر:
(function () {
  'use strict';

  const LIST_SELECTOR = "#upgrade-deed-real-estate-number";

  function getOrderIdFromUrl() {
    const params = new URLSearchParams(window.location.search);
    return params.get("caseId") || params.get("requestId") || (document.body.innerText.match(/\bDU\d+\b/)?.[0] || null);
  }

  function waitForElement(selector, timeout = 20000) {
    return new Promise((resolve, reject) => {
      const el = document.querySelector(selector);
      if (el) return resolve(el);

      const observer = new MutationObserver(() => {
        const target = document.querySelector(selector);
        if (target) {
          observer.disconnect();
          resolve(target);
        }
      });

      observer.observe(document.body, { childList: true, subtree: true });

      setTimeout(() => {
        observer.disconnect();
        reject(new Error(`انتهت مهلة 20 ثانية بانتظار: ${selector}`));
      }, timeout);
    });
  }

  async function executeExtraction() {
    const orderId = getOrderIdFromUrl();

    try {
      // انتظار القائمة مع إعطاء مهلة كافية لسيرفر المنصة
      const listElement = await waitForElement(LIST_SELECTOR, 20000);
      listElement.classList.add("du-highlight-green");

      await new Promise(r => setTimeout(r, 400));

      const extractedValues = [];

      if (listElement.tagName.toLowerCase() === "select") {
        const options = [...listElement.options].filter(o => o.value && o.value.trim() !== "");
        options.forEach(opt => {
          const txt = opt.text.trim();
          if (txt && !extractedValues.includes(txt)) extractedValues.push(txt);
        });
      } else {
        const subItems = listElement.querySelectorAll("li, tr, div[role='option'], .option, span, p");
        if (subItems.length > 0) {
          subItems.forEach(item => {
            const val = item.innerText.trim();
            if (val && !extractedValues.includes(val)) {
              extractedValues.push(val);
              item.classList.add("du-highlight-green");
              const badge = document.createElement("span");
              badge.className = "du-badge-check";
              badge.textContent = "✓";
              item.prepend(badge);
            }
          });
        } else {
          const directVal = listElement.value || listElement.innerText.trim();
          if (directVal) {
            extractedValues.push(directVal);
            const badge = document.createElement("span");
            badge.className = "du-badge-check";
            badge.textContent = "✓";
            listElement.parentNode.insertBefore(badge, listElement.nextSibling);
          }
        }
      }

      if (extractedValues.length === 0) {
        throw new Error("العنصر فارغ ولا يحتوي على صكوك");
      }

      // إرسال النجاح
      chrome.runtime.sendMessage({
        action: "DATA_EXTRACTED_SUCCESS",
        orderId: orderId,
        deedNumbers: extractedValues
      });

    } catch (err) {
      console.warn("[DU Detail Extractor]:", err.message);
      // إرسال تقرير الفشل ليغلق background التبويب ويتابع ما بعده دون تعليق
      chrome.runtime.sendMessage({
        action: "EXTRACTION_FAILED",
        orderId: orderId,
        reason: err.message
      });
    }
  }

  if (document.readyState === "complete") {
    setTimeout(executeExtraction, 1000);
  } else {
    window.addEventListener("load", () => setTimeout(executeExtraction, 1000));
  }
})();

طريقة التشغيل الآن:
 * حدّث الملفات الثلاثة: background.js و content_search.js و content_detail.js.
 * ادخل إلى chrome://extensions/ واضغط Reload.
 * أعد تحميل صفحة [https://ops.rer.sa/deed-upgrade-dashboard](https://ops.rer.sa/deed-upgrade-dashboard) بـ (F5).
 * اختر من الواجهة: 1 تاب (أضمن خيار بدون أخطاء) واضغط بدء:
   * ستمر الإضافة على الصفحات بسرعة وتجمع الأرقام كأرقام صفحات دقيقة.
   * ستفتح تبويباً واحداً فقط في الخلفية، تنتظر استخراجه وحفظه، ثم تغلقه وتفتح الذي يليه بسلاسة تامة ودون أي تراكم أو رسائل انتهاء مهلة.
