افتح background.js وتأكد من استبدال الجزء الخاص بـ OPEN_ORDER_TAB و DATA_EXTRACTED_SUCCESS كالتالي:
  // 1. عند فتح التبويب، نحفظ معه رقم صفحته الأصلية
  if (message.action === "OPEN_ORDER_TAB") {
    if (activeTasks.size >= MAX_CONCURRENT) {
      sendResponse({ status: "BUSY" });
      return true;
    }

    chrome.tabs.create({ url: message.url, active: false }, (newTab) => {
      if (chrome.runtime.lastError || !newTab) {
        sendResponse({ status: "ERROR" });
        return;
      }

      activeTasks.set(newTab.id, {
        orderId: message.orderId,
        searchTabId: sender.tab ? sender.tab.id : null,
        pageAssigned: message.pageAssigned, // حفظ رقم الصفحة بدقة
        url: message.url
      });

      sendResponse({ status: "STARTED", tabId: newTab.id });
    });
    return true;
  }

  // 2. عند اكتمال الاستخراج، نُعيد رقم الصفحة الأصلي إلى لوحة التحكم
  if (message.action === "DATA_EXTRACTED_SUCCESS") {
    const senderTabId = sender.tab ? sender.tab.id : null;
    const task = activeTasks.get(senderTabId);

    if (task && task.searchTabId) {
      chrome.tabs.sendMessage(task.searchTabId, {
        action: "SAVE_AND_VERIFY",
        orderId: message.orderId || task.orderId,
        pageAssigned: task.pageAssigned, // تثبيت رقم الصفحة
        deedNumbers: message.deedNumbers,
        tabId: senderTabId
      });
    }
  }

