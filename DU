(function () {
  'use strict';

  const LIST_SELECTOR = "#upgrade-deed-real-estate-number";
  const MAX_CLICKS = 6;
  const CLICK_INTERVAL = 25; // نقرات سريعة جداً بفارق 25 ملي ثانية

  function delay(ms) {
    return new Promise(resolve => setTimeout(resolve, ms));
  }

  function getOrderIdFromUrl() {
    const params = new URLSearchParams(window.location.search);
    return params.get("caseId") || params.get("requestId") || (document.body.innerText.match(/\bDU\d+\b/)?.[0] || null);
  }

  // ==========================================
  // النقر السريع على السهم والوصول الفوري
  // ==========================================
  async function fastNavigateToReview() {
    let clicked = 0;
    let retries = 0;
    const maxRetries = 25; // انتظار ظهور أول سهم بحد أقصى ~5 ثوانٍ

    while (clicked < MAX_CLICKS && retries < maxRetries) {
      // إذا كانت القائمة قد ظهرت بالفعل، نتوقف عن النقر فوراً
      if (document.querySelector(LIST_SELECTOR)) {
        break;
      }

      const img = document.querySelector('button img[src$="left.svg"]');
      if (!img) {
        retries++;
        await delay(200);
        continue;
      }

      const btn = img.closest("button");
      if (!btn) {
        retries++;
        await delay(200);
        continue;
      }

      // نقرة برمجية فورية
      btn.click();
      clicked++;

      await delay(CLICK_INTERVAL);
    }
  }

  // ==========================================
  // انتظار القائمة مع مراقبة سريعة
  // ==========================================
  function waitForList(timeout = 12000) {
    return new Promise((resolve, reject) => {
      const el = document.querySelector(LIST_SELECTOR);
      if (el) return resolve(el);

      const observer = new MutationObserver(() => {
        const target = document.querySelector(LIST_SELECTOR);
        if (target) {
          observer.disconnect();
          resolve(target);
        }
      });

      observer.observe(document.body, { childList: true, subtree: true });

      setTimeout(() => {
        observer.disconnect();
        reject(new Error(`تعذر العثور على القائمة: ${LIST_SELECTOR}`));
      }, timeout);
    });
  }

  // ==========================================
  // استخراج القيم وإرسال النتيجة
  // ==========================================
  async function executeFastExtraction() {
    const orderId = getOrderIdFromUrl();

    try {
      // 1. النقر السريع المتتابع بدون أي تأخير تمرير
      await fastNavigateToReview();

      // 2. التقاط القائمة
      const listElement = await waitForList(12000);
      listElement.classList.add("du-highlight-green");

      const extractedValues = [];

      if (listElement.tagName.toLowerCase() === "select") {
        const options = [...listElement.options].filter(o => o.value && o.value.trim() !== "");
        options.forEach(opt => {
          const txt = opt.text.trim();
          if (txt && !extractedValues.includes(txt)) extractedValues.push(txt);
        });
      } else {
        const subItems = listElement.querySelectorAll("li, tr, div[role='option'], .option, span, p");
        if (subItems.length > 0) {
          subItems.forEach(item => {
            const val = item.innerText.trim();
            if (val && !extractedValues.includes(val)) {
              extractedValues.push(val);
              item.classList.add("du-highlight-green");
              const badge = document.createElement("span");
              badge.className = "du-badge-check";
              badge.textContent = "✓";
              item.prepend(badge);
            }
          });
        } else {
          const directVal = listElement.value || listElement.innerText.trim();
          if (directVal) {
            extractedValues.push(directVal);
            const badge = document.createElement("span");
            badge.className = "du-badge-check";
            badge.textContent = "✓";
            listElement.parentNode.insertBefore(badge, listElement.nextSibling);
          }
        }
      }

      if (extractedValues.length === 0) {
        throw new Error("القائمة لا تحتوي على صكوك/عقارات");
      }

      // 3. إرسال النجاح فوراً لإغلاق التبويب
      chrome.runtime.sendMessage({
        action: "DATA_EXTRACTED_SUCCESS",
        orderId: orderId,
        deedNumbers: extractedValues
      });

    } catch (err) {
      chrome.runtime.sendMessage({
        action: "EXTRACTION_FAILED",
        orderId: orderId,
        reason: err.message
      });
    }
  }

  if (document.readyState === "complete") {
    setTimeout(executeFastExtraction, 150);
  } else {
    window.addEventListener("load", () => setTimeout(executeFastExtraction, 150));
  }
})();
