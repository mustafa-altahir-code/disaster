// ===================================================
// DU Crawler - Strict Single-Tab Lock Engine
// ===================================================

let activeTabId = null;
let watchdogTimer = null;
let currentResolve = null;

// دالة تضمن إغلاق التبويب الحالي وتحرير القفل حتماً
function cleanupCurrentTab() {
  if (watchdogTimer) {
    clearTimeout(watchdogTimer);
    watchdogTimer = null;
  }

  const tabToClose = activeTabId;
  activeTabId = null;

  if (tabToClose) {
    chrome.tabs.remove(tabToClose, () => {
      // تفادي أخطاء محاولة إغلاق تبويب مغلق مسبقاً
      if (chrome.runtime.lastError) { /* ignore */ }
    });
  }
}

chrome.runtime.onMessage.addListener((message, sender, sendResponse) => {

  // 1. فتح تبويب واحد فقط وانتظار إغلاقه التام قبل الرد
  if (message.action === "PROCESS_SINGLE_ORDER") {
    // إذا كان هناك تبويب ما زال مفتوحاً، نمنع فتح أي تبويب جديد
    if (activeTabId !== null) {
      sendResponse({ status: "BUSY" });
      return true;
    }

    const { orderId, url } = message;

    chrome.tabs.create({ url: url, active: false }, (newTab) => {
      if (chrome.runtime.lastError || !newTab) {
        sendResponse({ status: "ERROR", reason: "تعذر إنشاء التبويب" });
        return;
      }

      activeTabId = newTab.id;

      // حفظ الـ Resolver للرد على لوحة البحث بمجرد انتهاء التبويب وإغلاقه
      currentResolve = (result) => {
        cleanupCurrentTab();
        sendResponse(result);
      };

      // مؤقت أمان قسري: 25 ثانية كحد أقصى لإغلاق التبويب ومتابعة العمل مهما حصل
      watchdogTimer = setTimeout(() => {
        if (currentResolve) {
          const resolve = currentResolve;
          currentResolve = null;
          resolve({ status: "TIMEOUT", reason: "انتهت مهلة استجابة الصفحة (25 ثانية)" });
        }
      }, 25000);
    });

    return true; // إبقاء القناة مفتوحة حتى انتهاء العملية وإغلاق التبويب
  }

  // 2. وصول البيانات بنجاح من صفحة التفاصيل
  if (message.action === "DATA_EXTRACTED_SUCCESS") {
    if (sender.tab && sender.tab.id === activeTabId) {
      if (currentResolve) {
        const resolve = currentResolve;
        currentResolve = null;
        resolve({
          status: "SUCCESS",
          orderId: message.orderId,
          deedNumbers: message.deedNumbers || []
        });
      }
    }
  }

  // 3. وصول إشعار فشل الاستخراج من صفحة التفاصيل
  if (message.action === "EXTRACTION_FAILED") {
    if (sender.tab && sender.tab.id === activeTabId) {
      if (currentResolve) {
        const resolve = currentResolve;
        currentResolve = null;
        resolve({
          status: "FAILED",
          orderId: message.orderId,
          reason: message.reason || "فشل الاستخراج داخل الصفحة"
        });
      }
    }
  }

  // 4. إيقاف الطوارئ من المستخدم
  if (message.action === "FORCE_STOP") {
    cleanupCurrentTab();
    if (currentResolve) {
      const resolve = currentResolve;
      currentResolve = null;
      resolve({ status: "STOPPED" });
    }
    sendResponse({ status: "STOPPED" });
    return true;
  }
});

// مراقبة إغلاق التبويب يدوياً من قِبل المستخدم
chrome.tabs.onRemoved.addListener((closedTabId) => {
  if (closedTabId === activeTabId) {
    if (currentResolve) {
      const resolve = currentResolve;
      currentResolve = null;
      cleanupCurrentTab();
      resolve({ status: "MANUAL_CLOSE", reason: "تم إغلاق التبويب يدوياً" });
    } else {
      cleanupCurrentTab();
    }
  }
});






(function () {
  'use strict';

  function isExtensionValid() {
    return typeof chrome !== "undefined" && chrome.runtime && !!chrome.runtime.id;
  }

  const TABLE_SELECTOR = "#__next > div > div.w-full.p-8.transition-all.duration-700 > div > div:nth-child(2) > div > div.mt-9.my-5 > div > div.overflow-x-auto.w-full > table > tbody";
  const PAGINATION_CONTAINER = "ul.rc-pagination";
  const ACTIVE_PAGE_SELECTOR = "li.rc-pagination-item-active";
  const NEXT_PAGE_SELECTOR = "li.rc-pagination-next";

  // orderId -> { index, page, values, status }
  const tasksMap = new Map();

  let running = false;
  let globalCounter = 0;

  // ===== بناء الواجهة التفاعلية (HUD) =====
  const panel = document.createElement('div');
  panel.id = "du-crawler-hud";
  panel.style.cssText = `
    position: fixed;
    bottom: 20px;
    right: 20px;
    width: 700px;
    height: 590px;
    background: #0f172a;
    color: #38bdf8;
    z-index: 999999;
    font-family: system-ui, -apple-system, sans-serif;
    border: 1px solid #334155;
    box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.7);
    border-radius: 8px;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    direction: rtl;
  `;

  panel.innerHTML = `
    <!-- الرأس والأزرار -->
    <div style="padding: 10px 14px; display:flex; justify-content:space-between; align-items:center; background:#1e293b; border-bottom:1px solid #334155">
      <b style="color:#f8fafc; font-size:14px">DU Crawler (نظام التبويب الواحد الصارم)</b>
      <div style="display:flex; gap:6px">
        <button id="du-btn-toggle" style="background:#16a34a;color:#fff;border:none;padding:5px 14px;border-radius:4px;cursor:pointer;font-weight:600">بدء</button>
        <button id="du-btn-clean" style="background:#334155;color:#e2e8f0;border:none;padding:5px 12px;border-radius:4px;cursor:pointer">تفريغ</button>
        <button id="du-btn-csv" style="background:#0284c7;color:#fff;border:none;padding:5px 14px;border-radius:4px;cursor:pointer;font-weight:600">تصدير CSV</button>
      </div>
    </div>

    <!-- شريط النطاق -->
    <div style="padding: 6px 14px; background:#1e293b; border-bottom:1px solid #334155; font-size:12px; display:flex; align-items:center; justify-content:space-between; color:#94a3b8">
      <div style="display:flex; align-items:center; gap:8px">
        <span>نطاق الصفحات:</span>
        <label style="display:flex; align-items:center; gap:3px">من:
          <input type="number" id="du-page-start" min="1" placeholder="الحالية" style="width:55px; background:#0f172a; border:1px solid #475569; color:#f8fafc; padding:2px; border-radius:3px; text-align:center" />
        </label>
        <label style="display:flex; align-items:center; gap:3px">إلى:
          <input type="number" id="du-page-end" min="1" placeholder="الكل" style="width:55px; background:#0f172a; border:1px solid #475569; color:#f8fafc; padding:2px; border-radius:3px; text-align:center" />
        </label>
      </div>
      <span style="color:#38bdf8; font-weight:500">آلية العمل: تبويب واحد فقط بالخلفية 🔒</span>
    </div>

    <!-- الإحصائيات المباشرة -->
    <div style="padding: 6px 14px; background:#0f172a; border-bottom:1px solid #334155; font-size:12px; display:flex; justify-content:space-between; color:#94a3b8">
      <span>المرحلة: <b id="du-phase-text" style="color:#f59e0b">جاهز</b></span>
      <span>الصفحة: <b id="du-page-num" style="color:#f8fafc">-</b></span>
      <span>المكتمل: <b id="du-done-count" style="color:#4ade80">0</b> / <b id="du-total-count" style="color:#38bdf8">0</b></span>
      <span>التبويب النشط: <b id="du-active-status" style="color:#94a3b8">لا يوجد</b></span>
    </div>

    <!-- جدول عرض النتائج -->
    <div style="flex:1; overflow-y:auto; padding:6px;">
      <table style="width:100%; border-collapse:collapse; font-size:12px; text-align:right">
        <thead>
          <tr style="background:#1e293b; color:#94a3b8">
            <th style="padding:6px; border-bottom:1px solid #334155; width:8%; text-align:center">#</th>
            <th style="padding:6px; border-bottom:1px solid #334155; width:10%; text-align:center">الصفحة</th>
            <th style="padding:6px; border-bottom:1px solid #334155; width:26%">Case no (DU)</th>
            <th style="padding:6px; border-bottom:1px solid #334155; width:56%">Pcp (القيم المستخرجة)</th>
          </tr>
        </thead>
        <tbody id="du-table-body"></tbody>
      </table>
    </div>
  `;

  document.body.appendChild(panel);

  const btnToggle = panel.querySelector("#du-btn-toggle");
  const btnClean = panel.querySelector("#du-btn-clean");
  const btnCsv = panel.querySelector("#du-btn-csv");
  const inputStartPage = panel.querySelector("#du-page-start");
  const inputEndPage = panel.querySelector("#du-page-end");
  const tableBody = panel.querySelector("#du-table-body");

  const lblPhase = panel.querySelector("#du-phase-text");
  const lblPage = panel.querySelector("#du-page-num");
  const lblDoneCount = panel.querySelector("#du-done-count");
  const lblTotalCount = panel.querySelector("#du-total-count");
  const lblActiveStatus = panel.querySelector("#du-active-status");

  btnToggle.onclick = () => {
    running = !running;
    btnToggle.textContent = running ? "إيقاف مؤقت" : "بدء";
    btnToggle.style.background = running ? "#dc2626" : "#16a34a";

    if (running) {
      startMasterProcess();
    } else {
      lblPhase.textContent = "متوقف مؤقتاً";
      chrome.runtime.sendMessage({ action: "FORCE_STOP" });
    }
  };

  btnClean.onclick = () => {
    tasksMap.clear();
    globalCounter = 0;
    renderUI();
  };

  btnCsv.onclick = exportCSV;

  // ===== إرسال الطلب وانتظار إغلاق التبويب حتماً =====
  function processOrderSynchronously(orderId, url) {
    return new Promise((resolve) => {
      if (!isExtensionValid() || !running) {
        return resolve({ status: "STOPPED" });
      }

      chrome.runtime.sendMessage({
        action: "PROCESS_SINGLE_ORDER",
        orderId: orderId,
        url: url
      }, (response) => {
        if (chrome.runtime.lastError) {
          resolve({ status: "ERROR", reason: chrome.runtime.lastError.message });
        } else {
          resolve(response || { status: "EMPTY" });
        }
      });
    });
  }

  // ===== دوال مسح الصفحات (المرحلة 1) =====

  function getActivePageNumber() {
    const pag = document.querySelector(PAGINATION_CONTAINER);
    if (!pag) return null;
    const activeItem = pag.querySelector(ACTIVE_PAGE_SELECTOR);
    return activeItem ? parseInt(activeItem.innerText.trim(), 10) : null;
  }

  function isNextDisabled() {
    const pag = document.querySelector(PAGINATION_CONTAINER);
    if (!pag) return true;
    const nextLi = pag.querySelector(NEXT_PAGE_SELECTOR);
    return !nextLi || nextLi.classList.contains("rc-pagination-disabled") || nextLi.getAttribute("aria-disabled") === "true";
  }

  function getFirstDUInTable() {
    const firstRow = document.querySelector(`${TABLE_SELECTOR} tr`);
    return firstRow ? (firstRow.innerText.match(/\bDU\d+\b/)?.[0] || null) : null;
  }

  async function clickPageDirectly(page) {
    const pag = document.querySelector(PAGINATION_CONTAINER);
    if (!pag) return false;

    const items = [...pag.querySelectorAll("li.rc-pagination-item")];
    const targetLi = items.find(li => li.innerText.trim() === String(page));

    if (targetLi) {
      const clickEl = targetLi.querySelector("a, button") || targetLi;
      clickEl.click();
      return true;
    }

    const nextLi = pag.querySelector(NEXT_PAGE_SELECTOR);
    if (nextLi && !isNextDisabled()) {
      const clickEl = nextLi.querySelector("a, button") || nextLi;
      clickEl.click();
      return true;
    }
    return false;
  }

  async function navigateAndWait(targetPage, oldFirstDU, timeout = 12000) {
    const start = Date.now();
    await clickPageDirectly(targetPage);

    while (Date.now() - start < timeout) {
      if (!running) return false;
      const activeNum = getActivePageNumber();
      const currentFirstDU = getFirstDUInTable();

      if (activeNum === targetPage && currentFirstDU && currentFirstDU !== oldFirstDU) {
        await new Promise(r => setTimeout(r, 1200));
        return true;
      }
      await new Promise(r => setTimeout(r, 400));
    }
    return false;
  }

  async function scanOrdersOnCurrentPage(pageNumber) {
    let list = [];
    let attempts = 0;

    while (attempts < 6) {
      if (!running) return [];
      attempts++;

      const tbody = document.querySelector(TABLE_SELECTOR);
      if (tbody) {
        const rows = tbody.querySelectorAll("tr");
        list = [];

        rows.forEach(row => {
          const match = row.innerText.match(/\bDU\d+\b/);
          if (match) list.push(match[0]);
        });

        if (list.length >= 10 || (attempts >= 4 && list.length > 0)) break;
      }
      await new Promise(r => setTimeout(r, 500));
    }

    list.forEach(orderId => {
      if (!tasksMap.has(orderId)) {
        globalCounter++;
        tasksMap.set(orderId, {
          index: globalCounter,
          page: pageNumber,
          values: ["قيد الانتظار..."],
          status: "pending"
        });
      }
    });

    renderUI();
    return list;
  }

  // ===== إدارة التدفق الرئيسي (مسح ثم معالجة تسلسلية 1 بـ 1) =====

  async function startMasterProcess() {
    const startVal = parseInt(inputStartPage.value, 10);
    const endVal = parseInt(inputEndPage.value, 10);

    let activeNum = getActivePageNumber() || 1;
    let targetPage = (!isNaN(startVal) && startVal >= 1) ? startVal : activeNum;

    // ----------------------------------------------------
    // المرحلة 1: المسح السريع وجمع كل الطلبات من الصفحات
    // ----------------------------------------------------
    lblPhase.textContent = "المرحلة 1: مسح الصفحات وتجميع الطلبات";
    lblPhase.style.color = "#f59e0b";

    if (activeNum !== targetPage) {
      lblPhase.textContent = `انتقال لصفحة البداية: ${targetPage}...`;
      const oldDU = getFirstDUInTable();
      await navigateAndWait(targetPage, oldDU);
    }

    while (running) {
      const currentPage = getActivePageNumber() || targetPage;
      lblPage.textContent = currentPage;

      if (!isNaN(endVal) && currentPage > endVal) break;

      lblPhase.textContent = `مسح طلبات صفحة ${currentPage}...`;
      await scanOrdersOnCurrentPage(currentPage);

      if (!isNaN(endVal) && currentPage >= endVal) break;
      if (isNextDisabled()) break;

      const nextPage = currentPage + 1;
      lblPhase.textContent = `الانتقال لصفحة ${nextPage}...`;
      const oldDU = getFirstDUInTable();
      const moved = await navigateAndWait(nextPage, oldDU);

      if (!moved) break;
      targetPage = nextPage;
    }

    if (!running) return;

    // ----------------------------------------------------
    // المرحلة 2: فتح كل طلب واستخراج الصكوك تسلسلياً (1 تلو الآخر)
    // ----------------------------------------------------
    lblPhase.textContent = "المرحلة 2: استخراج الصكوك (تبويب واحد مغلق)";
    lblPhase.style.color = "#4ade80";

    const ordersToProcess = [...tasksMap.entries()].filter(([_, data]) => data.status === "pending");

    for (const [orderId, data] of ordersToProcess) {
      if (!running) break;

      lblActiveStatus.textContent = `مفتوح الآن: ${orderId}`;
      lblActiveStatus.style.color = "#fbbf24";

      const targetUrl = `https://ops.rer.sa/deed-upgrade-case-view?caseId=${orderId}`;

      // انتظار حتمي حتى يعود الـ background بعد إغلاق التبويب تماماً
      const result = await processOrderSynchronously(orderId, targetUrl);

      if (result.status === "SUCCESS") {
        data.values = result.deedNumbers || [];
        data.status = "done";
      } else {
        data.values = [`⚠️ ${result.reason || "فشل"}`];
        data.status = "failed";
      }

      renderUI();
      lblActiveStatus.textContent = "مُغلق (جاهز للتالي)";
      lblActiveStatus.style.color = "#4ade80";

      // مهلة استقرار قصيرة (500ms) بين إغلاق التبويب وفتح الذي يليه
      await new Promise(r => setTimeout(r, 500));
    }

    if (running) {
      lblPhase.textContent = "اكتملت جميع العمليات بنجاح 100%!";
      lblPhase.style.color = "#22c55e";
      lblActiveStatus.textContent = "انتهى";
      btnToggle.textContent = "بدء";
      btnToggle.style.background = "#16a34a";
      running = false;
    }
  }

  function renderUI() {
    const done = [...tasksMap.values()].filter(t => t.status === "done" || t.status === "failed").length;
    lblDoneCount.textContent = done;
    lblTotalCount.textContent = tasksMap.size;

    tableBody.innerHTML = [...tasksMap.entries()]
      .map(([orderId, data]) => `
        <tr>
          <td style="padding:5px; border-bottom:1px solid #1e293b; text-align:center; color:#94a3b8; font-weight:bold">${data.index}</td>
          <td style="padding:5px; border-bottom:1px solid #1e293b; text-align:center; color:#e2e8f0"><span style="background:#334155; padding:1px 6px; border-radius:3px">${data.page}</span></td>
          <td style="padding:5px; border-bottom:1px solid #1e293b; font-family:monospace; color:#38bdf8">${orderId}</td>
          <td style="padding:5px; border-bottom:1px solid #1e293b; color:#f1f5f9">
            ${data.values.map(v => `<span style="display:inline-block; background:${data.status === 'done' ? '#1e293b' : '#334155'}; padding:2px 8px; margin:2px; border-radius:4px; font-size:11px; border:1px solid ${data.status === 'done' ? '#334155' : '#475569'}">${v}</span>`).join('')}
          </td>
        </tr>
      `).join('');
  }

  function exportCSV() {
    if (tasksMap.size === 0) {
      alert("لا توجد بيانات متاحة للتصدير.");
      return;
    }

    const rows = [["#", "Page", "Case no", "Pcp"]];

    tasksMap.forEach((data, caseNo) => {
      const pcpCombined = data.values.join(" | ");
      const escapedPcp = `"${pcpCombined.replace(/"/g, '""')}"`;
      rows.push([data.index, data.page, caseNo, escapedPcp]);
    });

    const csvContent = "\uFEFF" + rows.map(r => r.join(",")).join("\n");
    const blob = new Blob([csvContent], { type: "text/csv;charset=utf-8;" });
    const url = URL.createObjectURL(blob);

    const a = document.createElement("a");
    a.href = url;
    a.download = `DU_Extract_${new Date().toISOString().slice(0, 10)}.csv`;
    a.click();
    URL.revokeObjectURL(url);
  }
})();




(function () {
  'use strict';

  const LIST_SELECTOR = "#upgrade-deed-real-estate-number";

  function getOrderIdFromUrl() {
    const params = new URLSearchParams(window.location.search);
    return params.get("caseId") || params.get("requestId") || (document.body.innerText.match(/\bDU\d+\b/)?.[0] || null);
  }

  function waitForElement(selector, timeout = 15000) {
    return new Promise((resolve, reject) => {
      const el = document.querySelector(selector);
      if (el) return resolve(el);

      const observer = new MutationObserver(() => {
        const target = document.querySelector(selector);
        if (target) {
          observer.disconnect();
          resolve(target);
        }
      });

      observer.observe(document.body, { childList: true, subtree: true });

      setTimeout(() => {
        observer.disconnect();
        reject(new Error(`تعذر العثور على القائمة: ${selector}`));
      }, timeout);
    });
  }

  async function executeExtraction() {
    const orderId = getOrderIdFromUrl();

    try {
      const listElement = await waitForElement(LIST_SELECTOR, 15000);
      listElement.classList.add("du-highlight-green");

      await new Promise(r => setTimeout(r, 300));

      const extractedValues = [];

      if (listElement.tagName.toLowerCase() === "select") {
        const options = [...listElement.options].filter(o => o.value && o.value.trim() !== "");
        options.forEach(opt => {
          const txt = opt.text.trim();
          if (txt && !extractedValues.includes(txt)) extractedValues.push(txt);
        });
      } else {
        const subItems = listElement.querySelectorAll("li, tr, div[role='option'], .option, span, p");
        if (subItems.length > 0) {
          subItems.forEach(item => {
            const val = item.innerText.trim();
            if (val && !extractedValues.includes(val)) {
              extractedValues.push(val);
              item.classList.add("du-highlight-green");
              const badge = document.createElement("span");
              badge.className = "du-badge-check";
              badge.textContent = "✓";
              item.prepend(badge);
            }
          });
        } else {
          const directVal = listElement.value || listElement.innerText.trim();
          if (directVal) {
            extractedValues.push(directVal);
            const badge = document.createElement("span");
            badge.className = "du-badge-check";
            badge.textContent = "✓";
            listElement.parentNode.insertBefore(badge, listElement.nextSibling);
          }
        }
      }

      if (extractedValues.length === 0) {
        throw new Error("القائمة لا تحتوي على صكوك");
      }

      // إرسال النجاح
      chrome.runtime.sendMessage({
        action: "DATA_EXTRACTED_SUCCESS",
        orderId: orderId,
        deedNumbers: extractedValues
      });

    } catch (err) {
      // إرسال الفشل ليغلق background التبويب فوراً
      chrome.runtime.sendMessage({
        action: "EXTRACTION_FAILED",
        orderId: orderId,
        reason: err.message
      });
    }
  }

  if (document.readyState === "complete") {
    setTimeout(executeExtraction, 800);
  } else {
    window.addEventListener("load", () => setTimeout(executeExtraction, 800));
  }
})();
