@echo off
setlocal EnableExtensions EnableDelayedExpansion
title File and Folder Search and Delete

set "ROOT=\\10.150.40.49\las"
set "OUT=%ROOT%\GRS_Search_Results.txt"
set /a COUNT=0

echo.
echo ==========================================
echo       File and Folder Search and Delete
echo ==========================================
echo.
echo Select search depth:
echo 0  - Root folder only
echo 1  - One subfolder level
echo 2  - Two subfolder levels
echo 3  - Three subfolder levels
echo 99 - All levels
echo.

set /p "DEPTH=Enter search depth: "

if not defined DEPTH goto INVALID_DEPTH
for /f "delims=0123456789" %%A in ("%DEPTH%") do goto INVALID_DEPTH
if %DEPTH% GTR 99 goto INVALID_DEPTH

echo.
echo Select search type:
echo.
echo 1 - Files only
echo 2 - Folders only
echo 3 - Both files and folders
echo.

choice /c 123 /m "Select search type"

if errorlevel 3 (
    set "MODE=3"
) else if errorlevel 2 (
    set "MODE=2"
) else (
    set "MODE=1"
)

if "%MODE%"=="2" goto ASK_FOLDER

echo.
echo Enter file name pattern.
echo Examples: GRS*  or  *hasabalrasoul*
set /p "FNAME=File name pattern [GRS*]: "
if not defined FNAME set "FNAME=GRS*"

echo.
echo Enter file extension.
echo Examples: .exe, .dll, .txt, * for all
set /p "EXT=File extension [.exe]: "
if not defined EXT set "EXT=.exe"

if not "%EXT%"=="*" if not "%EXT:~0,1%"=="." set "EXT=.%EXT%"

if "%EXT%"=="*" (
    set "FPATTERN=%FNAME%"
) else (
    set "FPATTERN=%FNAME%%EXT%"
)

if "%MODE%"=="3" goto ASK_FOLDER

set "DNAME=NO_FOLDER_MATCH"
goto START_SEARCH


:ASK_FOLDER
echo.
echo Enter folder name pattern.
echo Examples: GRS*  or  *hasabalrasoul*
set /p "DNAME=Folder name pattern [GRS*]: "
if not defined DNAME set "DNAME=GRS*"

if "%MODE%"=="2" set "FPATTERN=NO_FILE_MATCH"


:START_SEARCH
echo.
echo Root folder:
echo %ROOT%
echo.

pushd "%ROOT%" 2>nul
if errorlevel 1 (
    echo ERROR: Cannot access shared folder.
    pause
    exit /b 1
)

set "ROOT=%CD%"
set "LIST=%TEMP%\GRS_List_%RANDOM%.txt"
set "SELECT=%TEMP%\GRS_Select_%RANDOM%.txt"

type nul > "%LIST%"

> "%OUT%" echo SEARCH RESULTS
>> "%OUT%" echo Root: %ROOT%
>> "%OUT%" echo Search depth: %DEPTH%
>> "%OUT%" echo Search mode: %MODE%
>> "%OUT%" echo File pattern: %FPATTERN%
>> "%OUT%" echo Folder pattern: %DNAME%
>> "%OUT%" echo.

echo Searching...
echo.

call :SCAN "%ROOT%" 0

>> "%OUT%" echo.
>> "%OUT%" echo TOTAL ITEMS FOUND: !COUNT!

echo.
echo ==========================================
echo Total items found: !COUNT!
echo Results saved to:
echo %OUT%
echo ==========================================

if !COUNT! EQU 0 (
    echo.
    echo No matching items found.
    goto END
)

echo.
choice /c YN /m "Do you want to delete selected items"
if errorlevel 2 goto END


:ASK_RANGES
echo.
echo Enter ranges separated by commas.
echo Examples: 1-3,7-12,18,25-27
echo Type ALL to select all items.
echo.

set "RANGES="
set /p "RANGES=Items to delete: "

if not defined RANGES goto INVALID_RANGES

if /i "!RANGES!"=="ALL" set "RANGES=1-!COUNT!"

set "BAD="
set "RANGES=%RANGES:,= %"
type nul > "%SELECT%"

for %%R in (!RANGES!) do (
    set "TOKEN=%%R"
    set "FIRST="
    set "LAST="
    set "EXTRA="

    for /f "tokens=1-3 delims=-" %%A in ("!TOKEN!") do (
        set "FIRST=%%A"
        set "LAST=%%B"
        set "EXTRA=%%C"
    )

    if not defined FIRST set "BAD=1"
    if defined EXTRA set "BAD=1"
    if not defined LAST set "LAST=!FIRST!"

    for /f "delims=0123456789" %%A in ("!FIRST!!LAST!") do set "BAD=1"

    if not defined BAD (
        set /a FIRSTNUM=FIRST
        set /a LASTNUM=LAST

        if !FIRSTNUM! LSS 1 set "BAD=1"
        if !LASTNUM! LSS !FIRSTNUM! set "BAD=1"
        if !LASTNUM! GTR !COUNT! set "BAD=1"
    )

    if not defined BAD (
        set /a N=0
        for /f "usebackq tokens=1-3 delims=|" %%A in ("%LIST%") do (
            set /a N+=1
            if !N! GEQ !FIRSTNUM! if !N! LEQ !LASTNUM! (
                >> "%SELECT%" echo %%A^|%%B^|%%C
            )
        )
    )
)

if defined BAD goto INVALID_RANGES
for %%Z in ("%SELECT%") do if %%~zZ EQU 0 goto INVALID_RANGES

echo.
echo ===== ITEMS SELECTED FOR DELETION =====

for /f "usebackq tokens=1-3 delims=|" %%A in ("%SELECT%") do (
    echo %%A - %%C
)

echo =======================================
echo.
echo WARNING:
echo Files will be permanently deleted.
echo Selected folders and all their contents
echo will also be permanently deleted.
echo.

choice /c YN /m "Confirm deletion"
if errorlevel 2 goto END

echo.
echo Starting deletion...
echo.

for /f "usebackq tokens=1-3 delims=|" %%A in ("%SELECT%") do (
    if /i "%%A"=="FILE" (
        if exist "%%C" (
            del /f /q "%%C" 2>nul
            if not exist "%%C" (
                echo DELETED FILE: %%C
            ) else (
                echo FAILED FILE: %%C
            )
        ) else (
            echo NOT FOUND: %%C
        )
    ) else (
        if exist "%%C\." (
            rmdir /s /q "%%C" 2>nul
            if not exist "%%C\." (
                echo DELETED FOLDER: %%C
            ) else (
                echo FAILED FOLDER: %%C
            )
        ) else (
            echo NOT FOUND: %%C
        )
    )
)

echo.
echo Deletion process completed.
goto END


:SCAN
set "CURRENT=%~1"
set /a LEVEL=%~2

if "%MODE%"=="1" goto SCAN_FILES
if "%MODE%"=="2" goto SCAN_FOLDERS
goto SCAN_BOTH


:SCAN_FILES
for %%F in ("%CURRENT%\%FPATTERN%") do (
    if exist "%%~fF" if not exist "%%~fF\." (
        set /a COUNT+=1
        echo !COUNT! - FILE - %%~fF
        >> "%LIST%" echo FILE^|0^|%%~fF
        >> "%OUT%" echo !COUNT! - FILE - %%~fF
    )
)
goto RECURSE


:SCAN_FOLDERS
for /d %%D in ("%CURRENT%\%DNAME%") do (
    if exist "%%~fD\." (
        set /a COUNT+=1
        echo !COUNT! - FOLDER - %%~fD
        >> "%LIST%" echo FOLDER^|0^|%%~fD
        >> "%OUT%" echo !COUNT! - FOLDER - %%~fD
    )
)
goto RECURSE


:SCAN_BOTH
for %%F in ("%CURRENT%\%FPATTERN%") do (
    if exist "%%~fF" if not exist "%%~fF\." (
        set /a COUNT+=1
        echo !COUNT! - FILE - %%~fF
        >> "%LIST%" echo FILE^|0^|%%~fF
        >> "%OUT%" echo !COUNT! - FILE - %%~fF
    )
)

for /d %%D in ("%CURRENT%\%DNAME%") do (
    if exist "%%~fD\." (
        set /a COUNT+=1
        echo !COUNT! - FOLDER - %%~fD
        >> "%LIST%" echo FOLDER^|0^|%%~fD
        >> "%OUT%" echo !COUNT! - FOLDER - %%~fD
    )
)
goto RECURSE


:RECURSE
if "%DEPTH%"=="99" goto RECURSE_ALL
if !LEVEL! GEQ %DEPTH% exit /b

set /a NEXTLEVEL=LEVEL+1

for /d %%D in ("%CURRENT%\*") do (
    if exist "%%~fD\." call :SCAN "%%~fD" !NEXTLEVEL!
)
exit /b


:RECURSE_ALL
for /d %%D in ("%CURRENT%\*") do (
    if exist "%%~fD\." call :SCAN "%%~fD" 99
)
exit /b


:INVALID_DEPTH
echo.
echo Invalid depth. Enter a number from 0 to 99.
pause
exit /b 1


:INVALID_RANGES
echo.
echo Invalid selection. No items were deleted.
echo Use numbers or ranges, separated by commas.
echo Example: 1-3,7-12,18
echo.
choice /c YN /m "Try again"
if errorlevel 2 goto END
goto ASK_RANGES


:END
if defined LIST del "%LIST%" 2>nul
if defined SELECT del "%SELECT%" 2>nul

popd
echo.
pause
