def checkCountElement (ops , inCssSelecct) :  
    div = WebDriverWait(ops, 5).until(EC.presence_of_element_located((
                        By.CSS_SELECTOR, 
                        inCssSelecct
                            )))
    # get all elements in div
    children = div.find_elements(By.CSS_SELECTOR, "*") 
    # count of elements
    num_children = len(children)
    # print
    print("count in div:" , num_children)
    return num_children



