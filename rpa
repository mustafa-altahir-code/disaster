#to get dat from web
def getData(driver, css_selector, timeout=10):
    try:
        element = WebDriverWait(driver, timeout).until(
            EC.visibility_of_element_located((By.CSS_SELECTOR, css_selector))
        )
        data = element.text
        # logging.info(f"Retrieved data from {css_selector}")
        return data.strip() if data else "Not Found"
    except TimeoutException:
        return "Not Found"
