3. background.js
let currentOrder = null; // { orderId, tabId, searchTabId }
let isProcessingTab = false;

// استقبال الرسائل وإدارتها
chrome.runtime.onMessage.addListener((message, sender, sendResponse) => {
  
  // 1. طلب فتح تبويب للطلب التالي من صفحة اللوحة
  if (message.action === "OPEN_ORDER_TAB") {
    if (isProcessingTab) {
      sendResponse({ status: "BUSY" });
      return true;
    }

    isProcessingTab = true;
    currentOrder = {
      orderId: message.orderId,
      url: message.url,
      searchTabId: sender.tab.id,
      tabId: null
    };

    chrome.tabs.create({ url: message.url, active: true }, (tab) => {
      currentOrder.tabId = tab.id;
      sendResponse({ status: "STARTED", tabId: tab.id });
    });
    return true;
  }

  // 2. وصول البيانات المستخرجة من صفحة التفاصيل
  if (message.action === "DATA_EXTRACTED_SUCCESS") {
    if (!currentOrder || !currentOrder.searchTabId) return;

    // توجيه البيانات إلى صفحة اللوحة الرئيسية للحفظ أولاً
    chrome.tabs.sendMessage(currentOrder.searchTabId, {
      action: "SAVE_AND_VERIFY",
      orderId: message.orderId || currentOrder.orderId,
      deedNumbers: message.deedNumbers
    });
  }

  // 3. تأكيد اكتمال الحفظ بنجاح من اللوحة الرئيسية -> إغلاق التبويب بأمان
  if (message.action === "CONFIRM_CLOSE_DETAIL_TAB") {
    if (currentOrder && currentOrder.tabId) {
      const tabToClose = currentOrder.tabId;
      setTimeout(() => {
        chrome.tabs.remove(tabToClose, () => {
          isProcessingTab = false;
          currentOrder = null;
        });
      }, 1200); // مهلة قصيرة لعرض التمييز البصري
    }
  }

  // 4. الإبلاغ عن حدوث خطأ أثناء الاستخراج: لا يتم إغلاق التبويب للفحص
  if (message.action === "EXTRACTION_FAILED") {
    console.error(`[DU Crawler] فشل الاستخراج في الطلب: ${message.orderId}`, message.reason);
    if (currentOrder && currentOrder.searchTabId) {
      chrome.tabs.sendMessage(currentOrder.searchTabId, {
        action: "RECORD_ERROR",
        orderId: message.orderId || currentOrder.orderId,
        reason: message.reason
      });
    }
    // نحرر القفل ليتمكن المستخدم من المتابعة إذا أراد، مع بقاء التبويب مفتوحاً
    isProcessingTab = false;
  }

  // في حال إغلاق التبويب يدوياً من قبل المستخدم
  if (message.action === "RESET_LOCK") {
    isProcessingTab = false;
    currentOrder = null;
  }
});

// مراقبة إغلاق التبويبات يدوياً لإعادة تعيين الحالة
chrome.tabs.onRemoved.addListener((tabId) => {
  if (currentOrder && currentOrder.tabId === tabId) {
    isProcessingTab = false;
    if (currentOrder.searchTabId) {
      chrome.tabs.sendMessage(currentOrder.searchTabId, {
        action: "DETAIL_TAB_CLOSED_MANUALLY",
        orderId: currentOrder.orderId
      });
    }
    currentOrder = null;
  }
});

4. content_detail.js
(function () {
  'use strict';

  const LIST_SELECTOR = "#upgrade-deed-real-estate-number";

  // استخراج رقم الطلب DU من معلمات الرابط أو من محتوى الصفحة
  function getOrderIdFromPage() {
    const urlParams = new URLSearchParams(window.location.search);
    for (const [_, val] of urlParams.entries()) {
      const match = val.match(/\bDU\d+\b/);
      if (match) return match[0];
    }
    const pageMatch = document.body.innerText.match(/\bDU\d+\b/);
    return pageMatch ? pageMatch[0] : null;
  }

  // مراقبة تحميل العنصر في الـ DOM
  function waitForTargetElement(selector, timeout = 15000) {
    return new Promise((resolve, reject) => {
      const el = document.querySelector(selector);
      if (el) return resolve(el);

      const observer = new MutationObserver(() => {
        const target = document.querySelector(selector);
        if (target) {
          observer.disconnect();
          resolve(target);
        }
      });

      observer.observe(document.body, { childList: true, subtree: true });

      setTimeout(() => {
        observer.disconnect();
        reject(new Error(`انتهت المهلة بانتظار العنصر: ${selector}`));
      }, timeout);
    });
  }

  function displayErrorBadge(element, message) {
    if (!element) return;
    element.classList.add("du-highlight-red");
    const tip = document.createElement("div");
    tip.className = "du-error-tooltip";
    tip.textContent = message;
    element.appendChild(tip);
  }

  async function startExtraction() {
    const orderId = getOrderIdFromPage();

    try {
      // انتظار ظهور قائمة أرقام الصكوك/العقارات مباشرة
      const listElement = await waitForTargetElement(LIST_SELECTOR, 15000);

      // تمييز القائمة المستهدفة بإطار أخضر
      listElement.classList.add("du-highlight-green");
      await new Promise(r => setTimeout(r, 400));

      const extractedValues = [];

      if (listElement.tagName.toLowerCase() === "select") {
        const options = [...listElement.options].filter(o => o.value && o.value.trim() !== "");
        options.forEach(opt => {
          const txt = opt.text.trim();
          if (txt && !extractedValues.includes(txt)) extractedValues.push(txt);
        });
      } else {
        // فحص الخيارات كـ Divs, Li, Tr أو عناصر نصية مخصصة
        const subItems = listElement.querySelectorAll("li, tr, div[role='option'], .option, span, p");
        if (subItems.length > 0) {
          subItems.forEach(item => {
            const val = item.innerText.trim();
            if (val && !extractedValues.includes(val)) {
              extractedValues.push(val);
              item.classList.add("du-highlight-green");

              // إضافة علامة ✓ الخضراء
              const badge = document.createElement("span");
              badge.className = "du-badge-check";
              badge.textContent = "✓";
              item.prepend(badge);
            }
          });
        } else {
          // استخراج القيمة المباشرة إن كانت حقلاً نصياً فرداً
          const directVal = listElement.value || listElement.innerText.trim();
          if (directVal) {
            extractedValues.push(directVal);
            const badge = document.createElement("span");
            badge.className = "du-badge-check";
            badge.textContent = "✓";
            listElement.parentNode.insertBefore(badge, listElement.nextSibling);
          }
        }
      }

      if (extractedValues.length === 0) {
        displayErrorBadge(listElement, "تعذر العثور على أي قيم داخل القائمة");
        throw new Error("العنصر موجود ولكنه لا يحتوي على أي قيم");
      }

      // إرسال البيانات المستخرجة إلى الخلفية
      chrome.runtime.sendMessage({
        action: "DATA_EXTRACTED_SUCCESS",
        orderId: orderId,
        deedNumbers: extractedValues
      });

    } catch (error) {
      console.error("[DU Extractor]:", error.message);
      // تنبيه الخلفية بالخطأ لعدم إغلاق التبويب وإبقاء الحالة تحت المعاينة
      chrome.runtime.sendMessage({
        action: "EXTRACTION_FAILED",
        orderId: orderId,
        reason: error.message
      });
    }
  }

  // التأكد من استقرار الصفحة قبل البدء
  if (document.readyState === "complete") {
    setTimeout(startExtraction, 1500);
  } else {
    window.addEventListener("load", () => setTimeout(startExtraction, 1500));
  }
})();

