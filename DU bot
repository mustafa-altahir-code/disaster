3. background.js (المنسق ومدير التبويبات)
let currentWorkerTabId = null;

chrome.runtime.onMessage.addListener((message, sender, sendResponse) => {
  // فتح تبويب الطلب ومعالجته
  if (message.action === "PROCESS_ORDER_TAB") {
    chrome.tabs.create({ url: message.url, active: true }, (tab) => {
      currentWorkerTabId = tab.id;
      sendResponse({ status: "TAB_OPENED", tabId: tab.id });
    });
    return true;
  }

  // إغلاق تبويب الطلب بعد اكتمال الاستخراج بنجاح أو عند الخطأ
  if (message.action === "ORDER_DATA_EXTRACTED") {
    if (sender.tab && sender.tab.id) {
      setTimeout(() => {
        chrome.tabs.remove(sender.tab.id, () => {
          currentWorkerTabId = null;
        });
      }, 1200); // مهلة قصيرة للتأكد من رؤية المستخدم لعلامات النجاح ✓
    }
  }
});

4. content_detail.js (العمل داخل صفحة تفاصيل الطلب)
يقوم بالتحقق من وجود عناصر الصفحة، تطبيق الأطر الملونة، استخراج الصكوك، ووضع علامة ✓ بجانب كل صك تم التقاطه.
(function () {
  'use strict';

  // التحقق من أننا لسنا في الصفحة الرئيسية للبحث (مثلاً عبر فحص الرابط أو العناصر)
  const isSearchPage = document.querySelector("#upgrade-deed-real-estate-number") || 
                       document.body.innerText.includes("المراجعة") ||
                       window.location.href.includes("/request/") || 
                       window.location.href.includes("/order/");

  // محدد زر "المراجعة" المطلوب
  const reviewBtnSelector = "div > div.transition-all.flex-row-reverse.duration-700 > div.w-full.p-8.transition-all.duration-700:nth-of-type(2) > div.max-w-8xl.font-ibm-sans.inner-container.relative > div.mt-12:nth-of-type(6) > div.mt-10.mb-10:nth-of-type(3) > div.flex.items-center.justify-center > div.cursor-pointer:nth-of-type(6)";
  const listSelector = "#upgrade-deed-real-estate-number";

  function waitForElement(selector, timeout = 12000) {
    return new Promise((resolve, reject) => {
      const el = document.querySelector(selector);
      if (el) return resolve(el);

      const observer = new MutationObserver(() => {
        const target = document.querySelector(selector);
        if (target) {
          observer.disconnect();
          resolve(target);
        }
      });

      observer.observe(document.body, { childList: true, subtree: true });

      setTimeout(() => {
        observer.disconnect();
        reject(new Error(`Timeout waiting for ${selector}`));
      }, timeout);
    });
  }

  function markError(element, message) {
    if (!element) return;
    element.classList.add("du-highlight-red");
    const tip = document.createElement("div");
    tip.className = "du-error-tooltip";
    tip.textContent = message;
    element.style.position = "relative";
    element.appendChild(tip);
  }

  async function executeInspection() {
    try {
      // 1. انتظار عنصر المراجعة
      let reviewBtn = null;
      try {
        reviewBtn = await waitForElement(reviewBtnSelector, 10000);
      } catch (e) {
        // محاولة إيجاد العنصر بالاعتماد على النص إذا تغير تركيب DOM الدقيق
        const elements = [...document.querySelectorAll("div.cursor-pointer")];
        reviewBtn = elements.find(el => el.innerText.includes("المراجعة"));
      }

      if (!reviewBtn) {
        throw new Error("تعذر العثور على زر المراجعة");
      }

      // تمييز أصفر قبل النقر
      reviewBtn.classList.add("du-highlight-yellow");
      await new Promise(r => setTimeout(r, 600));

      reviewBtn.click();

      // 2. انتظار القائمة المستهدفة
      const listElement = await waitForElement(listSelector, 10000);
      listElement.classList.add("du-highlight-green");

      await new Promise(r => setTimeout(r, 500));

      // 3. استخراج القيم والتمييز بعلامة ✓
      const deedNumbers = [];

      // إذا كانت القائمة من نوع select
      if (listElement.tagName.toLowerCase() === "select") {
        const options = [...listElement.options].filter(o => o.value && o.value.trim() !== "");
        options.forEach(opt => deedNumbers.push(opt.text.trim()));
      } else {
        // إذا كانت القائمة عبارة عن حاوية، Dropdown مخصص، أو جدول
        const items = listElement.querySelectorAll("li, tr, div[role='option'], .item, span");
        if (items.length > 0) {
          items.forEach(item => {
            const val = item.innerText.trim();
            if (val && !deedNumbers.includes(val)) {
              deedNumbers.push(val);
              item.classList.add("du-highlight-green");
              
              const badge = document.createElement("span");
              badge.className = "du-badge-check";
              badge.textContent = "✓";
              item.prepend(badge);
            }
          });
        } else {
          // استخراج القيمة المباشرة إن كانت حقلاً نصياً
          const directVal = listElement.value || listElement.innerText.trim();
          if (directVal) {
            deedNumbers.push(directVal);
            const badge = document.createElement("span");
            badge.className = "du-badge-check";
            badge.textContent = "✓";
            listElement.parentNode.insertBefore(badge, listElement.nextSibling);
          }
        }
      }

      if (deedNumbers.length === 0) {
        markError(listElement, "لم يتم العثور على قيم داخل القائمة");
        throw new Error("القائمة فارغة");
      }

      // إرسال البيانات المستخرجة إلى تبويب البحث الرئيسي
      chrome.runtime.sendMessage({
        action: "EXTRACTED_DATA_RESPONSE",
        url: window.location.href,
        deedNumbers: deedNumbers
      });

      // إشعار الخلفية بنجاح العملية لإغلاق التبويب
      chrome.runtime.sendMessage({ action: "ORDER_DATA_EXTRACTED" });

    } catch (err) {
      console.error("[DU Detail Error]:", err.message);
      // إرسال تقرير خطأ لعدم تجميد عملية البحث
      chrome.runtime.sendMessage({
        action: "EXTRACTED_DATA_RESPONSE",
        url: window.location.href,
        error: err.message
      });
      chrome.runtime.sendMessage({ action: "ORDER_DATA_EXTRACTED" });
    }
  }

  // تشغيل الاستخراج فقط إذا لم نكن في جدول البحث العام
  if (!document.querySelector("#du-crawler-panel")) {
    // التحقق من جاهزية الصفحة
    if (document.readyState === "complete") {
      setTimeout(executeInspection, 1000);
    } else {
      window.addEventListener("load", () => setTimeout(executeInspection, 1000));
    }
  }
})();

5. content_search.js (لوحة التحكم وصفحة البحث)
(function () {
  'use strict';

  const tableSelector = "#__next > div > div.w-full.p-8.transition-all.duration-700 > div > div:nth-child(2) > div > div.mt-9.my-5 > div > div.overflow-x-auto.w-full > table > tbody";
  const paginationSelector = "#__next > div > div.w-full.p-8.transition-all.duration-700 > div > div:nth-child(2) > div > div.mt-9.my-5 > div > div:nth-child(5) > ul";

  // حفظ النتائج: Key = رقم الطلب DU، Value = مصفوفة القيم/الصكوك
  const results = new Map();
  let running = false;
  let currentQueue = [];
  let currentProcessingDU = null;

  // إنشاء واجهة المستخدم HUD
  const panel = document.createElement('div');
  panel.id = "du-crawler-panel";
  panel.style.cssText = `
    position: fixed;
    bottom: 20px;
    right: 20px;
    width: 580px;
    height: 520px;
    background: #0d1117;
    color: #58a6ff;
    z-index: 999999;
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    border: 1px solid #30363d;
    box-shadow: 0 8px 24px rgba(0,0,0,0.5);
    border-radius: 8px;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    direction: rtl;
  `;

  panel.innerHTML = `
    <div style="padding: 10px 14px; display:flex; justify-content:space-between; align-items:center; background:#161b22; border-bottom:1px solid #30363d">
      <b style="color:#58a6ff; font-size:14px">DU Crawler & Deed Extractor</b>
      <div style="display:flex; gap:6px">
        <button id="du-toggle" style="background:#238636;color:#fff;border:none;padding:4px 12px;border-radius:4px;cursor:pointer;font-weight:bold">بدء</button>
        <button id="du-clean" style="background:#21262d;color:#c9d1d9;border:1px solid #30363d;padding:4px 10px;border-radius:4px;cursor:pointer">مسح</button>
        <button id="du-csv" style="background:#1f6feb;color:#fff;border:none;padding:4px 12px;border-radius:4px;cursor:pointer">تصدير CSV</button>
      </div>
    </div>
    <div style="padding: 8px 14px; background:#0d1117; border-bottom:1px solid #30363d; font-size:12px; display:flex; justify-content:space-between; color:#8b949e">
      <span>الصفحة: <b id="du-pageInfo" style="color:#c9d1d9">-</b></span>
      <span>الطلبات المعالجة: <b id="du-count" style="color:#2ea043">0</b></span>
      <span>الحالة: <b id="du-status" style="color:#e3b341">جاهز</b></span>
    </div>
    <div style="flex:1; overflow-y:auto; padding: 6px;">
      <table style="width:100%; border-collapse:collapse; font-size:12px; text-align:right">
        <thead>
          <tr style="background:#161b22; color:#8b949e">
            <th style="padding:6px; border-bottom:1px solid #30363d; width:30%">رقم الطلب (DU)</th>
            <th style="padding:6px; border-bottom:1px solid #30363d; width:70%">القيم المستخرجة / الصكوك</th>
          </tr>
        </thead>
        <tbody id="du-body"></tbody>
      </table>
    </div>
  `;

  document.body.appendChild(panel);

  const btnToggle = panel.querySelector("#du-toggle");
  const btnClean = panel.querySelector("#du-clean");
  const btnCsv = panel.querySelector("#du-csv");
  const elBody = panel.querySelector("#du-body");
  const elCount = panel.querySelector("#du-count");
  const elStatus = panel.querySelector("#du-status");
  const elPageInfo = panel.querySelector("#du-pageInfo");

  btnToggle.onclick = () => {
    running = !running;
    btnToggle.textContent = running ? "إيقاف مؤقت" : "بدء";
    btnToggle.style.background = running ? "#da3633" : "#238636";
    if (running) {
      elStatus.textContent = "جاري العمل...";
      processCurrentPage();
    } else {
      elStatus.textContent = "متوقف";
    }
  };

  btnClean.onclick = () => {
    results.clear();
    render();
  };

  btnCsv.onclick = exportCSV;

  // استماع للبيانات الواردة من تبويب التفاصيل
  chrome.runtime.onMessage.addListener((message) => {
    if (message.action === "EXTRACTED_DATA_RESPONSE") {
      if (currentProcessingDU) {
        if (message.error) {
          results.set(currentProcessingDU, [`خطأ: ${message.error}`]);
        } else {
          results.set(currentProcessingDU, message.deedNumbers || []);
        }
        render();
      }
      // الانتقال لمعالجة العنصر التالي في القائمة
      setTimeout(processNextInQueue, 800);
    }
  });

  // مسح صفحة البحث واستخراج أرقام DU وروابطها
  function scanOrdersOnPage() {
    const tbody = document.querySelector(tableSelector);
    if (!tbody) return [];

    const rows = tbody.querySelectorAll("tr");
    const queue = [];

    rows.forEach(row => {
      const text = row.innerText;
      // البحث عن رقم الطلب DU (مثال DU123456)
      const match = text.match(/\bDU\d+\b/);
      if (match) {
        const orderId = match[0];
        // محاولة العثور على رابط التبويب أو زر الفتح
        const anchor = row.querySelector("a[href*='/'], button, [role='button']");
        const link = anchor && anchor.tagName.toLowerCase() === 'a' ? anchor.href : window.location.href;

        if (!results.has(orderId)) {
          queue.push({ id: orderId, element: row, link: link });
        }
      }
    });

    return queue;
  }

  async function processCurrentPage() {
    if (!running) return;

    elPageInfo.textContent = getPageKey();
    currentQueue = scanOrdersOnPage();

    if (currentQueue.length === 0) {
      // انتهت طلبات الصفحة الحالية، الانتقال للصفحة التالية
      elStatus.textContent = "الانتقال للصفحة التالية...";
      const moved = goNextPage();

      if (!moved) {
        elStatus.textContent = "اكتملت جميع الصفحات.";
        running = false;
        btnToggle.textContent = "بدء";
        btnToggle.style.background = "#238636";
        return;
      }

      // الانتظار حتى تحميل الصفحة الجديدة
      setTimeout(() => {
        processCurrentPage();
      }, 3000);
      return;
    }

    processNextInQueue();
  }

  function processNextInQueue() {
    if (!running) return;

    if (currentQueue.length === 0) {
      // إعادة فحص الصفحة في حال بقاء عناصر أو الانتقال
      processCurrentPage();
      return;
    }

    const item = currentQueue.shift();
    currentProcessingDU = item.id;
    elStatus.textContent = `معالجة: ${item.id}`;

    // فتح الطلب في تبويب عبر Background Script
    chrome.runtime.sendMessage({
      action: "PROCESS_ORDER_TAB",
      url: item.link
    });
  }

  function getPageKey() {
    const pag = document.querySelector(paginationSelector);
    if (!pag) return "-";
    const active = pag.querySelector(".active, [aria-current='page']");
    return active ? active.innerText.trim() : "نشط";
  }

  function goNextPage() {
    const pag = document.querySelector(paginationSelector);
    if (!pag) return false;

    const buttons = [...pag.querySelectorAll("li, button, a")];
    const activeIndex = buttons.findIndex(b =>
      b.classList.contains("active") || b.getAttribute("aria-current") === "page"
    );

    const next = buttons[activeIndex + 1];
    if (next) {
      next.click();
      return true;
    }
    return false;
  }

  function render() {
    elBody.innerHTML = [...results.entries()]
      .map(([du, values]) => `
        <tr>
          <td style="padding:6px; border-bottom:1px solid #21262d; font-family:monospace; color:#79c0ff">${du}</td>
          <td style="padding:6px; border-bottom:1px solid #21262d; color:#c9d1d9">
            ${values.map(v => `<span style="display:inline-block; background:#21262d; padding:2px 6px; margin:2px; border-radius:3px; font-size:11px">${v}</span>`).join('')}
          </td>
        </tr>
      `).join('');

    elCount.textContent = results.size;
  }

  function exportCSV() {
    if (results.size === 0) {
      alert("لا توجد بيانات للتصدير.");
      return;
    }

    const rows = [["DU_ORDER_NUMBER", "EXTRACTED_VALUES"]];

    results.forEach((values, du) => {
      const combined = values.join(" | ");
      const cleanVal = `"${combined.replace(/"/g, '""')}"`;
      rows.push([du, cleanVal]);
    });

    const csvContent = "\uFEFF" + rows.map(r => r.join(",")).join("\n");
    const blob = new Blob([csvContent], { type: "text/csv;charset=utf-8;" });
    const url = URL.createObjectURL(blob);

    const a = document.createElement("a");
    a.href = url;
    a.download = `du_extracted_deeds_${new Date().toISOString().slice(0, 10)}.csv`;
    a.click();
    URL.revokeObjectURL(url);
  }
})();

طريقة التثبيت والاستخدام
 * ضع الملفات الخمسة المذكورة أعلاه في مجلد واحد باسم du-crawler-extension.
 * افتح المتصفح (Chrome أو Edge أو أي متصفح يدعم Chromium) وتوجه إلى:
   chrome://extensions/
 * قم بتفعيل وضع مطوّر البرامج (Developer Mode) من الزاوية العلوية.
 * اضغط على تحميل حزمة غير مضغوطة (Load unpacked) واختر المجلد.
 * افتح صفحة البحث في النظام؛ ستظهر لوحة التحكم المحدثة في أسفل الشاشة، اضغط بدء لمباشرة استخراج الطلبات وتصديرها بصيغة CSV بعد الانتهاء.
