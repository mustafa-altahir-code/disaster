تم تحديث ملف content_search.js بالكامل ليعالج متطلباتك بدقة:
 * الاعتماد على محددات rc-pagination القياسية والديناميكية:
   * الحاوية: ul.rc-pagination
   * الصفحة النشطة: li.rc-pagination-item-active a (أو li.rc-pagination-item-active)
   * الزر التالي: li.rc-pagination-next مع فحص فئات التعطيل rc-pagination-disabled وخاصية aria-disabled="true".
 * آلية انتقال وتحقق متينة من تحديث الجدول:
   * انتظار تغير رقم الصفحة النشطة فعلياً، مع فحص تحديث محتوى جدول الـ DOM.
   * إعادة المحاولة تلقائياً (حتى 3 محاولات) في حال عدم استجابة النقر، وتسجيل أسباب التأخير في console.warn / console.error.
 * خانة لتحديد نطاق الصفحات (Start Page / End Page):
   * حقول إدخال في واجهة الـ HUD لاختيار صفحة البداية وصفحة التوقف، والتوقف تلقائياً بمجرد إكمال صفحة النهاية المحددة.
 * تحديث أسماء أعمدة تصدير الـ CSV/Excel:
   * تم تعديل الرؤوس لتصبح رسمياً: Case no و Pcp.
ملف content_search.js المحدّث
(function () {
  'use strict';

  // المحددات الأساسية
  const TABLE_SELECTOR = "#__next > div > div.w-full.p-8.transition-all.duration-700 > div > div:nth-child(2) > div > div.mt-9.my-5 > div > div.overflow-x-auto.w-full > table > tbody";
  const PAGINATION_CONTAINER = "ul.rc-pagination";
  const ACTIVE_PAGE_SELECTOR = "li.rc-pagination-item-active a, li.rc-pagination-item-active";
  const NEXT_PAGE_SELECTOR = "li.rc-pagination-next";

  const results = new Map(); // orderId -> Array of extracted values
  const failedOrders = new Set();
  
  let running = false;
  let queue = [];
  let currentProcessingId = null;

  // ===== بناء واجهة المستخدم HUD =====
  const panel = document.createElement('div');
  panel.id = "du-crawler-hud";
  panel.style.cssText = `
    position: fixed;
    bottom: 20px;
    right: 20px;
    width: 630px;
    height: 570px;
    background: #0f172a;
    color: #38bdf8;
    z-index: 999999;
    font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    border: 1px solid #334155;
    box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.6);
    border-radius: 8px;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    direction: rtl;
  `;

  panel.innerHTML = `
    <!-- الرأس وأزرار التحكم -->
    <div style="padding: 10px 14px; display:flex; justify-content:space-between; align-items:center; background:#1e293b; border-bottom:1px solid #334155">
      <b style="color:#f8fafc; font-size:14px">DU Crawler Panel</b>
      <div style="display:flex; gap:6px">
        <button id="du-btn-toggle" style="background:#16a34a;color:#fff;border:none;padding:5px 14px;border-radius:4px;cursor:pointer;font-weight:600">بدء</button>
        <button id="du-btn-clean" style="background:#334155;color:#e2e8f0;border:none;padding:5px 12px;border-radius:4px;cursor:pointer">تفريغ</button>
        <button id="du-btn-csv" style="background:#0284c7;color:#fff;border:none;padding:5px 14px;border-radius:4px;cursor:pointer;font-weight:600">تصدير CSV</button>
      </div>
    </div>

    <!-- شريط نطاق الصفحات -->
    <div style="padding: 6px 14px; background:#1e293b; border-bottom:1px solid #334155; font-size:12px; display:flex; align-items:center; gap:10px; color:#94a3b8">
      <span>نطاق الصفحات:</span>
      <label style="display:flex; align-items:center; gap:4px">
        من:
        <input type="number" id="du-page-start" min="1" placeholder="الحالية" style="width:60px; background:#0f172a; border:1px solid #475569; color:#f8fafc; padding:2px 6px; border-radius:3px; text-align:center" />
      </label>
      <label style="display:flex; align-items:center; gap:4px">
        إلى:
        <input type="number" id="du-page-end" min="1" placeholder="الكل" style="width:60px; background:#0f172a; border:1px solid #475569; color:#f8fafc; padding:2px 6px; border-radius:3px; text-align:center" />
      </label>
      <span style="font-size:11px; color:#64748b">(اتركه فارغاً للمتابعة حتى النهاية)</span>
    </div>

    <!-- شريط الإحصائيات -->
    <div style="padding: 6px 14px; background:#0f172a; border-bottom:1px solid #334155; font-size:12px; display:flex; justify-content:space-between; color:#94a3b8">
      <span>الصفحة النشطة: <b id="du-page-num" style="color:#f8fafc">-</b></span>
      <span>المكتمل: <b id="du-success-count" style="color:#4ade80">0</b></span>
      <span>الحالة: <b id="du-status-text" style="color:#fbbf24">جاهز للبدء</b></span>
    </div>

    <!-- جدول عرض النتائج المباشرة -->
    <div style="flex:1; overflow-y:auto; padding:6px;">
      <table style="width:100%; border-collapse:collapse; font-size:12px; text-align:right">
        <thead>
          <tr style="background:#1e293b; color:#94a3b8">
            <th style="padding:6px; border-bottom:1px solid #334155; width:30%">Case no (DU)</th>
            <th style="padding:6px; border-bottom:1px solid #334155; width:70%">Pcp (القيم المستخرجة)</th>
          </tr>
        </thead>
        <tbody id="du-table-body"></tbody>
      </table>
    </div>
  `;

  document.body.appendChild(panel);

  const btnToggle = panel.querySelector("#du-btn-toggle");
  const btnClean = panel.querySelector("#du-btn-clean");
  const btnCsv = panel.querySelector("#du-btn-csv");
  const inputStartPage = panel.querySelector("#du-page-start");
  const inputEndPage = panel.querySelector("#du-page-end");
  const tableBody = panel.querySelector("#du-table-body");
  const lblCount = panel.querySelector("#du-success-count");
  const lblStatus = panel.querySelector("#du-status-text");
  const lblPage = panel.querySelector("#du-page-num");

  btnToggle.onclick = () => {
    running = !running;
    btnToggle.textContent = running ? "إيقاف مؤقت" : "بدء";
    btnToggle.style.background = running ? "#dc2626" : "#16a34a";

    if (running) {
      lblStatus.textContent = "جاري البدء...";
      initiateFlow();
    } else {
      lblStatus.textContent = "متوقف مؤقتاً";
    }
  };

  btnClean.onclick = () => {
    results.clear();
    failedOrders.clear();
    renderUI();
  };

  btnCsv.onclick = exportCSV;

  // ===== الاستماع للرسائل من التبويبات والخلفية =====
  chrome.runtime.onMessage.addListener((msg) => {
    if (msg.action === "SAVE_AND_VERIFY") {
      if (msg.orderId && msg.deedNumbers && msg.deedNumbers.length > 0) {
        results.set(msg.orderId, msg.deedNumbers);
        renderUI();

        // تأكيد الحفظ بنجاح ليتم إغلاق التبويب من الـ background
        chrome.runtime.sendMessage({ action: "CONFIRM_CLOSE_DETAIL_TAB" });

        // متابعة الطلب التالي في الطابور
        setTimeout(processNextQueueItem, 1000);
      }
    }

    if (msg.action === "RECORD_ERROR") {
      failedOrders.add(msg.orderId);
      results.set(msg.orderId, [`⚠️ ${msg.reason}`]);
      renderUI();
      lblStatus.textContent = `فشل في ${msg.orderId}`;
      console.error(`[DU Crawler] حدث خطأ في الطلب: ${msg.orderId}`, msg.reason);
    }

    if (msg.action === "DETAIL_TAB_CLOSED_MANUALLY") {
      setTimeout(processNextQueueItem, 600);
    }
  });

  // ===== دوال الترقيم (Pagination) عبر rc-pagination =====

  function getActivePageNumber() {
    const pag = document.querySelector(PAGINATION_CONTAINER);
    if (!pag) return null;

    const activeItem = pag.querySelector(ACTIVE_PAGE_SELECTOR);
    if (!activeItem) return null;

    const num = parseInt(activeItem.textContent.trim(), 10);
    return isNaN(num) ? null : num;
  }

  function isNextButtonDisabled(nextBtnLi) {
    if (!nextBtnLi) return true;
    return (
      nextBtnLi.classList.contains("rc-pagination-disabled") ||
      nextBtnLi.getAttribute("aria-disabled") === "true" ||
      nextBtnLi.querySelector("button[disabled], a[disabled]") !== null
    );
  }

  async function goToSpecificPage(targetPage) {
    const pag = document.querySelector(PAGINATION_CONTAINER);
    if (!pag) return false;

    const pageItems = [...pag.querySelectorAll("li.rc-pagination-item")];
    const targetLi = pageItems.find(li => {
      const a = li.querySelector("a") || li;
      return a.textContent.trim() === String(targetPage);
    });

    if (targetLi) {
      const clickTarget = targetLi.querySelector("a, button") || targetLi;
      clickTarget.click();
      return true;
    }
    return false;
  }

  async function clickNextPageWithVerification(maxRetries = 3) {
    const pag = document.querySelector(PAGINATION_CONTAINER);
    if (!pag) {
      console.warn("[DU Crawler] لم يتم العثور على حاوية rc-pagination.");
      return false;
    }

    const nextLi = pag.querySelector(NEXT_PAGE_SELECTOR);
    if (!nextLi || isNextButtonDisabled(nextLi)) {
      console.log("[DU Crawler] تم الوصول إلى آخر صفحة متاحة (الزر التالي غير متاح أو معطّل).");
      return false;
    }

    const currentPage = getActivePageNumber();
    const oldFirstRowText = document.querySelector(`${TABLE_SELECTOR} tr`)?.innerText || "";

    for (let attempt = 1; attempt <= maxRetries; attempt++) {
      if (!running) return false;

      lblStatus.textContent = `جاري الانتقال للصفحة التالية (محاولة ${attempt})...`;
      const clickElement = nextLi.querySelector("button, a") || nextLi;
      clickElement.click();

      // انتظار تحديث الصفحة والتأكد من تغيير الرقم النشط وتغير الـ DOM
      const changed = await waitForPageChange(currentPage, oldFirstRowText, 7000);
      if (changed) {
        return true;
      }

      console.warn(`[DU Crawler] المحاولة ${attempt} للانتقال لم تسفر عن تغيير الصفحة. إعادة المحاولة...`);
      await new Promise(r => setTimeout(r, 1500));
    }

    console.error("[DU Crawler] فشل الانتقال للصفحة التالية بعد استنفاد محاولات النقر.");
    return false;
  }

  function waitForPageChange(oldPage, oldContent, timeout = 7000) {
    return new Promise(resolve => {
      const startTime = Date.now();

      const interval = setInterval(() => {
        const newPage = getActivePageNumber();
        const currentFirstRow = document.querySelector(`${TABLE_SELECTOR} tr`)?.innerText || "";

        // نجاح الانتقال: إما تغير رقم الصفحة، أو تغير محتوى الصف الأول مع وجود صفحة جديدة
        if ((newPage && oldPage && newPage !== oldPage) || (currentFirstRow && currentFirstRow !== oldContent)) {
          clearInterval(interval);
          resolve(true);
        } else if (Date.now() - startTime >= timeout) {
          clearInterval(interval);
          resolve(false);
        }
      }, 400);
    });
  }

  // ===== قراءة الطلبات والتحكم بالتدفق =====

  function scanCurrentPageOrders() {
    const tbody = document.querySelector(TABLE_SELECTOR);
    if (!tbody) return [];

    const rows = tbody.querySelectorAll("tr");
    const found = [];

    rows.forEach(row => {
      const text = row.innerText;
      const match = text.match(/\bDU\d+\b/);
      if (match) {
        const orderId = match[0];

        // منع تكرار معالجة الطلبات المسجلة مسبقاً
        if (!results.has(orderId) && !failedOrders.has(orderId)) {
          const linkEl = row.querySelector("a[href*='deed-upgrade-case-view']");
          let targetUrl = linkEl ? linkEl.href : null;

          if (!targetUrl) {
            targetUrl = `https://ops.rer.sa/deed-upgrade-case-view?requestId=${orderId}`;
          }

          found.push({ orderId, url: targetUrl });
        }
      }
    });

    return found;
  }

  async function initiateFlow() {
    const currentActive = getActivePageNumber();
    const startVal = parseInt(inputStartPage.value, 10);

    // إذا حدد المستخدم صفحة بداية مختلفة عن الصفحة المعروضة حالياً
    if (!isNaN(startVal) && currentActive && startVal !== currentActive) {
      lblStatus.textContent = `الانتقال إلى صفحة البداية المحددة: ${startVal}...`;
      const moved = await goToSpecificPage(startVal);
      if (moved) {
        await new Promise(r => setTimeout(r, 3000));
      }
    }

    processCurrentPage();
  }

  async function processCurrentPage() {
    if (!running) return;

    const currentPageNum = getActivePageNumber();
    lblPage.textContent = currentPageNum !== null ? currentPageNum : "-";

    // التحقق من حد صفحة النهاية
    const endVal = parseInt(inputEndPage.value, 10);
    if (!isNaN(endVal) && currentPageNum && currentPageNum > endVal) {
      lblStatus.textContent = `تم الوصول لنهاية النطاق المحدد (صفحة ${endVal}).`;
      stopCrawler();
      return;
    }

    queue = scanCurrentPageOrders();

    if (queue.length === 0) {
      // التحقق مما إذا كانت هذه هي صفحة النهاية المحددة
      if (!isNaN(endVal) && currentPageNum && currentPageNum >= endVal) {
        lblStatus.textContent = `اكتملت طلبات الصفحة ${currentPageNum} (نهاية النطاق).`;
        stopCrawler();
        return;
      }

      lblStatus.textContent = "اكتملت طلبات الصفحة، جاري الانتقال...";
      const moved = await clickNextPageWithVerification();

      if (!moved) {
        lblStatus.textContent = "انتهت جميع الصفحات.";
        stopCrawler();
        return;
      }

      // مهلة استقرار للـ DOM بعد الانتقال
      await new Promise(r => setTimeout(r, 2000));
      processCurrentPage();
      return;
    }

    processNextQueueItem();
  }

  function processNextQueueItem() {
    if (!running) return;

    if (queue.length === 0) {
      // فحص مجدد للتأكد من اكتمال عناصر الصفحة قبل طلب الصفحة التالية
      processCurrentPage();
      return;
    }

    const item = queue.shift();
    currentProcessingId = item.orderId;
    lblStatus.textContent = `معالجة الطلب: ${item.orderId}`;

    chrome.runtime.sendMessage({
      action: "OPEN_ORDER_TAB",
      orderId: item.orderId,
      url: item.url
    }, (res) => {
      if (res && res.status === "BUSY") {
        queue.unshift(item);
        setTimeout(processNextQueueItem, 1500);
      }
    });
  }

  function stopCrawler() {
    running = false;
    btnToggle.textContent = "بدء";
    btnToggle.style.background = "#16a34a";
  }

  function renderUI() {
    tableBody.innerHTML = [...results.entries()]
      .map(([orderId, values]) => `
        <tr>
          <td style="padding:6px; border-bottom:1px solid #1e293b; font-family:monospace; color:#38bdf8">${orderId}</td>
          <td style="padding:6px; border-bottom:1px solid #1e293b; color:#f1f5f9">
            ${values.map(v => `<span style="display:inline-block; background:#1e293b; padding:2px 8px; margin:2px; border-radius:4px; font-size:11px; border:1px solid #334155">${v}</span>`).join('')}
          </td>
        </tr>
      `).join('');

    lblCount.textContent = results.size;
  }

  // ===== تصدير النتائج بأسماء الحقول: Case no و Pcp =====
  function exportCSV() {
    if (results.size === 0) {
      alert("لا توجد بيانات متاحة للتصدير حالياً.");
      return;
    }

    const rows = [["Case no", "Pcp"]];

    results.forEach((values, caseNo) => {
      const pcpCombined = values.join(" | ");
      const escapedPcp = `"${pcpCombined.replace(/"/g, '""')}"`;
      rows.push([caseNo, escapedPcp]);
    });

    const csvContent = "\uFEFF" + rows.map(r => r.join(",")).join("\n");
    const blob = new Blob([csvContent], { type: "text/csv;charset=utf-8;" });
    const url = URL.createObjectURL(blob);

    const a = document.createElement("a");
    a.href = url;
    a.download = `DU_Extract_${new Date().toISOString().slice(0, 10)}.csv`;
    a.click();
    URL.revokeObjectURL(url);
  }
})();

ما تم ضبطه في هذا التحديث:
 * حقول النطاق (من / إلى): يمكنك إدخال مثلاً من: 1 و إلى: 5 لمعالجة الصفحات الخمس الأولى والتوقف تلقائياً، أو ترك الحقول فارغة لمتابعة المعالجة حتى آخر صفحة متاحة.
 * دقة النقر على الترقيم: بدلاً من النقر المباشر دون فحص، تقوم الدالة بفحص علامة التعطيل rc-pagination-disabled أو aria-disabled="true".
 * التحقق من تغيير الصفحة: لا تستأنف الإضافة سحب البيانات إلا بعد التأكد التام من تغير رقم الصفحة النشطة أو تجدد نصوص صفوف الجدول لتفادي تكرار سحب الصفحة نفسها.
 * رؤوس ملف الإكسل/CSV: تم اعتماد التسمية المطلوبة: العمود الأول Case no والعمود الثاني Pcp.
