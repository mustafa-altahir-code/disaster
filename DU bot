(function () {
  'use strict';

  const tableSelector = "#__next > div > div.w-full.p-8.transition-all.duration-700 > div > div:nth-child(2) > div > div.mt-9.my-5 > div > div.overflow-x-auto.w-full > table > tbody";
  const paginationSelector = "#__next > div > div.w-full.p-8.transition-all.duration-700 > div > div:nth-child(2) > div > div.mt-9.my-5 > div > div:nth-child(5) > ul";

  const results = new Map(); // orderId -> Array of deed numbers
  const failedOrders = new Set();
  let running = false;
  let queue = [];
  let currentProcessingId = null;

  // إنشاء اللوحة في الواجهة
  const panel = document.createElement('div');
  panel.id = "du-crawler-hud";
  panel.style.cssText = `
    position: fixed;
    bottom: 20px;
    right: 20px;
    width: 620px;
    height: 540px;
    background: #0f172a;
    color: #38bdf8;
    z-index: 999999;
    font-family: system-ui, -apple-system, sans-serif;
    border: 1px solid #334155;
    box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.5);
    border-radius: 8px;
    display: flex;
    flex-direction: column;
    overflow: hidden;
    direction: rtl;
  `;

  panel.innerHTML = `
    <div style="padding: 12px 16px; display:flex; justify-content:space-between; align-items:center; background:#1e293b; border-bottom:1px solid #334155">
      <b style="color:#f8fafc; font-size:14px">DU Crawler Panel (Dashboard)</b>
      <div style="display:flex; gap:8px">
        <button id="du-btn-toggle" style="background:#16a34a;color:#fff;border:none;padding:5px 14px;border-radius:4px;cursor:pointer;font-weight:600">بدء</button>
        <button id="du-btn-clean" style="background:#334155;color:#e2e8f0;border:none;padding:5px 12px;border-radius:4px;cursor:pointer">تفريغ</button>
        <button id="du-btn-csv" style="background:#0284c7;color:#fff;border:none;padding:5px 14px;border-radius:4px;cursor:pointer;font-weight:600">تصدير CSV</button>
      </div>
    </div>
    <div style="padding: 8px 16px; background:#0f172a; border-bottom:1px solid #334155; font-size:12px; display:flex; justify-content:space-between; color:#94a3b8">
      <span>الصفحة: <b id="du-page-num" style="color:#f8fafc">-</b></span>
      <span>المكتمل: <b id="du-success-count" style="color:#4ade80">0</b></span>
      <span>الحالة: <b id="du-status-text" style="color:#fbbf24">جاهز للبدء</b></span>
    </div>
    <div style="flex:1; overflow-y:auto; padding:8px;">
      <table style="width:100%; border-collapse:collapse; font-size:12px; text-align:right">
        <thead>
          <tr style="background:#1e293b; color:#94a3b8">
            <th style="padding:6px; border-bottom:1px solid #334155; width:28%">رقم الطلب DU</th>
            <th style="padding:6px; border-bottom:1px solid #334155; width:72%">القيم المستخرجة</th>
          </tr>
        </thead>
        <tbody id="du-table-body"></tbody>
      </table>
    </div>
  `;

  document.body.appendChild(panel);

  const btnToggle = panel.querySelector("#du-btn-toggle");
  const btnClean = panel.querySelector("#du-btn-clean");
  const btnCsv = panel.querySelector("#du-btn-csv");
  const tableBody = panel.querySelector("#du-table-body");
  const lblCount = panel.querySelector("#du-success-count");
  const lblStatus = panel.querySelector("#du-status-text");
  const lblPage = panel.querySelector("#du-page-num");

  btnToggle.onclick = () => {
    running = !running;
    btnToggle.textContent = running ? "إيقاف مؤقت" : "بدء";
    btnToggle.style.background = running ? "#dc2626" : "#16a34a";
    if (running) {
      lblStatus.textContent = "جاري العمل...";
      processCurrentPage();
    } else {
      lblStatus.textContent = "متوقف مؤقتاً";
    }
  };

  btnClean.onclick = () => {
    results.clear();
    failedOrders.clear();
    renderUI();
  };

  btnCsv.onclick = exportCSV;

  // استماع للرسائل الواردة من Background و Detail
  chrome.runtime.onMessage.addListener((msg) => {
    if (msg.action === "SAVE_AND_VERIFY") {
      // 1. حفظ النتائج في Map الخاص باللوحة لمنع التكرار
      if (msg.orderId && msg.deedNumbers && msg.deedNumbers.length > 0) {
        results.set(msg.orderId, msg.deedNumbers);
        renderUI();

        // 2. إرسال تأكيد الحفظ بنجاح ليتم إغلاق تبويب الطلب بأمان
        chrome.runtime.sendMessage({ action: "CONFIRM_CLOSE_DETAIL_TAB" });

        // 3. التجهيز لمعالجة العنصر التالي بعد مهلة قصيرة
        setTimeout(processNextQueueItem, 1000);
      }
    }

    if (msg.action === "RECORD_ERROR") {
      failedOrders.add(msg.orderId);
      results.set(msg.orderId, [`⚠️ ${msg.reason}`]);
      renderUI();
      lblStatus.textContent = `فشل في ${msg.orderId} (التبويب ما زال مفتوحاً للتحقق)`;
    }

    if (msg.action === "DETAIL_TAB_CLOSED_MANUALLY") {
      // متابعة الطابور في حال قام المستخدم بإغلاق التبويب يدوياً
      setTimeout(processNextQueueItem, 500);
    }
  });

  // مسح جدول الطلبات واكتشاف العناصر الجديدة
  function scanPageOrders() {
    const tbody = document.querySelector(tableSelector);
    if (!tbody) return [];

    const rows = tbody.querySelectorAll("tr");
    const found = [];

    rows.forEach(row => {
      const match = row.innerText.match(/\bDU\d+\b/);
      if (match) {
        const orderId = match[0];

        // تجاهل الطلبات المحفوظة مسبقاً
        if (!results.has(orderId) && !failedOrders.has(orderId)) {
          // استخراج الرابط من الوسم a أو الزر داخل السطر
          const linkEl = row.querySelector("a[href*='deed-upgrade-case-view']");
          let targetUrl = linkEl ? linkEl.href : null;

          // في حال كانت الصفحة لا تضع الرابط داخل a وإنما عبر معرّف أو click
          if (!targetUrl) {
            targetUrl = `https://ops.rer.sa/deed-upgrade-case-view?requestId=${orderId}`;
          }

          found.push({ orderId, url: targetUrl });
        }
      }
    });

    return found;
  }

  async function processCurrentPage() {
    if (!running) return;

    lblPage.textContent = getCurrentPageKey();
    queue = scanPageOrders();

    if (queue.length === 0) {
      lblStatus.textContent = "اكتملت طلبات الصفحة، جاري الانتقال...";
      const moved = advanceNextPage();

      if (!moved) {
        lblStatus.textContent = "تم استخراج جميع الصفحات بنجاح.";
        running = false;
        btnToggle.textContent = "بدء";
        btnToggle.style.background = "#16a34a";
        return;
      }

      // مهلة لتحميل محتوى الصفحة الجديدة
      setTimeout(processCurrentPage, 3500);
      return;
    }

    processNextQueueItem();
  }

  function processNextQueueItem() {
    if (!running) return;

    if (queue.length === 0) {
      processCurrentPage();
      return;
    }

    const item = queue.shift();
    currentProcessingId = item.orderId;
    lblStatus.textContent = `معالجة الطلب: ${item.orderId}`;

    chrome.runtime.sendMessage({
      action: "OPEN_ORDER_TAB",
      orderId: item.orderId,
      url: item.url
    }, (res) => {
      if (res && res.status === "BUSY") {
        // إعادة الطلب في حال كان النظام منشغلاً
        queue.unshift(item);
        setTimeout(processNextQueueItem, 1500);
      }
    });
  }

  function getCurrentPageKey() {
    const pag = document.querySelector(paginationSelector);
    if (!pag) return "-";
    const active = pag.querySelector(".active, [aria-current='page']");
    return active ? active.innerText.trim() : "نشط";
  }

  function advanceNextPage() {
    const pag = document.querySelector(paginationSelector);
    if (!pag) return false;

    const listItems = [...pag.querySelectorAll("li, button, a")];
    const activeIndex = listItems.findIndex(el =>
      el.classList.contains("active") || el.getAttribute("aria-current") === "page"
    );

    if (activeIndex !== -1 && listItems[activeIndex + 1]) {
      const nextBtn = listItems[activeIndex + 1].querySelector("button, a") || listItems[activeIndex + 1];
      nextBtn.click();
      return true;
    }
    return false;
  }

  function renderUI() {
    tableBody.innerHTML = [...results.entries()]
      .map(([orderId, values]) => `
        <tr>
          <td style="padding:6px; border-bottom:1px solid #1e293b; font-family:monospace; color:#38bdf8">${orderId}</td>
          <td style="padding:6px; border-bottom:1px solid #1e293b; color:#f1f5f9">
            ${values.map(v => `<span style="display:inline-block; background:#1e293b; padding:2px 8px; margin:2px; border-radius:4px; font-size:11px; border:1px solid #334155">${v}</span>`).join('')}
          </td>
        </tr>
      `).join('');

    lblCount.textContent = results.size;
  }

  function exportCSV() {
    if (results.size === 0) {
      alert("لا توجد بيانات متاحة للتصدير حالياً.");
      return;
    }

    const rows = [["DU_ORDER_NUMBER", "EXTRACTED_DEEDS"]];

    results.forEach((values, du) => {
      const combined = values.join(" | ");
      const escaped = `"${combined.replace(/"/g, '""')}"`;
      rows.push([du, escaped]);
    });

    const csvContent = "\uFEFF" + rows.map(r => r.join(",")).join("\n");
    const blob = new Blob([csvContent], { type: "text/csv;charset=utf-8;" });
    const url = URL.createObjectURL(blob);

    const a = document.createElement("a");
    a.href = url;
    a.download = `DU_Extract_${new Date().toISOString().slice(0, 10)}.csv`;
    a.click();
    URL.revokeObjectURL(url);
  }
})();

آلية التشغيل
 * حدّث ملفات المجلد بالتعديلات السابقة.
 * توجّه إلى chrome://extensions/ واضغط على زر Reload للإضافة.
 * افتح صفحة لوحة الطلبات [https://ops.rer.sa/deed-upgrade-dashboard](https://ops.rer.sa/deed-upgrade-dashboard)؛ ستظهر لوحة التحكم مباشرة أسفل الشاشة.
 * اضغط على زر بدء:
   * سيقوم بقراءة طلبات DU بالتتابع وفتح كل طلب في تبويب مستقل.
   * داخل صفحة التفاصيل deed-upgrade-case-view، يبدأ استخراج أرقام الصكوك من #upgrade-deed-real-estate-number مباشرة مع التمييز بالأخضر وإضافة علامة ✓.
   * لا يُغلق تبويب الطلب إلا بعد وصول إشعار تأكيد الحفظ في لوحة التحكم الرئيسية، وفي حال حدوث أي خطأ يبقى التبويب مفتوحاً ليتمكن الفحص اليدوي دون تعطيل باقي القائمة.
