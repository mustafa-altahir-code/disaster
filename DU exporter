(function () {
  'use strict';

  const LIST_SELECTOR = "#upgrade-deed-real-estate-number";
  const MAX_CLICKS = 6;
  const CLICK_INTERVAL = 25;

  function delay(ms) {
    return new Promise(resolve => setTimeout(resolve, ms));
  }

  function getOrderIdFromUrl() {
    const params = new URLSearchParams(window.location.search);
    return params.get("caseId") || params.get("requestId") || (document.body.innerText.match(/\bDU\d+\b/)?.[0] || null);
  }

  // 1. الانتقال السريع للمراجعة
  async function fastNavigateToReview() {
    let clicked = 0;
    let retries = 0;
    const maxRetries = 25;

    while (clicked < MAX_CLICKS && retries < maxRetries) {
      if (document.querySelector(LIST_SELECTOR)) break;

      const img = document.querySelector('button img[src$="left.svg"]');
      if (!img) {
        retries++;
        await delay(200);
        continue;
      }

      const btn = img.closest("button");
      if (!btn) {
        retries++;
        await delay(200);
        continue;
      }

      btn.click();
      clicked++;
      await delay(CLICK_INTERVAL);
    }
  }

  function waitForList(timeout = 12000) {
    return new Promise((resolve, reject) => {
      const el = document.querySelector(LIST_SELECTOR);
      if (el) return resolve(el);

      const observer = new MutationObserver(() => {
        const target = document.querySelector(LIST_SELECTOR);
        if (target) {
          observer.disconnect();
          resolve(target);
        }
      });

      observer.observe(document.body, { childList: true, subtree: true });

      setTimeout(() => {
        observer.disconnect();
        reject(new Error(`تعذر العثور على القائمة: ${LIST_SELECTOR}`));
      }, timeout);
    });
  }

  // 2. فحص عدد التعليقات / التوصيات
  async function countRecommendations() {
    try {
      const xpath = "/html/body/div[1]/div[1]/div[2]/div[1]/div[6]/div[9]/div[1]/div[1]/span[1]";
      const btn = document.evaluate(xpath, document, null, XPathResult.FIRST_ORDERED_NODE_TYPE, null).singleNodeValue;
      
      if (!btn) {
        // إذا لم يكن الزر موجوداً، فهذا يعني غالباً عدم وجود لوحة توصيات سابقة (0)
        return 0;
      }

      btn.click();
      await delay(800);

      const panel = document.querySelector(
        String.raw`div > div.transition-all.flex-row-reverse.duration-700 > div.w-full.p-8.transition-all.duration-700:nth-of-type(2) > div.max-w-8xl.font-ibm-sans.inner-container.relative > div.mt-12:nth-of-type(6) > div.bg-lightShade.py-\[18px\].px-2.mt-2:nth-of-type(9)`
      );

      if (!panel) return 0;

      const count = (panel.innerText.match(/تفاصيل التوصية/g) || []).length;
      return count;
    } catch (e) {
      console.warn("[DU Detail] تعذر فحص التوصيات:", e);
      return 0;
    }
  }

  // 3. التنفيذ والاستخراج المتكامل
  async function executeFullWorkflow() {
    const orderId = getOrderIdFromUrl();

    try {
      await fastNavigateToReview();

      const listElement = await waitForList(12000);
      listElement.classList.add("du-highlight-green");

      const extractedValues = [];

      if (listElement.tagName.toLowerCase() === "select") {
        const options = [...listElement.options].filter(o => o.value && o.value.trim() !== "");
        options.forEach(opt => {
          const txt = opt.text.trim();
          if (txt && !extractedValues.includes(txt)) extractedValues.push(txt);
        });
      } else {
        const subItems = listElement.querySelectorAll("li, tr, div[role='option'], .option, span, p");
        if (subItems.length > 0) {
          subItems.forEach(item => {
            const val = item.innerText.trim();
            if (val && !extractedValues.includes(val)) {
              extractedValues.push(val);
              item.classList.add("du-highlight-green");
              const badge = document.createElement("span");
              badge.className = "du-badge-check";
              badge.textContent = "✓";
              item.prepend(badge);
            }
          });
        } else {
          const directVal = listElement.value || listElement.innerText.trim();
          if (directVal) {
            extractedValues.push(directVal);
            const badge = document.createElement("span");
            badge.className = "du-badge-check";
            badge.textContent = "✓";
            listElement.parentNode.insertBefore(badge, listElement.nextSibling);
          }
        }
      }

      if (extractedValues.length === 0) {
        throw new Error("القائمة لا تحتوي على صكوك/عقارات");
      }

      // فحص التعليقات والتوصيات
      const commentsCount = await countRecommendations();

      // إرسال النجاح وقيمة التعليقات المستخرجة
      chrome.runtime.sendMessage({
        action: "DATA_EXTRACTED_SUCCESS",
        orderId: orderId,
        deedNumbers: extractedValues,
        commentsCount: commentsCount
      });

    } catch (err) {
      chrome.runtime.sendMessage({
        action: "EXTRACTION_FAILED",
        orderId: orderId,
        reason: err.message
      });
    }
  }

  if (document.readyState === "complete") {
    setTimeout(executeFullWorkflow, 150);
  } else {
    window.addEventListener("load", () => setTimeout(executeFullWorkflow, 150));
  }
})();




// ===================================================
// DU Crawler - Multi-Tab Worker Pool & Watchdog
// ===================================================

let maxConcurrent = 2;
const activeSlots = new Map();
const internalQueue = [];
let isProcessingQueue = false;

function pumpQueue() {
  if (!isProcessingQueue) return;

  while (activeSlots.size < maxConcurrent && internalQueue.length > 0) {
    const job = internalQueue.shift();
    openOrderTab(job);
  }
}

function openOrderTab(job) {
  const { orderId, url, resolve } = job;

  chrome.tabs.create({ url: url, active: false }, (newTab) => {
    if (chrome.runtime.lastError || !newTab) {
      resolve({ status: "FAILED", orderId, reason: "تعذر فتح التبويب" });
      pumpQueue();
      return;
    }

    const timer = setTimeout(() => {
      cleanupTab(newTab.id, {
        status: "TIMEOUT",
        orderId: orderId,
        reason: "انتهت مهلة استجابة الصفحة (25 ثانية)"
      });
    }, 25000);

    activeSlots.set(newTab.id, {
      orderId: orderId,
      watchdogTimer: timer,
      resolve: resolve
    });
  });
}

function cleanupTab(tabId, resultPayload) {
  const slot = activeSlots.get(tabId);
  if (!slot) return;

  clearTimeout(slot.watchdogTimer);
  activeSlots.delete(tabId);

  chrome.tabs.remove(tabId, () => {
    if (chrome.runtime.lastError) { /* ignore */ }
  });

  if (slot.resolve) {
    slot.resolve(resultPayload);
  }

  pumpQueue();
}

chrome.runtime.onMessage.addListener((message, sender, sendResponse) => {

  if (message.action === "PROCESS_ORDER_CONCURRENT") {
    isProcessingQueue = true;
    maxConcurrent = message.concurrency || 2;

    const jobPromise = new Promise((resolve) => {
      internalQueue.push({
        orderId: message.orderId,
        url: message.url,
        resolve: resolve
      });
      pumpQueue();
    });

    jobPromise.then((res) => {
      sendResponse(res);
    });

    return true;
  }

  if (message.action === "DATA_EXTRACTED_SUCCESS") {
    if (sender.tab && activeSlots.has(sender.tab.id)) {
      cleanupTab(sender.tab.id, {
        status: "SUCCESS",
        orderId: message.orderId,
        deedNumbers: message.deedNumbers || [],
        commentsCount: typeof message.commentsCount === "number" ? message.commentsCount : 0
      });
    }
  }

  if (message.action === "EXTRACTION_FAILED") {
    if (sender.tab && activeSlots.has(sender.tab.id)) {
      cleanupTab(sender.tab.id, {
        status: "FAILED",
        orderId: message.orderId,
        reason: message.reason || "فشل الاستخراج"
      });
    }
  }

  if (message.action === "FORCE_STOP") {
    isProcessingQueue = false;
    internalQueue.length = 0;

    for (const [tabId, slot] of activeSlots.entries()) {
      clearTimeout(slot.watchdogTimer);
      chrome.tabs.remove(tabId, () => {
        if (chrome.runtime.lastError) { /* ignore */ }
      });
      if (slot.resolve) slot.resolve({ status: "STOPPED", orderId: slot.orderId });
    }
    activeSlots.clear();
    sendResponse({ status: "ALL_STOPPED" });
    return true;
  }
});

chrome.tabs.onRemoved.addListener((closedTabId) => {
  if (activeSlots.has(closedTabId)) {
    const slot = activeSlots.get(closedTabId);
    clearTimeout(slot.watchdogTimer);
    activeSlots.delete(closedTabId);
    if (slot.resolve) {
      slot.resolve({ status: "MANUAL_CLOSE", orderId: slot.orderId, reason: "أُغلق التبويب يدوياً" });
    }
    pumpQueue();
  }
});




