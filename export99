(() => {
  "use strict";

  /* ============================================================
   * إعدادات
   * ============================================================ */

  const CONFIG = {
    buttonId: "property-extractor-button",
    containerId: "property-extractor-container",
    menuId: "property-extractor-radial-menu",
    multiDeedHeader: "=== MULTI_DEED_DATA_V1 ==="
  };

  const wait = (ms) => new Promise(resolve => setTimeout(resolve, ms));

  const cleanText = (value) =>
    String(value ?? "")
      .replace(/\u00a0/g, " ")
      .replace(/\s+/g, " ")
      .trim();

  function getFieldValue(el) {
    if (!el) return "";

    const candidates = [
      el.value,
      el.getAttribute("value"),
      el.textContent
    ];

    for (const value of candidates) {
      const cleaned = cleanText(value);

      if (
        cleaned !== "" &&
        cleaned !== "undefined" &&
        cleaned !== "null"
      ) {
        return cleaned;
      }
    }

    return "";
  }

  /* ============================================================
   * ترتيب الحقول
   * ============================================================ */

  const FINAL_FIELD_ORDER = [
    "رقم الطلب",
    "رقم صك وزارة العدل",
    "تاريخ الصك",

    "رقم السجل العقاري",
    "رقم القطعة بالمخطط",
    "رقم المخطط",
    "رقم البلوك",

    "اسم الحي",
    "اسم المدينة",

    "الحدود حسب طبقة الأراضي",
    "الحدود حسب الصك",
    "وصف العقار",

    "اتجاه 1",
    "الحدود حسب الصك 1",
    "الحدود حسب الطبيعة 1",
    "الأبعاد حسب الصك (طول الضلع) 1",
    "الأبعاد حسب الصك (المجموع) 1",
    "الأبعاد حسب طبقة الأراضي (طول الضلع) 1",
    "الأبعاد حسب طبقة الأراضي (المجموع) 1",

    "اتجاه 2",
    "الحدود حسب الصك 2",
    "الحدود حسب الطبيعة 2",
    "الأبعاد حسب الصك (طول الضلع) 2",
    "الأبعاد حسب الصك (المجموع) 2",
    "الأبعاد حسب طبقة الأراضي (طول الضلع) 2",
    "الأبعاد حسب طبقة الأراضي (المجموع) 2",

    "اتجاه 3",
    "الحدود حسب الصك 3",
    "الحدود حسب الطبيعة 3",
    "الأبعاد حسب الصك (طول الضلع) 3",
    "الأبعاد حسب الصك (المجموع) 3",
    "الأبعاد حسب طبقة الأراضي (طول الضلع) 3",
    "الأبعاد حسب طبقة الأراضي (المجموع) 3",

    "اتجاه 4",
    "الحدود حسب الصك 4",
    "الحدود حسب الطبيعة 4",
    "الأبعاد حسب الصك (طول الضلع) 4",
    "الأبعاد حسب الصك (المجموع) 4",
    "الأبعاد حسب طبقة الأراضي (طول الضلع) 4",
    "الأبعاد حسب طبقة الأراضي (المجموع) 4",

    "النطاق الجغرافي لإسقاط مركاتور المستعرض العالمي"
  ];

  /* ============================================================
   * البحث عن الحقول وقراءتها
   * ============================================================ */

  function findByPlaceholder(text, excludeName = null) {
    const elements = document.querySelectorAll("input, textarea");

    for (const el of elements) {
      const placeholder = cleanText(
        el.getAttribute("placeholder") || el.placeholder || ""
      );

      if (
        (placeholder === text || placeholder.includes(text)) &&
        (!excludeName || !(el.name || "").includes(excludeName))
      ) {
        return el;
      }
    }

    return null;
  }

  function getInputValue(el) {
    if (!el) return "";

    const directValue = el.value;
    if (
      directValue !== undefined &&
      directValue !== null &&
      String(directValue).trim() !== ""
    ) {
      return cleanText(directValue);
    }

    const fiberKey = Object.keys(el).find(
      key => key.startsWith("__reactFiber$")
    );

    if (fiberKey) {
      let fiber = el[fiberKey];

      for (let i = 0; i < 15 && fiber; i++) {
        const props = fiber.memoizedProps;

        if (props?.control) {
          const control = props.control;

          const formValues =
            control?._formValues ||
            control?._defaultValues;

          if (formValues) {
            const name = el.name;

            const parts = name.split(".");
            let value = formValues;

            for (const part of parts) {
              if (value == null) break;
              value = value[part];
            }

            if (
              value !== undefined &&
              value !== null &&
              String(value).trim() !== ""
            ) {
              return cleanText(value);
            }
          }
        }

        fiber = fiber.return;
      }
    }

    const attrValue = el.getAttribute("value");

    if (
      attrValue !== undefined &&
      attrValue !== null &&
      String(attrValue).trim() !== ""
    ) {
      return cleanText(attrValue);
    }

    return "";
  }

  function getValueByPlaceholder(placeholder, excludeName = null) {
    const el = findByPlaceholder(placeholder, excludeName);

    if (!el) {
      return {
        value: "",
        element: null
      };
    }

    const value = getInputValue(el);

    return {
      value,
      element: el
    };
  }

  /* ============================================================
   * مساعدات إدخال القيم وتحديث React State
   * ============================================================ */

  function setElementValue(el, value) {
    if (!el) return false;

    const proto = el.tagName === "TEXTAREA"
      ? HTMLTextAreaElement.prototype
      : HTMLInputElement.prototype;

    const setter = Object.getOwnPropertyDescriptor(proto, "value")?.set;
    if (!setter) return false;

    setter.call(el, String(value ?? ""));

    el.dispatchEvent(new Event("input", { bubbles: true }));
    el.dispatchEvent(new Event("change", { bubbles: true }));
    return true;
  }

  async function setSelectValue(selectInput, targetValue) {
    if (!selectInput || !targetValue) return false;

    selectInput.focus();

    const setter = Object.getOwnPropertyDescriptor(
      HTMLInputElement.prototype,
      "value"
    )?.set;

    if (setter) {
      setter.call(selectInput, String(targetValue));
      selectInput.dispatchEvent(new Event("input", { bubbles: true }));
    }

    await wait(200);

    selectInput.dispatchEvent(new KeyboardEvent("keydown", {
      key: "ArrowDown",
      code: "ArrowDown",
      bubbles: true
    }));

    selectInput.dispatchEvent(new KeyboardEvent("keydown", {
      key: "Enter",
      code: "Enter",
      keyCode: 13,
      which: 13,
      bubbles: true
    }));

    selectInput.dispatchEvent(new KeyboardEvent("keyup", {
      key: "Enter",
      code: "Enter",
      keyCode: 13,
      which: 13,
      bubbles: true
    }));

    await wait(100);
    return true;
  }

  /* ============================================================
   * React Select القراءة
   * ============================================================ */

  function getReactSelectValue(input) {
    if (!input) {
      return {
        value: "",
        element: null
      };
    }

    let container =
      input.closest('[class*="control"]') ||
      input.parentElement;

    let value = "";

    for (let i = 0; i < 6 && container; i++) {
      const singleValue =
        container.querySelector('[class*="singleValue"]') ||
        container.querySelector('[class*="single-value"]');

      if (singleValue) {
        value = cleanText(singleValue.textContent);
        if (value) break;
      }

      container = container.parentElement;
    }

    return {
      value,
      element: input
    };
  }

  /* ============================================================
   * رقم الطلب وبيانات الصك والمالك
   * ============================================================ */

  function extractApplicationNumber() {
    const re = /\bDU\d+\b/i;
    const elements = document.querySelectorAll("span, p, div, td, h1, h2, h3");

    for (const el of elements) {
      const text = cleanText(el.textContent);
      if (text.length > 200) continue;
      const match = text.match(re);
      if (match) return match[0].toUpperCase();
    }

    return "";
  }

  function extractDeedData() {
    const result = {
      "رقم صك وزارة العدل": "",
      "تاريخ الصك": ""
    };

    const deedCell = document.querySelector(
      'table.borderTable-new tbody.overflow-y-auto tr.cursor-pointer td.p-3.font-normal.text-\\[14px\\].leading-5.text-center'
    );

    if (deedCell) {
      const value = cleanText(deedCell.textContent);
      if (value) result["رقم صك وزارة العدل"] = value;
    }

    if (!result["رقم صك وزارة العدل"]) {
      const xpath =
        '/html[1]/body[1]/div[1]/div[1]/div[2]/div[1]/div[6]/div[7]/div[2]/table[1]/tbody[1]/tr[1]/td[1]';

      const xpathResult = document.evaluate(
        xpath,
        document,
        null,
        XPathResult.FIRST_ORDERED_NODE_TYPE,
        null
      );

      const cell = xpathResult.singleNodeValue;
      if (cell) {
        const value = cleanText(cell.textContent);
        if (value) result["رقم صك وزارة العدل"] = value;
      }
    }

    const dateCells = document.querySelectorAll("td");
    for (const td of dateCells) {
      const value = cleanText(td.textContent);
      if (/^\d{4}-\d{2}-\d{2}$/.test(value)) {
        result["تاريخ الصك"] = value;
        break;
      }
    }

    return result;
  }

  function extractOwnerData() {
    const result = {};
    const identityRegex = /^\d{10}$/;
    const identities = [];
    const names = [];

    const cells = document.querySelectorAll("td, p, span");
    for (const el of cells) {
      const text = cleanText(el.textContent);
      if (identityRegex.test(text) && !identities.includes(text)) {
        identities.push(text);
      }
    }

    const candidates = document.querySelectorAll(
      "td p.font-bold, td p[class*='font-bold'], td p[class*='text-[#4A6BA3]']"
    );

    for (const el of candidates) {
      const text = cleanText(el.textContent);
      if (
        text &&
        text.length > 2 &&
        /[\u0600-\u06FF]/.test(text) &&
        !/^\d+$/.test(text) &&
        !text.includes("المالك") &&
        !names.includes(text)
      ) {
        names.push(text);
      }
    }

    const maxOwners = Math.max(names.length, identities.length);
    for (let i = 0; i < maxOwners; i++) {
      const number = i + 1;
      result[`اسم المالك ${number}`] = names[i] || "";
      result[`رقم الهوية ${number}`] = identities[i] || "";
    }

    return result;
  }

  /* ============================================================
   * البيانات الأساسية
   * ============================================================ */

  function extractBasicData() {
    const result = {};

    const mappings = [
      ["رقم السجل العقاري", "رقم السجل العقاري"],
      ["رقم القطعة بالمخطط", "رقم القطعة بالمخطط"],
      ["رقم المخطط", "رقم المخطط"],
      ["رقم البلوك", "رقم البلوك"],
      [
        "النطاق الجغرافي لإسقاط مركاتور المستعرض العالمي",
        "النطاق الجغرافي لإسقاط مركاتور المستعرض العالمي"
      ]
    ];

    for (const [field, placeholder] of mappings) {
      const r = getValueByPlaceholder(placeholder);
      result[field] = r.value;
    }

    const landBoundary = getValueByPlaceholder("الحدود حسب طبقة الأراضي");
    result["الحدود حسب طبقة الأراضي"] = landBoundary.value;

    const deedBoundary = getValueByPlaceholder(
      "الحدود حسب الصك",
      "directions."
    );
    result["الحدود حسب الصك"] = deedBoundary.value;

    const description =
      document.querySelector('textarea[name="description"]') ||
      document.querySelector('textarea[placeholder="وصف العقار"]');

    result["وصف العقار"] = description ? getInputValue(description) : "";

    const region = getSelectByName("region");
    result["المنطقة"] = region.value;

    const city = getSelectByName("city");
    result["اسم المدينة"] = city.value;

    const district = getSelectByName("district");
    result["اسم الحي"] = district.value;

    return result;
  }

  function getSelectByName(name) {
    const input = document.querySelector(`input[name="${CSS.escape(name)}"]`);
    if (!input) return { value: "", element: null };
    return getReactSelectValue(input);
  }

  /* ============================================================
   * الاتجاهات
   * ============================================================ */

  const directionFields = [
    ["deedBoundry", "الحدود حسب الصك"],
    ["asBuiltBoundry", "الحدود حسب الطبيعة"],
    ["deedDimentionLength", "الأبعاد حسب الصك (طول الضلع)"],
    ["deedDimentionTotal", "الأبعاد حسب الصك (المجموع)"],
    ["asBuiltDimentionLength", "الأبعاد حسب طبقة الأراضي (طول الضلع)"],
    ["asBuiltDimentionTotal", "الأبعاد حسب طبقة الأراضي (المجموع)"]
  ];

  function extractDirections() {
    const result = {};

    for (let i = 0; i < 4; i++) {
      const number = i + 1;
      const hidden = document.querySelector(
        `input[name="directions.${i}.direction"]`
      );

      let directionValue = "";

      if (hidden) {
        const parent = hidden.closest("div") || hidden.parentElement;
        const selectValue = parent?.querySelector('[class*="singleValue"]');
        directionValue = cleanText(selectValue?.textContent || "");

        if (!directionValue) {
          const numeric = getInputValue(hidden);
          const directionMap = {
            "1": "الشمالية",
            "2": "الجنوبية",
            "3": "الشرقية",
            "4": "الغربية"
          };
          directionValue = directionMap[numeric] || numeric;
        }
      }

      result[`اتجاه ${number}`] = directionValue;

      for (const [namePart, label] of directionFields) {
        const input = document.querySelector(
          `input[name="directions.${i}.${namePart}"]`
        );
        const key = `${label} ${number}`;

        if (input) {
          let value = getInputValue(input);

          if (!value || value === "0") {
            const fiberKey = Object.keys(input).find(k =>
              k.startsWith("__reactFiber$")
            );
            let fiber = fiberKey ? input[fiberKey] : null;

            for (let level = 0; level < 10 && fiber; level++) {
              const props = fiber.memoizedProps;
              if (props?.control?._formValues) {
                const formValues = props.control._formValues;
                const direction = formValues?.directions?.[i];

                if (
                  direction &&
                  direction[namePart] !== undefined &&
                  direction[namePart] !== null &&
                  String(direction[namePart]).trim() !== ""
                ) {
                  value = cleanText(direction[namePart]);
                }
                break;
              }
              fiber = fiber.return;
            }
          }
          result[key] = value;
        } else {
          result[key] = "";
        }
      }
    }

    return result;
  }

  /* ============================================================
   * الإحداثيات
   * ============================================================ */

  function extractCoordinates() {
    const result = {};
    const groups = {};

    const inputs = document.querySelectorAll('input[name*="coordinates."]');

    inputs.forEach(input => {
      const name = input.name || "";
      const match = name.match(
        /coordinates\.(\d+)\.(northCordinate|eastCordinate|northCoordinate|eastCoordinate|north|east)/i
      );

      if (!match) return;

      const index = Number(match[1]);
      let type = match[2].toLowerCase();

      if (type.includes("north")) {
        type = "north";
      } else if (type.includes("east")) {
        type = "east";
      }

      if (!groups[index]) {
        groups[index] = {};
      }

      groups[index][type] = {
        value: getInputValue(input),
        element: input
      };
    });

    const indices = Object.keys(groups)
      .map(Number)
      .sort((a, b) => a - b);

    indices.forEach((index, position) => {
      const number = position + 1;
      const group = groups[index];

      result[`الإحداثي الشمالي (N) ${number}`] = group.north?.value || "";
      result[`الإحداثي الشرقي (E) ${number}`] = group.east?.value || "";
    });

    return result;
  }

  /* ============================================================
   * وظائف الصك المتعدد (Multi-Deed)
   * ============================================================ */

  function extractMultiDeedData() {
    const data = {
      basic: {},
      directions: []
    };

    const basicMappings = [
      ["lot", "رقم القطعة بالمخطط"],
      ["plan", "رقم المخطط"],
      ["block", "رقم البلوك"],
      ["zone", "النطاق الجغرافي لإسقاط مركاتور المستعرض العالمي"]
    ];

    for (const [key, placeholder] of basicMappings) {
      data.basic[key] = getValueByPlaceholder(placeholder).value;
    }

    const deedBoundary = getValueByPlaceholder("الحدود حسب الصك", "directions.");
    data.basic["deedBoundary"] = deedBoundary.value;

    for (let i = 0; i < 4; i++) {
      let directionVal = "";
      const hidden = document.querySelector(`input[name="directions.${i}.direction"]`);
      if (hidden) {
        const parent = hidden.closest("div") || hidden.parentElement;
        const selectValue = parent?.querySelector('[class*="singleValue"]');
        directionVal = cleanText(selectValue?.textContent || "");
        if (!directionVal) directionVal = getInputValue(hidden);
      }

      const deedBoundryInput = document.querySelector(`input[name="directions.${i}.deedBoundry"]`);
      const deedBoundryVal = deedBoundryInput ? getInputValue(deedBoundryInput) : "";

      const deedLengthInput = document.querySelector(`input[name="directions.${i}.deedDimentionLength"]`);
      const deedLengthVal = deedLengthInput ? getInputValue(deedLengthInput) : "";

      const deedTotalInput = document.querySelector(`input[name="directions.${i}.deedDimentionTotal"]`);
      const deedTotalVal = deedTotalInput ? getInputValue(deedTotalInput) : "";

      data.directions.push({
        index: i,
        direction: directionVal,
        deedBoundry: deedBoundryVal,
        deedDimentionLength: deedLengthVal,
        deedDimentionTotal: deedTotalVal
      });
    }

    return data;
  }

  async function copyMultiDeedToClipboard() {
    const data = extractMultiDeedData();
    const payload = `${CONFIG.multiDeedHeader}\n${JSON.stringify(data, null, 2)}`;

    try {
      await navigator.clipboard.writeText(payload);
    } catch {
      const textarea = document.createElement("textarea");
      textarea.value = payload;
      textarea.style.position = "fixed";
      textarea.style.left = "-9999px";
      document.body.appendChild(textarea);
      textarea.select();
      document.execCommand("copy");
      textarea.remove();
    }

    return data;
  }

  async function fillMultiDeedFromClipboard() {
    let text = "";
    try {
      text = await navigator.clipboard.readText();
    } catch (e) {
      throw new Error("تعذرت قراءة الحافظة، يرجى منح الإذن.");
    }

    if (!text || !text.includes(CONFIG.multiDeedHeader)) {
      throw new Error("النص الموجود في الحافظة ليس بيانات صك متعدد صالحة.");
    }

    const jsonPart = text.replace(CONFIG.multiDeedHeader, "").trim();
    let data;
    try {
      data = JSON.parse(jsonPart);
    } catch {
      throw new Error("تنسيق بيانات الصك المتعدد غير صالح.");
    }

    if (!data.basic || !Array.isArray(data.directions)) {
      throw new Error("هيكل بيانات الصك المتعدد غير مطابق.");
    }

    const basicMappings = [
      ["lot", "رقم القطعة بالمخطط"],
      ["plan", "رقم المخطط"],
      ["block", "رقم البلوك"],
      ["zone", "النطاق الجغرافي لإسقاط مركاتور المستعرض العالمي"]
    ];

    for (const [key, placeholder] of basicMappings) {
      const el = findByPlaceholder(placeholder);
      if (el && data.basic[key] !== undefined) {
        setElementValue(el, data.basic[key]);
      }
    }

    const deedBoundaryEl = findByPlaceholder("الحدود حسب الصك", "directions.");
    if (deedBoundaryEl && data.basic.deedBoundary !== undefined) {
      setElementValue(deedBoundaryEl, data.basic.deedBoundary);
    }

    const directionCodeMap = {
      "الشمالية": "1",
      "الجنوبية": "2",
      "الشرقية": "3",
      "الغربية": "4"
    };

    for (let i = 0; i < data.directions.length; i++) {
      const dirData = data.directions[i];

      if (dirData.direction) {
        const rawCode =
          directionCodeMap[cleanText(dirData.direction)] ||
          cleanText(dirData.direction);

        const selectInput = document.getElementById(`react-select-${5 + i}-input`);
        if (selectInput) {
          await setSelectValue(selectInput, rawCode);
        }
      }

      const deedBoundryInput = document.querySelector(`input[name="directions.${i}.deedBoundry"]`);
      if (deedBoundryInput && dirData.deedBoundry !== undefined) {
        setElementValue(deedBoundryInput, dirData.deedBoundry);
      }

      const deedLengthInput = document.querySelector(`input[name="directions.${i}.deedDimentionLength"]`);
      if (deedLengthInput && dirData.deedDimentionLength !== undefined) {
        setElementValue(deedLengthInput, dirData.deedDimentionLength);
      }

      const deedTotalInput = document.querySelector(`input[name="directions.${i}.deedDimentionTotal"]`);
      if (deedTotalInput && dirData.deedDimentionTotal !== undefined) {
        setElementValue(deedTotalInput, dirData.deedDimentionTotal);
      }
    }

    return true;
  }

  /* ============================================================
   * قراءة وتعبئة بيانات العقار العادية (Excel/Auto)
   * ============================================================ */

  async function readPropertyClipboard() {
    const text = await navigator.clipboard.readText();

    if (!text || !text.trim()) {
      throw new Error("الحافظة فارغة أو لا تحتوي على نص.");
    }

    const lines = text
      .replace(/\r/g, "")
      .split("\n")
      .map(line => line.trim())
      .filter(Boolean);

    function getValue(label) {
      const line = lines.find(line =>
        new RegExp("^" + label + "\\s+", "i").test(line)
      );

      if (!line) return "";

      return line
        .replace(new RegExp("^" + label + "\\s*", "i"), "")
        .trim()
        .split(/\s+/)[0];
    }

    const areaText = getValue("AREA");
    const totalLengthText = getValue("TOTAL\\s+LENGTH");

    const coordinates = [];
    const directions = [];

    let section = "";

    for (const line of lines) {
      if (/^COORDINATES\b/i.test(line)) {
        section = "coordinates";
        continue;
      }

      if (/^DIRECTION SUMMARY\b/i.test(line)) {
        section = "directions";
        continue;
      }

      if (section === "coordinates") {
        const match = line.match(
          /^(\d+)\s+(-?\d+(?:\.\d+)?)\s+(-?\d+(?:\.\d+)?)$/
        );

        if (match) {
          coordinates.push({
            vertex: Number(match[1]),
            north: match[2],
            east: match[3]
          });
        }
      }

      if (section === "directions") {
        const match = line.match(
          /^(NORTH|SOUTH|EAST|WEST)\s+(-?\d+(?:\.\d+)?)/i
        );

        if (match) {
          directions.push({
            name: match[1].toUpperCase(),
            length: match[2]
          });
        }
      }
    }

    if (!coordinates.length) {
      throw new Error("لم يتم العثور على الإحداثيات في نص الحافظة.");
    }

    if (!directions.length) {
      throw new Error("لم يتم العثور على ملخص الاتجاهات في نص الحافظة.");
    }

    return {
      lot: getValue("LOT"),
      plan: getValue("PLAN"),
      block: getValue("BLOCK"),
      zone: getValue("ZONE"),
      area: areaText.match(/-?\d+(?:\.\d+)?/)?.[0] || "",
      totalLength: totalLengthText.match(/-?\d+(?:\.\d+)?/)?.[0] || "",
      coordinates,
      directions
    };
  }

  async function fillPropertyData() {
    const PROPERTY_FILL_DATA = await readPropertyClipboard();

    function fillByPlaceholder(placeholder, value) {
      const el = findByPlaceholder(placeholder);
      if (!el) return false;
      return setElementValue(el, value);
    }

    // 1. البيانات الأساسية
    fillByPlaceholder("رقم القطعة بالمخطط", PROPERTY_FILL_DATA.lot);
    fillByPlaceholder("رقم المخطط", PROPERTY_FILL_DATA.plan);
    fillByPlaceholder("رقم البلوك", PROPERTY_FILL_DATA.block);
    fillByPlaceholder(
      "النطاق الجغرافي لإسقاط مركاتور المستعرض العالمي",
      PROPERTY_FILL_DATA.zone
    );

    // 2. المساحة
    const areaField = document.querySelector(
      'div.transition-all.flex-row-reverse.duration-700 > div.w-full.p-8.transition-all.duration-700:nth-of-type(2) > div.max-w-8xl.font-ibm-sans.inner-container.relative > div.mt-12:nth-of-type(6) > div.container.mx-auto.px-2.mt-12:nth-of-type(6) > div:nth-of-type(2) > div.flex.flex-col.w-full.border.bottom-2.border-\\[\\#dce3e6\\] > div.rounded-md.false > div.p-3 > div.space-y-10.mx-auto > div:nth-of-type(2) > div.grid.grid-cols-1.md\\:grid-cols-2.gap-6 > div > input'
    );

    if (areaField && PROPERTY_FILL_DATA.area) {
      setElementValue(areaField, PROPERTY_FILL_DATA.area);
    }

    // 3. إضافة صفوف الإحداثيات المطلوبة فقط
    for (let attempt = 0; attempt < 4; attempt++) {
      const count = document.querySelectorAll(
        'input[name^="coordinates."][name$=".northCordinate"]'
      ).length;

      if (count >= PROPERTY_FILL_DATA.coordinates.length) break;

      const addButton = [...document.querySelectorAll("button")].find(el =>
        el.innerText.includes("إضافة المزيد من الإحداثيات")
      );

      if (!addButton) break;

      addButton.click();
      await wait(100);
    }

    // 4. تعبئة الإحداثيات
    for (let i = 0; i < PROPERTY_FILL_DATA.coordinates.length; i++) {
      const point = PROPERTY_FILL_DATA.coordinates[i];
      const north = document.querySelector(`input[name="coordinates.${i}.northCordinate"]`);
      const east = document.querySelector(`input[name="coordinates.${i}.eastCordinate"]`);

      if (north) setElementValue(north, point.north);
      if (east) setElementValue(east, point.east);
    }

    // 5. الاتجاهات
    let clipboardText = "";
    try {
      clipboardText = await navigator.clipboard.readText();
    } catch {}

    const directionMap = {
      NORTH: "1",
      EAST: "2",
      SOUTH: "3",
      WEST: "4"
    };

    const directionRows = [];
    const summaryMatch = clipboardText.match(/DIRECTION SUMMARY([\s\S]*?)(?:$)/i);

    if (summaryMatch) {
      const lines = summaryMatch[1].split(/\r?\n/);
      for (const line of lines) {
        const match = line.trim().match(
          /^(NORTH|EAST|SOUTH|WEST)\s+([\d,]+(?:\.\d+)?)\s*m?\s*$/i
        );

        if (match) {
          directionRows.push({
            name: match[1].toUpperCase(),
            number: directionMap[match[1].toUpperCase()],
            length: match[2].replace(/,/g, "")
          });
        }
      }
    }

    for (let i = 0; i < directionRows.length; i++) {
      const d = directionRows[i];
      const selectInput = document.getElementById(`react-select-${5 + i}-input`);
      const lengthField = document.querySelector(`input[name="directions.${i}.asBuiltDimentionLength"]`);
      const totalField = document.querySelector(`input[name="directions.${i}.asBuiltDimentionTotal"]`);

      if (selectInput) {
        await setSelectValue(selectInput, d.number);
      }

      if (lengthField) setElementValue(lengthField, d.length);
      if (totalField) setElementValue(totalField, d.length);
    }

    return true;
  }

  /* ============================================================
   * استخراج كل البيانات للتقرير
   * ============================================================ */

  function extractVisibleExtraData() {
    const result = {};
    const paragraphs = [...document.querySelectorAll("p")];

    for (const p of paragraphs) {
      const text = cleanText(p.textContent);

      if (text === "اسم المدينة") {
        const parent = p.parentElement;
        const value = cleanText(parent?.textContent?.replace("اسم المدينة", ""));
        if (value && value !== "اسم المدينة") result.__visibleCity = value;
      }

      if (text === "اسم الحي") {
        const parent = p.parentElement;
        const value = cleanText(parent?.textContent?.replace("اسم الحي", ""));
        if (value && value !== "اسم الحي") result.__visibleDistrict = value;
      }
    }

    return result;
  }

  async function extractAllData() {
    await wait(300);

    const data = {};
    data["رقم الطلب"] = extractApplicationNumber();

    Object.assign(data, extractBasicData());
    Object.assign(data, extractDeedData());
    Object.assign(data, extractOwnerData());
    Object.assign(data, extractDirections());
    Object.assign(data, extractCoordinates());

    const extra = extractVisibleExtraData();
    if ((!data["اسم المدينة"] || data["اسم المدينة"] === "N/A") && extra.__visibleCity) {
      data["اسم المدينة"] = extra.__visibleCity;
    }

    if ((!data["اسم الحي"] || data["اسم الحي"] === "N/A") && extra.__visibleDistrict) {
      data["اسم الحي"] = extra.__visibleDistrict;
    }

    const finalData = {};
    for (const field of FINAL_FIELD_ORDER) {
      finalData[field] = cleanText(data[field]) || "N/A";
    }

    const ownerNumbers = new Set();
    Object.keys(data).forEach(key => {
      const match = key.match(/^(اسم المالك|رقم الهوية) (\d+)$/);
      if (match) ownerNumbers.add(Number(match[2]));
    });

    [...ownerNumbers]
      .sort((a, b) => a - b)
      .forEach(number => {
        finalData[`اسم المالك ${number}`] = cleanText(data[`اسم المالك ${number}`]) || "N/A";
        finalData[`رقم الهوية ${number}`] = cleanText(data[`رقم الهوية ${number}`]) || "N/A";
      });

    const coordinateKeys = Object.keys(data).filter(key =>
      /^الإحداثي (الشمالي \(N\)|الشرقي \(E\)) \d+$/.test(key)
    );

    const coordinateNumbers = new Set();
    for (const key of coordinateKeys) {
      const match = key.match(/(\d+)$/);
      if (match) coordinateNumbers.add(Number(match[1]));
    }

    [...coordinateNumbers]
      .sort((a, b) => a - b)
      .forEach(number => {
        finalData[`الإحداثي الشمالي (N) ${number}`] = cleanText(data[`الإحداثي الشمالي (N) ${number}`]) || "N/A";
        finalData[`الإحداثي الشرقي (E) ${number}`] = cleanText(data[`الإحداثي الشرقي (E) ${number}`]) || "N/A";
      });

    return finalData;
  }

  async function copyToExcel(data) {
    const rows = [["الحقل", "القيمة"]];

    for (const [field, value] of Object.entries(data)) {
      if (Array.isArray(value)) {
        for (const item of value) {
          rows.push([String(field || ""), String(item || "")]);
        }
      } else {
        rows.push([String(field || ""), String(value || "")]);
      }
    }

    const text = rows
      .map(row =>
        row
          .map(value =>
            String(value)
              .replace(/\t/g, " ")
              .replace(/\r?\n/g, " ")
          )
          .join("\t")
      )
      .join("\r\n");

    try {
      await navigator.clipboard.writeText(text);
    } catch (e) {
      const textarea = document.createElement("textarea");
      textarea.value = text;
      textarea.style.position = "fixed";
      textarea.style.left = "-9999px";
      document.body.appendChild(textarea);
      textarea.select();
      document.execCommand("copy");
      textarea.remove();
    }

    return text;
  }

