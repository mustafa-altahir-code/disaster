  /* ============================================================
   * الزر العائم والقائمة المنبثقة (ثابت، بدون تداخل، محمي الحواف)
   * ============================================================ */

  function createButton() {
    if (!isExtractionPage()) return;
    if (document.getElementById(CONFIG.containerId)) return;

    // 1. تثبيت الحاوية دائماً في زاوية آمنة (يسار أسفل) بعيداً عن localStorage
    const container = document.createElement("div");
    container.id = CONFIG.containerId;

    Object.assign(container.style, {
      position: "fixed",
      left: "30px",
      bottom: "30px",
      zIndex: "2147483647",
      width: "50px",
      height: "50px",
      userSelect: "none"
    });

    // 2. درع تفاعلي يغطي ربع الدائرة بالكامل لمنع اختفاء القائمة أثناء تحريك الماوس
    const hitArea = document.createElement("div");
    Object.assign(hitArea.style, {
      position: "absolute",
      left: "-10px",
      bottom: "-10px",
      width: "170px",
      height: "170px",
      borderRadius: "0 170px 0 0",
      pointerEvents: "none",
      zIndex: "1"
    });

    // 3. مساحة القائمة
    const radialMenu = document.createElement("div");
    radialMenu.id = CONFIG.menuId;
    Object.assign(radialMenu.style, {
      position: "absolute",
      left: "0",
      top: "0",
      width: "100%",
      height: "100%",
      pointerEvents: "none",
      transition: "opacity 0.2s ease",
      opacity: "0",
      zIndex: "3"
    });

    // 4. بطاقة التولتيب الموحدة (تظهر في المنتصف أعلى الزر الرئيسي لعدم حجب أي زر)
    const centralTooltip = document.createElement("div");
    Object.assign(centralTooltip.style, {
      position: "absolute",
      bottom: "62px",
      left: "50%",
      transform: "translateX(-50%) translateY(4px)",
      background: "rgba(15, 23, 42, 0.95)",
      color: "#ffffff",
      padding: "5px 12px",
      borderRadius: "8px",
      fontSize: "12px",
      fontWeight: "bold",
      fontFamily: "Arial, sans-serif",
      whiteSpace: "nowrap",
      pointerEvents: "none",
      opacity: "0",
      boxShadow: "0 4px 12px rgba(0,0,0,0.25)",
      transition: "opacity 0.15s ease, transform 0.15s ease",
      zIndex: "20"
    });

    // توزيع الأوامر داخل ربع الدائرة (نحو داخل الشاشة: أعلى ويمين)
    const actions = [
      { id: "EXTRACT_REPORT", icon: "📋", label: "استخراج التقرير", angle: 0 },   // أقصى اليمين أفقي
      { id: "COPY_MULTI_DEED", icon: "📑", label: "نسخ الصك المتعدد", angle: 30 },
      { id: "FILL_PROPERTY", icon: "🏠", label: "تعبئة العقار", angle: 60 },
      { id: "FILL_MULTI_DEED", icon: "🧭", label: "تعبئة الصك المتعدد", angle: 90 } // أقصى الأعلى رأسي
    ];

    const radius = 95; // مسافة تمنع تداخل الأزرار ذات الـ 38px كلياً

    actions.forEach(action => {
      const rad = (action.angle * Math.PI) / 180;
      const x = Math.round(Math.cos(rad) * radius);
      const y = -Math.round(Math.sin(rad) * radius);

      const btn = document.createElement("button");
      btn.textContent = action.icon;
      btn.title = "";

      Object.assign(btn.style, {
        position: "absolute",
        left: "50%",
        top: "50%",
        width: "38px",
        height: "38px",
        borderRadius: "50%",
        border: "1.5px solid #087f5b",
        background: "#ffffff",
        fontSize: "17px",
        display: "flex",
        alignItems: "center",
        justifyContent: "center",
        cursor: "pointer",
        boxShadow: "0 4px 12px rgba(0,0,0,0.18)",
        transform: "translate(-50%, -50%) scale(0.6)",
        transition: "transform 0.22s cubic-bezier(0.34, 1.4, 0.64, 1), background 0.15s ease",
        pointerEvents: "none",
        padding: "0"
      });

      btn.addEventListener("mouseenter", () => {
        btn.style.transform = `translate(calc(-50% + ${x}px), calc(-50% + ${y}px)) scale(1.15)`;
        btn.style.background = "#e6fcf5";
        centralTooltip.textContent = action.label;
        centralTooltip.style.opacity = "1";
        centralTooltip.style.transform = "translateX(-50%) translateY(0)";
      });

      btn.addEventListener("mouseleave", () => {
        btn.style.transform = `translate(calc(-50% + ${x}px), calc(-50% + ${y}px)) scale(1)`;
        btn.style.background = "#ffffff";
        centralTooltip.style.opacity = "0";
        centralTooltip.style.transform = "translateX(-50%) translateY(4px)";
      });

      btn.addEventListener("click", (e) => {
        e.stopPropagation();
        hideMenu();
        executeAction(action.id, mainButton);
      });

      radialMenu.appendChild(btn);
      btn.dataset.x = x;
      btn.dataset.y = y;
    });

    // 5. الزر الرئيسي الدائم
    const mainButton = document.createElement("button");
    mainButton.id = CONFIG.buttonId;
    mainButton.textContent = "📥";
    mainButton.title = "";

    Object.assign(mainButton.style, {
      width: "50px",
      height: "50px",
      borderRadius: "50%",
      border: "0",
      background: "#ffffff",
      color: "#087f5b",
      fontSize: "22px",
      cursor: "pointer",
      boxShadow: "0 4px 14px rgba(0,0,0,0.22)",
      display: "flex",
      alignItems: "center",
      justifyContent: "center",
      position: "relative",
      zIndex: "5",
      transition: "transform 0.18s ease"
    });

    /* ========================================================
     * إدارة الظهور والإخفاء
     * ======================================================== */

    let hideTimer = null;

    function showMenu() {
      clearTimeout(hideTimer);
      radialMenu.style.opacity = "1";
      radialMenu.style.pointerEvents = "auto";
      hitArea.style.pointerEvents = "auto";
      mainButton.style.transform = "scale(1.06)";

      const buttons = radialMenu.querySelectorAll("button");
      buttons.forEach(btn => {
        const x = btn.dataset.x;
        const y = btn.dataset.y;
        btn.style.transform = `translate(calc(-50% + ${x}px), calc(-50% + ${y}px)) scale(1)`;
        btn.style.pointerEvents = "auto";
      });
    }

    function hideMenu() {
      clearTimeout(hideTimer);
      hideTimer = setTimeout(() => {
        radialMenu.style.opacity = "0";
        radialMenu.style.pointerEvents = "none";
        hitArea.style.pointerEvents = "none";
        centralTooltip.style.opacity = "0";
        mainButton.style.transform = "scale(1)";

        const buttons = radialMenu.querySelectorAll("button");
        buttons.forEach(btn => {
          btn.style.transform = "translate(-50%, -50%) scale(0.6)";
          btn.style.pointerEvents = "none";
        });
      }, 350);
    }

    container.addEventListener("mouseenter", showMenu);
    container.addEventListener("mouseleave", hideMenu);

    container.appendChild(hitArea);
    container.appendChild(radialMenu);
    container.appendChild(centralTooltip);
    container.appendChild(mainButton);
    document.body.appendChild(container);
  }
