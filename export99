  async function executeAction(actionType, mainBtn) {
    if (mainBtn.disabled) return;
    mainBtn.disabled = true;
    mainBtn.textContent = "⏳";

    try {
      switch (actionType) {
        case "EXTRACT_REPORT":
          if (isDeedDetailsPage()) {
            const deedData = extractDeedData();
            const ownerData = extractOwnerData();
            const data = {
              "رقم صك وزارة العدل": cleanText(deedData["رقم صك وزارة العدل"] || "") || "N/A",
              "تاريخ الصك": cleanText(deedData["تاريخ الصك"] || "") || "N/A"
            };

            const ownerNumbers = new Set();
            Object.keys(ownerData).forEach(key => {
              const match = key.match(/^(اسم المالك|رقم الهوية) (\d+)$/);
              if (match) ownerNumbers.add(Number(match[2]));
            });

            [...ownerNumbers].sort((a, b) => a - b).forEach(number => {
              data[`اسم المالك ${number}`] = cleanText(ownerData[`اسم المالك ${number}`] || "") || "N/A";
              data[`رقم الهوية ${number}`] = cleanText(ownerData[`رقم الهوية ${number}`] || "") || "N/A";
            });

            await copyToExcel(data);
            showToast("تم استخراج التقرير", "تم نسخ بيانات الصك والمالك إلى الحافظة بصيغة Excel.", true);
          } else if (isPropertyDataPage()) {
            const allData = await extractAllData();
            const data = {};

            for (const [field, value] of Object.entries(allData)) {
              if (
                field === "رقم صك وزارة العدل" ||
                field === "تاريخ الصك" ||
                /^اسم المالك \d+$/.test(field) ||
                /^رقم الهوية \d+$/.test(field)
              ) {
                continue;
              }
              data[field] = value;
            }

            const count = Object.values(data).filter(v => v && v !== "N/A").length;
            if (!count) throw new Error("لم يتم العثور على أي بيانات.");

            await copyToExcel(data);
            showToast("تم استخراج التقرير", `تم نسخ <b>${count}</b> قيمة إلى الحافظة بصيغة Excel.`, true);
          } else {
            throw new Error("هذه الصفحة ليست صفحة استخراج معتمدة.");
          }
          break;

        case "COPY_MULTI_DEED":
          if (!isPropertyDataPage()) {
            throw new Error("يجب فتح صفحة بيانات العقار لنسخ الصك المتعدد.");
          }
          await copyMultiDeedToClipboard();
          showToast("تم نسخ الصك المتعدد", "تم نسخ الـ 21 حقلاً بنجاح إلى الحافظة.", true);
          break;

        case "FILL_PROPERTY":
          if (!isPropertyDataPage()) {
            throw new Error("يجب فتح صفحة بيانات العقار للتعبئة.");
          }
          await fillPropertyData();
          if (document.activeElement instanceof HTMLElement) {
            document.activeElement.blur();
          }
          showToast("تمت التعبئة بنجاح", "تمت تعبئة بيانات العقار والإحداثيات.", true);
          break;

        case "FILL_MULTI_DEED":
          if (!isPropertyDataPage()) {
            throw new Error("يجب فتح صفحة بيانات العقار لتعبئة الصك المتعدد.");
          }
          await fillMultiDeedFromClipboard();
          if (document.activeElement instanceof HTMLElement) {
            document.activeElement.blur();
          }
          showToast("تمت التعبئة بنجاح", "تمت تعبئة حقول الصك المتعدد فقط.", true);
          break;
      }

      mainBtn.textContent = "✅";
      mainBtn.style.color = "#16a34a";
    } catch (err) {
      showToast("فشلت العملية", err.message || "حدث خطأ أثناء التنفيذ.", false);
      mainBtn.textContent = "❌";
      mainBtn.style.color = "#dc2626";
    } finally {
      setTimeout(() => {
        mainBtn.textContent = "📥";
        mainBtn.style.color = "#087f5b";
        mainBtn.disabled = false;
      }, 1500);
    }
  }

