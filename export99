    }

// 3. إضافة صفوف الإحداثيات المطلوبة فقط
    for (let attempt = 0; attempt < 4; attempt++) {
      const count = document.querySelectorAll(
        'input[name^="coordinates."][name$=".northCordinate"]'
      ).length;

      if (count >= PROPERTY_FILL_DATA.coordinates.length) break;

