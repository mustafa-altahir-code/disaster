      const index = Number(match[1]);
      let type = match[2].toLowerCase();

      if (type.includes("north")) {
        type = "north";
      } else if (type.includes("east")) {
        type = "east";
      }

      if (!groups[index]) {
        groups[index] = {};
      }

      groups[index][type] = {
        value: getInputValue(input),
        element: input
      };
    });

    const indices = Object.keys(groups)
      .map(Number)
      .sort((a, b) => a - b);

    indices.forEach((index, position) => {
      const number = position + 1;
      const group = groups[index];

      result[`الإحداثي الشمالي (N) ${number}`] =
        group.north?.value || "";

      result[`الإحداثي الشرقي (E) ${number}`] =
        group.east?.value || "";
    });

    return result;
  }

/* ============================================================
   * قراءة وتحليل بيانات العقار من Clipboard
   * ============================================================ */

  async function readPropertyClipboard() {
    const text = await navigator.clipboard.readText();

    if (!text || !text.trim()) {
      throw new Error("الحافظة فارغة أو لا تحتوي على نص.");
    }

    const lines = text
      .replace(/\r/g, "")
      .split("\n")
      .map(line => line.trim())
      .filter(Boolean);

    function getValue(label) {
      const line = lines.find(line =>
        new RegExp(
          "^" + label + "\\s+",
          "i"
        ).test(line)
      );

      if (!line) return "";

      return line
        .replace(new RegExp("^" + label + "\\s*", "i"), "")
        .trim()
        .split(/\s+/)[0];
    }

    const areaText = getValue("AREA");
    const totalLengthText = getValue("TOTAL\\s+LENGTH");

    const coordinates = [];
    const directions = [];

    let section = "";

    for (const line of lines) {
      if (/^COORDINATES\b/i.test(line)) {
        section = "coordinates";
        continue;
      }

      if (/^DIRECTION SUMMARY\b/i.test(line)) {
        section = "directions";
        continue;
      }

      if (section === "coordinates") {
        const match = line.match(
          /^(\d+)\s+(-?\d+(?:\.\d+)?)\s+(-?\d+(?:\.\d+)?)$/
        );

        if (match) {
          coordinates.push({
            vertex: Number(match[1]),
            north: match[2],
            east: match[3]
          });
        }
      }

      if (section === "directions") {
        const match = line.match(
          /^(NORTH|SOUTH|EAST|WEST)\s+(-?\d+(?:\.\d+)?)/i
        );

        if (match) {
          directions.push({
            name: match[1].toUpperCase(),
            length: match[2]
          });
        }
      }
    }

    if (!coordinates.length) {
      throw new Error(
        "لم يتم العثور على الإحداثيات في نص الحافظة."
      );
    }

    if (!directions.length) {
      throw new Error(
        "لم يتم العثور على ملخص الاتجاهات في نص الحافظة."
      );
    }

    return {
      lot: getValue("LOT"),
      plan: getValue("PLAN"),
      block: getValue("BLOCK"),
      zone: getValue("ZONE"),
      area: areaText.match(/-?\d+(?:\.\d+)?/)?.[0] || "",
      totalLength:
        totalLengthText.match(/-?\d+(?:\.\d+)?/)?.[0] || "",
      coordinates,
      directions
    };
  }

async function fillPropertyData() {
