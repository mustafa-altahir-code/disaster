        }));

        selectInput.dispatchEvent(new KeyboardEvent("keydown", {
          key: "Enter",
          code: "Enter",
          keyCode: 13,
          which: 13,
          bubbles: true
        }));

        selectInput.dispatchEvent(new KeyboardEvent("keyup", {
          key: "Enter",
          code: "Enter",
          keyCode: 13,
          which: 13,
          bubbles: true
        }));

        await sleep(100);
      }

      if (lengthField) setValue(lengthField, d.length);
      if (totalField) setValue(totalField, d.length);
    }



    return results;
  }

  /* ============================================================
   * البحث عن القيم الظاهرة المهمة
