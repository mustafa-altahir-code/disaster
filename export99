  function findByPlaceholder(text, excludeName = null) {
    const elements = document.querySelectorAll("input, textarea");

    for (const el of elements) {
      const placeholder = cleanText(
        el.getAttribute("placeholder") || el.placeholder || ""
      );

      if (
        (placeholder === text || placeholder.includes(text)) &&
        (!excludeName || !(el.name || "").includes(excludeName))
      ) {
        return el;
      }
    }

    return null;
  }

  function getInputValue(el) {
    if (!el) return "";

    const directValue = el.value;
    if (
      directValue !== undefined &&
      directValue !== null &&
      String(directValue).trim() !== ""
    ) {
      return cleanText(directValue);
    }

    const fiberKey = Object.keys(el).find(
      key => key.startsWith("__reactFiber$")
    );

    if (fiberKey) {
      let fiber = el[fiberKey];

      for (let i = 0; i < 15 && fiber; i++) {
        const props = fiber.memoizedProps;

        if (props?.control) {
          const control = props.control;

          const formValues =
            control?._formValues ||
            control?._defaultValues;

          if (formValues) {
            const name = el.name;

            const parts = name.split(".");
            let value = formValues;

            for (const part of parts) {
              if (value == null) break;
              value = value[part];
            }

            if (
              value !== undefined &&
              value !== null &&
              String(value).trim() !== ""
            ) {
              return cleanText(value);
            }
          }
        }

        fiber = fiber.return;
      }
    }

    const attrValue = el.getAttribute("value");

    if (
      attrValue !== undefined &&
      attrValue !== null &&
      String(attrValue).trim() !== ""
    ) {
      return cleanText(attrValue);
    }

    return "";
  }

  function getValueByPlaceholder(placeholder, excludeName = null) {
    const el = findByPlaceholder(placeholder, excludeName);

    if (!el) {
      return {
        value: "",
        element: null
      };
    }

    const value = getInputValue(el);

    return {
      value,
      element: el
    };
  }

