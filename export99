    return (
      !!deedTable &&
      !!deedNumber &&
      !!deedDate &&
      !!ownerName &&
      !!ownerIdentity
    );
  }

  function isPropertyDataPage() {
    const propertyFields = [
      "رقم السجل العقاري",
      "رقم القطعة بالمخطط",
      "رقم المخطط",
      "رقم البلوك",
      "الحدود حسب طبقة الأراضي",
      "وصف العقار"
    ];

    let found = 0;
    for (const field of propertyFields) {
      const result = getValueByPlaceholder(field);
      if (result.element) found++;
    }

    return found >= 2;
  }

  function isExtractionPage() {
    return isDeedDetailsPage() || isPropertyDataPage();
  }

  function startAutoWatcher() {
    let updateTimer = null;

    const updateButton = () => {
      clearTimeout(updateTimer);
      updateTimer = setTimeout(() => {
        const existing = document.getElementById(CONFIG.containerId);
        const validPage = isExtractionPage();

        if (validPage && !existing) {
          createButton();
          return;
        }

        if (!validPage && existing) {
          existing.remove();
        }
      }, 300);
    };

    const observer = new MutationObserver(() => {
      updateButton();
    });

    observer.observe(document.body, {
      childList: true,
      subtree: true
    });

    updateButton();
  }

