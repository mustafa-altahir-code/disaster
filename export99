      } else {
        results.push({
          field: `الإحداثي الشمالي ${i + 1}`,
          found: false
        });
      }

      if (east) {
        setValue(east, point.east);
      } else {
        results.push({
          field: `الإحداثي الشرقي ${i + 1}`,
          found: false
        });
      }
    }

// 5. قراءة الاتجاهات والأطوال من Clipboard مباشرة

    let clipboardText = "";

    try {
      clipboardText = await navigator.clipboard.readText();
    } catch {
      // إذا تعذرت القراءة، لن تتم تعبئة الاتجاهات بقيم تخمينية
    }

    const directionMap = {
      NORTH: "1",
      EAST: "2",
      SOUTH: "3",
      WEST: "4"
