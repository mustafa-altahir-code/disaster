    if (summaryMatch) {
      const lines = summaryMatch[1].split(/\r?\n/);

      for (const line of lines) {
        const match = line.trim().match(
          /^(NORTH|EAST|SOUTH|WEST)\s+([\d,]+(?:\.\d+)?)\s*m?\s*$/i
        );

        if (match) {
