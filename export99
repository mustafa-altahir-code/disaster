  function extractOwnerData() {
    const result = {};

    const identityRegex = /^\d{10}$/;

    const identities = [];
    const names = [];

    const cells = document.querySelectorAll("td, p, span");

    for (const el of cells) {
      const text = cleanText(el.textContent);

      if (
        identityRegex.test(text) &&
        !identities.includes(text)
      ) {
        identities.push(text);
      }
    }

    const candidates = document.querySelectorAll(
      "td p.font-bold, td p[class*='font-bold'], td p[class*='text-[#4A6BA3]']"
    );

    for (const el of candidates) {
      const text = cleanText(el.textContent);

      if (
        text &&
        text.length > 2 &&
        /[\u0600-\u06FF]/.test(text) &&
        !/^\d+$/.test(text) &&
        !text.includes("المالك") &&
        !names.includes(text)
      ) {
        names.push(text);
      }
    }

    const maxOwners = Math.max(
      names.length,
      identities.length
    );

    for (let i = 0; i < maxOwners; i++) {
      const number = i + 1;

      result[`اسم المالك ${number}`] =
        names[i] || "";

      result[`رقم الهوية ${number}`] =
        identities[i] || "";
    }

    return result;
  }

