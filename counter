// ─── CSV Export ──────────────────────────────────────────
function exportCSV(rows) {
    if (!rows || !rows.length) {
        showToast('No data to export');
        return;
    }

    var fromDate = document.querySelector("#from")?.value;
    var toDate = document.querySelector("#to")?.value;
    var isSearch = isSearchActive && searchQuery;

    var fileName = "cases";
    if (isSearch) {
        fileName = "search-results";
    } else if (fromDate && toDate) {
        fileName = fromDate === toDate ? "cases-" + fromDate : "cases-" + fromDate + "_" + toDate;
    } else if (fromDate) {
        fileName = "cases-" + fromDate;
    } else if (toDate) {
        fileName = "cases-" + toDate;
    }

    var grouped = {};
    rows.forEach(function(r) {
        if (!grouped[r.date]) grouped[r.date] = [];
        grouped[r.date].push(r);
    });

    var csvRows = [];
    var dates = Object.keys(grouped).sort().reverse();

    for (var d = 0; d < dates.length; d++) {
        var date = dates[d];
        csvRows.push('"' + date + ' | Total: ' + grouped[date].length + '"');
        csvRows.push('"#","Case ID","Case Notes"');
        for (var r = 0; r < grouped[date].length; r++) {
            var row = grouped[date][r];
            var text = row.text.replace(/"/g, '""');
            csvRows.push('"' + row.idx + '","' + row.fr + '","' + text + '"');
        }
        csvRows.push('');
    }

    var csvString = csvRows.join('\n');
    var blob = new Blob([csvString], { type: 'text/csv;charset=utf-8;' });
    var link = document.createElement('a');
    link.href = URL.createObjectURL(blob);
    link.download = fileName + '.csv';
    link.click();
    URL.revokeObjectURL(link.href);
    showToast('✅ CSV exported successfully!');
}

