    'body{margin:0;padding:30px;font-family:"Inter","Segoe UI",system-ui,sans-serif;background:#F2F5F9;color:var(--text);direction:rtl;}' +
    '.report{max-width:1140px;margin:auto;background:var(--bg);border-radius:20px;padding:28px;box-shadow:0 24px 64px rgba(0,0,0,0.08),0 2px 12px rgba(0,0,0,0.02);border:1px solid var(--border);}' +
    'h1{margin:0 0 2px;color:var(--theme);font-size:28px;font-weight:800;letter-spacing:-0.5px;}' +
    '.subtitle{color:var(--muted);margin-bottom:20px;font-size:14px;font-weight:500;}' +
    '.table-wrap{border-radius:16px;overflow:hidden;border:1px solid var(--border);background:var(--bg);}' +
    'table{width:100%;border-collapse:collapse;font-size:14px;font-family:"Inter","Segoe UI",system-ui,sans-serif;}' +
    '.date-header th{background:var(--theme);color:#FFFFFF;padding:0;border:none;}' +
    '.date-head{display:flex;justify-content:space-between;align-items:center;padding:12px 16px;}' +
    '.date-head .date-text{font-weight:700;font-size:15px;letter-spacing:0.3px;color:rgba(255,255,255,0.95);}' +
    '.date-head .date-count{font-size:13px;font-weight:700;opacity:0.9;background:rgba(255,255,255,0.15);padding:4px 14px;border-radius:20px;color:rgba(255,255,255,0.95);}' +
    '.col-header th{padding:10px 12px;text-align:center;font-weight:600;font-size:12px;color:#9CA3B0;border-bottom:1px solid var(--border);text-transform:uppercase;letter-spacing:0.5px;background:var(--card);}' +
    '.col-header th:last-child{text-align:center;}' +
    'td{padding:10px 12px;border-bottom:1px solid #F1F3F6;border-left:1px solid #F1F3F6;border-right:1px solid #F1F3F6;color:var(--text);}' +
    'td:first-child{border-left:none;}' +
    'td:last-child{border-right:none;border-bottom:1px solid #F1F3F6;}' +
    'tbody tr:last-child td{border-bottom:none;}' +
    '.center{text-align:center;}' +
    '.fr-link{color:var(--theme);font-weight:700;text-decoration:none;}' +
    '.text{text-align:right;direction:rtl;line-height:1.6;color:var(--text);cursor:pointer;}' +
    '.text:hover{background:#F1F3F6;}' +
    'tbody tr:hover{background:#F1F3F6;}' +
    '.progress-wrap{display:flex;align-items:center;gap:12px;flex:1;margin:0 16px;}' +
    '.progress-bar{flex:1;height:6px;background:rgba(255,255,255,0.25);border-radius:4px;overflow:hidden;}' +
    '.progress-fill{height:100%;border-radius:4px;background:linear-gradient(90deg, rgba(255,255,255,0.95), rgba(255,255,255,0.65));transition:width 0.3s ease;box-shadow:0 0 8px rgba(255,255,255,0.25);}' +
    '.progress-text{font-size:12px;font-weight:600;opacity:0.9;min-width:40px;text-align:right;color:rgba(255,255,255,0.9);}' +
    '.copy-tooltip{position:fixed;background:#111827;color:#fff;padding:6px 14px;border-radius:10px;font-size:12px;font-weight:500;z-index:9999999;pointer-events:none;box-shadow:0 8px 24px rgba(0,0,0,0.2);opacity:0;transform:translateY(8px);transition:all 0.25s ease;}' +
    '</style></head><body><div class="report">' +
    '<h1>' + (document.querySelector(".text-black.font-bold.md\\:text-base.md\\:leading-6")?.textContent.replace("مرحبا", "").replace("!", "").trim() || "Case Report") + '</h1>' +
    '<div class="subtitle">' + (isSearch ? '🔍 Search Results: "' + searchQuery + '"' : (fromDate && toDate ? (fromDate === toDate ? fromDate : fromDate + ' - ' + toDate) : fromDate ? 'From: ' + fromDate : toDate ? 'Up to: ' + toDate : "All dates")) + '</div>' +
    '<div class="table-wrap"><table>';

    var dates = Object.keys(grouped).sort().reverse();
    var showProgress = !isSearch;
    var copyScript = '';

    for (var d = 0; d < dates.length; d++) {
        var date = dates[d];
        var total = grouped[date].length;
        html += '' +
        '<thead class="date-header">' +
        '<tr><th colspan="3">' +
        '<div class="date-head">' +
        '<span class="date-text">📅 ' + date + '</span>';

        if (showProgress) {
            var percent = Math.min((total / 30) * 100, 100);
            html += '' +
            '<div class="progress-wrap">' +
            '<div class="progress-bar">' +
            '<div class="progress-fill" style="width:' + percent + '%;"></div>' +
            '</div>' +
            '<span class="progress-text">' + percent.toFixed(0) + '%</span>' +
            '</div>';
        } else {
            html += '<div style="flex:1;margin:0 16px;"></div>';
        }

        html += '' +
        '<span class="date-count">' + total + ' cases</span>' +
        '</div>' +
        '</th></tr>' +
        '<tr class="col-header">' +
        '<th style="width:60px;">#</th>' +
        '<th style="width:130px;">Case ID</th>' +
        '<th style="text-align:center;">Case Notes</th>' +
        '</tr>' +
        '</thead>' +
        '<tbody>';

        for (var r = 0; r < grouped[date].length; r++) {
            var row = grouped[date][r];
            var escapedText = row.text
                .replace(/&/g, '&amp;')
                .replace(/"/g, '&quot;')
                .replace(/</g, '&lt;')
                .replace(/>/g, '&gt;')
                .replace(/\n/g, '&#10;')
                .replace(/'/g, '&#39;');
            html += '' +
            '<tr>' +
            '<td class="center" style="font-weight:500;color:#6B7280;">' + row.idx + '</td>' +
            '<td class="center"><a href="https://ops.rer.sa/case-view?caseId=' + encodeURIComponent(row.fr) + '" target="_blank" rel="noopener" class="fr-link">' + row.fr + '</a></td>' +
            '<td class="text" data-copy-text="' + escapedText + '">' + row.text.replace(/\n/g, '<br>') + '</td>' +
            '</tr>';
            copyScript += '' +
            'document.querySelectorAll(".text[data-copy-text]").forEach(function(el) {' +
            '  el.addEventListener("click", function() {' +
            '    var text = this.getAttribute("data-copy-text");' +
            '    navigator.clipboard.writeText(text).then(function() {' +
            '      showCopyTooltip(el, "✅ تم النسخ");' +
            '    }).catch(function() {' +
            '      var ta=document.createElement("textarea");' +
            '      ta.value=text;' +
            '      document.body.appendChild(ta);' +
            '      ta.select();' +
            '      document.execCommand("copy");' +
            '      ta.remove();' +
            '      showCopyTooltip(el, "✅ تم النسخ");' +
            '    });' +
            '  });' +
            '});';
        }
        html += '</tbody>';
    }

    html += '</table></div></div>' +
    '<script>' +
    copyScript +
    'function showCopyTooltip(el, msg) { var t=document.createElement("div"); t.className="copy-tooltip"; t.textContent=msg; document.body.appendChild(t); var r=el.getBoundingClientRect(); t.style.left=(r.left+r.width/2-30)+"px"; t.style.top=(r.top-40)+"px"; requestAnimationFrame(function(){t.style.opacity="1";t.style.transform="translateY(0)";}); setTimeout(function(){t.style.opacity="0";t.style.transform="translateY(8px)"; setTimeout(function(){t.remove();},300);},1200); }' +
    '</script>' +
    '</body></html>';

    download(html, fileName + ".html", "text/html");
    showToast('✅ HTML report exported successfully!');
}

function download(data, name, type) {
    var a = document.createElement("a");
    a.href = URL.createObjectURL(new Blob([data], { type: type }));
    a.download = name;
    a.click();
}

// ─── Storage Events ──────────────────────────────────────
window.addEventListener("storage", function(event) {
    if (event.key === SETTINGS_KEY && event.newValue) {
        settings = JSON.parse(event.newValue);
        applySettings();
    }
    if (event.key === STORAGE_KEY) {
        updateCounter();
    }
});

injectStyles();
}
})();
