// ─── Filters ─────────────────────────────────────────────
var fromDate = currentModal.querySelector("#from");
var toDate = currentModal.querySelector("#to");
var todayBtn = currentModal.querySelector("#todayBtn");

function applyDateFilter() {
    currentAllData = flatten();
    var f = fromDate.value;
    var t = toDate.value;
    var hasSearch = isSearchActive && searchQuery;

    var filtered = [];

    if (hasSearch) {
        filtered = currentAllData.filter(function(r) {
            return r.fr.toLowerCase().includes(searchQuery) ||
                r.text.toLowerCase().includes(searchQuery);
        });
    } else if (f || t) {
        filtered = currentAllData.slice();
        if (f && t) {
            filtered = filtered.filter(function(r) {
                return r.date >= f && r.date <= t;
            });
        } else if (f) {
            filtered = filtered.filter(function(r) {
                return r.date >= f;
            });
        } else if (t) {
            filtered = filtered.filter(function(r) {
                return r.date <= t;
            });
        }
    } else {
        filtered = currentAllData.slice();
    }

    currentFilteredData = filtered;
    renderTable();
}

