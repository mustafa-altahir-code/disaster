        '</div>';
        return;
    }

    var grouped = {};
    dataToShow.forEach(function(r) {
        if (!grouped[r.date]) grouped[r.date] = [];
        grouped[r.date].push(r);
    });

    var dateHeaders = Object.keys(grouped).sort().reverse();

    var tableHTML = '' +
