    '<table style="width:100%;border-collapse:collapse;font-size:14px;font-family:\'Inter\',\'Segoe UI\',system-ui,sans-serif;">';

    for (var d = 0; d < dateHeaders.length; d++) {
        var date = dateHeaders[d];
        var showProgress = !isSearchActive;

        tableHTML += '' +
