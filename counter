function copyText(text, el, showMessage = true) {
    navigator.clipboard.writeText(text).then(function() {
        if(showMessage){
            showTooltip(el, "✅ تم نسخ رقم الطلب والتعليق");
        }
    }).catch(function() {
        var ta = document.createElement("textarea");
        ta.value = text;
        document.body.appendChild(ta);
        ta.select();
        document.execCommand("copy");
        ta.remove();

        if(showMessage){
            showTooltip(el, "✅ تم نسخ رقم الطلب والتعليق");
        }
    });
}

