function applySettings() {
if (typeof settings.counterHidden === "undefined") {
settings.counterHidden = false;
}
if (settings.counterHidden) {
counter.textContent = "";
counter.dataset.hidden = "true";
} else {
counter.textContent = counter.dataset.count || "0";
counter.dataset.hidden = "false";
}
injectStyles();
}

applySettings();

function cycleColor() {
colorIndex = (colorIndex + 1) % COLORS.length;
var color = COLORS[colorIndex];

counter.style.background = 'linear-gradient(135deg, ' + color + 'cc, ' + color + '88)';
counter.style.borderColor = color + '66';
ring.style.borderColor = color;
colorLayer.style.background = 'linear-gradient(135deg, ' + color + 'cc, ' + color + '88)';
counter.style.boxShadow = '0 8px 32px ' + color + '33, 0 2px 8px rgba(0,0,0,0.06)';

