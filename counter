// ─── Import/Export Functions ─────────────────────────────
function exportAllData() {
var data = load();
var json = JSON.stringify(data, null, 2);
var blob = new Blob([json], { type: 'application/json' });
var url = URL.createObjectURL(blob);
var a = document.createElement('a');
a.href = url;
a.download = 'cases_backup_' + today() + '.json';
document.body.appendChild(a);
a.click();
document.body.removeChild(a);
URL.revokeObjectURL(url);
showToast('📦 Data exported successfully! (' + getTotal() + ' records)');
}

function importAllData() {
var input = document.createElement('input');
input.type = 'file';
input.accept = '.json';
input.onchange = function(e) {
var file = e.target.files[0];
if (!file) return;
var reader = new FileReader();
reader.onload = function(event) {
try {
var importedData = JSON.parse(event.target.result);
if (typeof importedData !== 'object' || importedData === null) {
showToast('❌ Invalid data format: Not an object');
return;
}
var currentData = load();
var merged = false;
var totalImported = 0;
Object.keys(importedData).forEach(function(date) {
if (Array.isArray(importedData[date])) {
if (!currentData[date] || !Array.isArray(currentData[date])) {
currentData[date] = [];
}
importedData[date].forEach(function(item) {
if (item && typeof item === 'object' && item.fr && item.text) {
var exists = false;
for (var i = 0; i < currentData[date].length; i++) {
if (currentData[date][i].fr === item.fr && currentData[date][i].text === item.text) {
exists = true;
break;
}
}
if (!exists) {
currentData[date].push({ fr: item.fr, text: item.text });
merged = true;
totalImported++;
}
}
});
}
});
if (merged) {
save(currentData);
