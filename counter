(function () {
// ─── Global Variables ─────────────────────────────────────
let isSearchActive = false;
let searchQuery = '';
let currentModal = null;
let currentOverlay = null;
let currentAllData = [];
let currentFilteredData = [];

function checkCondition() {
return [...document.querySelectorAll("p")]
.some(p => p.textContent.trim() === "المشرف الجيومكاني");
}

function waitForCondition() {
if (checkCondition()) init();
else {
const o = new MutationObserver(() => {
if (checkCondition()) {
o.disconnect();
init();
}
});
o.observe(document.body, { childList: true, subtree: true });
}
}

document.readyState === "loading"
? document.addEventListener("DOMContentLoaded", waitForCondition)
: waitForCondition();

function init() {
const loadXLSX = () => new Promise((resolve, reject) => {
if (window.XLSX) return resolve(window.XLSX);
reject(new Error("XLSX not available."));
});

const STORAGE_KEY = "clickCounterHistory";
const SETTINGS_KEY = "caseSettings";
const LAST_SUBMITTED_KEY = "lastSubmittedCaseTemp";

const COLORS = [
"#0A3556",
"#824131",
"#367580",
"#BC9975"
];

const CYCLE_DURATION = 15000;
const TRANSITION_DURATION = 300;
let colorIndex = 0;

const today = () => new Date().toISOString().split("T")[0];

let settings = {
darkMode: false,
autoHide: false,
counterHidden: false
};

const loadSettings = () => {
const s = localStorage.getItem(SETTINGS_KEY);
if (s) settings = JSON.parse(s);
};

const saveSettings = () => localStorage.setItem(SETTINGS_KEY, JSON.stringify(settings));

loadSettings();

const load = () => {
try {
const data = localStorage.getItem(STORAGE_KEY);
if (!data) return {};
const parsed = JSON.parse(data);
if (typeof parsed !== 'object' || parsed === null) return {};
return parsed;
} catch (e) {
console.error('Error loading data:', e);
return {};
}
};

const save = d => localStorage.setItem(STORAGE_KEY, JSON.stringify(d));

// ─── قراءة واستخراج نوع الطلب (FR أو DU) ────────────────────
const extractCaseId = () => {
    var caseElement = document.querySelector('.uppercase.text-\\[12px\\]') || 
                      document.querySelector('span.uppercase.text-\\[12px\\]');
    if (caseElement) {
        var text = caseElement.textContent.trim();
        // دعم الصيغ التي تبدأ بـ FR أو DU
        var match = text.match(/(FR|DU)\s*(\d+)/i);
        if (match) {
            return match[1].toUpperCase() + match[2];
        }
        return text;
    }
    return "N/A";
};

const extractText = () => {
    var textarea = document.querySelector("textarea");
    if (textarea) {
        return textarea.value.trim() || "N/A";
    }
    return "N/A";
};

const flatten = () => {
const h = load();
const out = [];
try {
Object.keys(h).forEach(function(date) {
const arr = h[date];
if (Array.isArray(arr)) {
arr.forEach(function(r, i) {
if (r && typeof r === 'object') {
out.push({
date: date,
idx: i + 1,
fr: r.fr || 'N/A',
text: r.text || 'N/A'
});
}
});
}
});
} catch (e) {
console.error('Error flattening data:', e);
}
return out.sort(function(a, b) { return a.date.localeCompare(b.date); });
};

const getTotal = function() {
try {
const h = load();
let total = 0;
Object.keys(h).forEach(function(key) {
const arr = h[key];
if (Array.isArray(arr)) {
total += arr.length;
}
});
return total;
} catch (e) {
console.error('Error calculating total:', e);
return 0;
}
};

const ASSIGNMENT_TEXT = "تعيين الطلب لمدقق الطلبات";

// ─── Get dropdown value from React Select ──────────────
function getDropdownValue() {
    var dropdowns = document.querySelectorAll('.drop-down-box.css-b62m3t-container');
    if (dropdowns.length < 2) {
        return '';
    }
    var dropdown = dropdowns[1];
    var selectedValue = dropdown.querySelector('.css-z588e4-singleValue');
    if (selectedValue) {
        return selectedValue.textContent.trim();
    }
    return '';
}

// ─── إشعار ملون مع تفاصيل الحالة ─────────────────────────
function showResultToast(stage, message, details) {
    var existingToast = document.getElementById('case-result-toast');
    if (existingToast) existingToast.remove();

    var toast = document.createElement('div');
    toast.id = 'case-result-toast';

    var stageConfig = {
        success: { bg: '#065F46', border: '#10B981', icon: '🟢' },
        warning: { bg: '#9A3412', border: '#F59E0B', icon: '🟠' },
        error:   { bg: '#991B1B', border: '#EF4444', icon: '🔴' }
    };

    var conf = stageConfig[stage] || stageConfig.success;

    Object.assign(toast.style, {
        position: 'fixed',
        top: '20px',
        left: '50%',
        transform: 'translateX(-50%) translateY(-20px)',
        background: conf.bg,
        color: '#FFFFFF',
        padding: '14px 28px',
        borderRadius: '16px',
        boxShadow: '0 20px 60px rgba(0,0,0,0.5)',
        border: '2px solid ' + conf.border,
        fontFamily: "'Inter','Segoe UI',system-ui,sans-serif",
        fontSize: '14px',
        fontWeight: '600',
        zIndex: 9999999,
        opacity: '0',
        transition: 'all 0.35s cubic-bezier(0.2, 0.8, 0.2, 1)',
        maxWidth: '520px',
        textAlign: 'center',
        direction: 'rtl',
        backdropFilter: 'blur(12px)',
        WebkitBackdropFilter: 'blur(12px)',
    });
    
    var detailsHTML = details ? '<div style="font-size:12px;opacity:0.85;font-weight:400;margin-top:4px;">' + details + '</div>' : '';
    toast.innerHTML = conf.icon + ' ' + message + detailsHTML;
    
    document.body.appendChild(toast);
    
    requestAnimationFrame(function() {
        toast.style.opacity = '1';
        toast.style.transform = 'translateX(-50%) translateY(0)';
    });
    
    setTimeout(function() {
        if (toast && toast.parentNode) {
            toast.style.opacity = '0';
            toast.style.transform = 'translateX(-50%) translateY(-20px)';
            setTimeout(function() { toast.remove(); }, 400);
        }
    }, 4500);
}

// ─── تسجيل الحالة ────────────────────────────────────────
function recordCase(caseId, text) {
    try {
        var h = load();
        var d = today();
        
        if (!h[d] || !Array.isArray(h[d])) {
            h[d] = [];
        }
        
        var exists = false;
        for (var i = 0; i < h[d].length; i++) {
            if (h[d][i] && h[d][i].fr === caseId && h[d][i].text === text) {
                exists = true;
                break;
            }
        }
        
        if (exists) {
            return { success: false, reason: 'duplicate' };
        }
        
        h[d].push({
            fr: caseId,
            text: text
        });
        save(h);
        updateCounter();
        highlightNewRecord();
        
        return { success: true };
    } catch (e) {
        console.error('Error recording case:', e);
        return { success: false, reason: 'error', error: e };
    }
}

// ─── التحقق عند تحميل الصفحة الجديدة بعد التحديث ─────────
(function checkPostReload() {
    try {
        var pending = sessionStorage.getItem(LAST_SUBMITTED_KEY);
        if (pending) {
            var data = JSON.parse(pending);
            sessionStorage.removeItem(LAST_SUBMITTED_KEY);
            // إظهار إشعار أخضر بعد تحديث الصفحة بنجاح
            showResultToast('success', '🟢 تم تحديث الصفحة وتأكيد تسجيل الطلب!', 'تم حفظ الطلب: ' + data.id);
        }
    } catch (e) {}
})();

// ─── معالج الضغط على زر «متابعة» (تسجيل فوري مع الاستعداد للتحديث) ──
document.addEventListener("click", function(e) {
    var target = e.target;
    var continueBtn = document.querySelector(
        '#__next > div > div.w-full.p-8.transition-all.duration-700 > div > div.mt-12 > div:nth-child(13) > div.flex.justify-between.items-center > div > div > button'
    );
    
    var isContinue = false;
    if (continueBtn && (target === continueBtn || continueBtn.contains(target))) {
        isContinue = true;
    } else {
        // فحص بديل بنص الزر في حال تغيّر مسار الزر
        var btn = target.closest('button');
        if (btn && btn.textContent.trim().includes("متابعة")) {
            isContinue = true;
        }
    }
    
    if (!isContinue) return;

    var caseId = extractCaseId();
    var text = extractText();
    var dropdownValue = getDropdownValue();
    
    // التحقق من أن رقم الطلب يبدأ بـ FR أو DU
    var caseValid = caseId && caseId !== "N/A" && /^(FR|DU)/i.test(caseId);
    var textValid = text && text !== "N/A" && text.length > 0;
    var dropdownMatch = dropdownValue === ASSIGNMENT_TEXT;
    
    if (caseValid && textValid && dropdownMatch) {
        // يتم التسجيل فوراً في الـ localStorage قبل أن تغلق أو تحدث الصفحة
        var result = recordCase(caseId, text);

        if (result.success) {
            // حفظ بيانات الحالة في sessionStorage للتأكيد بعد التحديث
            sessionStorage.setItem(LAST_SUBMITTED_KEY, JSON.stringify({ id: caseId, text: text, time: Date.now() }));
            showResultToast('success', '🟢 تم تسجيل الحالة بنجاح!', 'الطلب: ' + caseId);
        } else if (result.reason === 'duplicate') {
            showResultToast('warning', '🟠 حالة مكررة - لم يتم التسجيل', 'الطلب ' + caseId + ' مسجل مسبقاً لهذا اليوم');
        } else {
            showResultToast('error', '🔴 خطأ أثناء التسجيل', 'يرجى المحاولة مرة أخرى');
        }
    } else {
        var missing = [];
        if (!caseValid) missing.push("نوع الطلب غير صالح (يجب أن يبدأ بـ FR أو DU)");
        if (!textValid) missing.push("نص التعليق فارغ");
        if (!dropdownMatch) missing.push("اختر: " + ASSIGNMENT_TEXT);
        showResultToast('error', '🔴 لم يتم التسجيل: الشروط غير مكتملة', missing.join(" | "));
    }
}, true);

// ─── Highlight Counter ──────────────────────────────────
function highlightNewRecord() {
    var color = COLORS[colorIndex];
    
    var glowLayer = document.createElement('div');
    Object.assign(glowLayer.style, {
        position: 'fixed',
        top: '14px',
        right: '14px',
        width: '52px',
        height: '52px',
        borderRadius: '50%',
        background: color,
        zIndex: '99997',
        pointerEvents: 'none',
        opacity: '0.8',
        filter: 'blur(20px)',
        transform: 'scale(1)'
    });
    
    document.body.appendChild(glowLayer);
    
    glowLayer.animate([
        { transform: 'scale(1)', opacity: 0.8, filter: 'blur(20px)' },
        { transform: 'scale(2.5)', opacity: 0.6, filter: 'blur(30px)' },
        { transform: 'scale(3.5)', opacity: 0, filter: 'blur(40px)' }
    ], {
        duration: 1200,
        easing: "cubic-bezier(0.2, 0.8, 0.2, 1)"
    });
    
    var fireImg = document.createElement('img');
    fireImg.src = typeof chrome !== 'undefined' && chrome.runtime && chrome.runtime.getURL
        ? chrome.runtime.getURL('Fire.gif')
        : 'Fire.gif';
    
    Object.assign(fireImg.style, {
        position: 'fixed',
        top: '14px',
        right: '14px',
        width: '52px',
        height: '52px',
        zIndex: '99997',
        pointerEvents: 'none',
        opacity: '0',
        transform: 'scale(0.5)',
        transition: 'all 0.3s cubic-bezier(0.2, 0.8, 0.2, 1)',
        filter: getColorFilter(colorIndex),
        objectFit: 'contain'
    });
    
    document.body.appendChild(fireImg);
    
    requestAnimationFrame(function() {
        fireImg.style.opacity = '1';
        fireImg.style.transform = 'scale(1.3)';
    });
    
    counter.animate([
        { transform: 'scale(1)' },
        { transform: 'scale(1.35)' },
        { transform: 'scale(1)' }
    ], {
        duration: 900,
        easing: "cubic-bezier(0.2, 0.8, 0.2, 1)"
    });
    
    setTimeout(function() {
        if (glowLayer && glowLayer.parentNode) {
            glowLayer.parentNode.removeChild(glowLayer);
        }
    }, 1300);
    
    setTimeout(function() {
        fireImg.style.opacity = '0';
        fireImg.style.transform = 'scale(0.5)';
        setTimeout(function() {
            if (fireImg && fireImg.parentNode) {
                fireImg.parentNode.removeChild(fireImg);
            }
        }, 400);
    }, 2000);
}

// ─── Color Filter for GIF ──────────────────────────────
function getColorFilter(index) {
    var filters = [
        'hue-rotate(190deg) saturate(2) brightness(0.8)',
        'hue-rotate(340deg) saturate(1.5) brightness(1)',
        'hue-rotate(160deg) saturate(1.3) brightness(1)',
        'sepia(0.6) saturate(1.5) brightness(1.1)'
    ];
    return filters[index % filters.length];
}

