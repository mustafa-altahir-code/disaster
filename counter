setTimeout(cycleColor, CYCLE_DURATION);

function updateCounter() {
try {
const h = load();
const d = today();
let count = 0;
if (h[d] && Array.isArray(h[d])) {
count = h[d].length;
}
counter.dataset.count = count;
counter.title = 'Cases today';
if (!settings.counterHidden) {
counter.textContent = count;
}
var modal = document.getElementById("case-modal");
if (modal) {
var totalSpan = modal.querySelector('.total-cases');
if (totalSpan) {
totalSpan.textContent = getTotal();
}
}
} catch (e) {
console.error('Error updating counter:', e);
}
}

updateCounter();
counter.onclick = openModal;

