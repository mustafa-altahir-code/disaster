// ─── Exports ──────────────────────────────────────────────
function exportExcel(rows) {
    if (!rows || !rows.length) {
        showToast('No data to export');
        return;
    }
    var userName = document.querySelector(".text-black.font-bold.md\\:text-base.md\\:leading-6")
        ?.textContent
        .replace("مرحبا", "")
        .replace("!", "")
        .trim() || "Unknown User";

    var fromDate = document.querySelector("#from")?.value;
    var toDate = document.querySelector("#to")?.value;
    var isSearch = isSearchActive && searchQuery;

    var fileName = "cases";
    if (isSearch) {
        fileName = "search-results";
    } else if (fromDate && toDate) {
        fileName = fromDate === toDate ? "cases-" + fromDate : "cases-" + fromDate + "_" + toDate;
    } else if (fromDate) {
        fileName = "cases-" + fromDate;
    } else if (toDate) {
        fileName = "cases-" + toDate;
    }

    var grouped = {};
    rows.forEach(function(r) {
        if (!grouped[r.date]) grouped[r.date] = [];
        grouped[r.date].push(r);
    });

    var wb = XLSX.utils.book_new();
    var ws_data = [];

    ws_data.push([userName, ""]);
    ws_data.push([]);

    var dates = Object.keys(grouped).sort().reverse();
    for (var d = 0; d < dates.length; d++) {
        var date = dates[d];
        ws_data.push([date + " | Total: " + grouped[date].length]);
        ws_data.push(["#", "Case ID", "Case Notes"]);
        for (var r = 0; r < grouped[date].length; r++) {
            var row = grouped[date][r];
            ws_data.push([row.idx, row.fr, row.text]);
        }
        ws_data.push([]);
    }

    var ws = XLSX.utils.aoa_to_sheet(ws_data);
    ws['!merges'] = [{ s: { r: 0, c: 0 }, e: { r: 0, c: 1 } }];
    var themeRGB = COLORS[colorIndex].replace("#", "").toUpperCase();
    var range = XLSX.utils.decode_range(ws['!ref']);

    for (var R = range.s.r; R <= range.e.r; ++R) {
        for (var c = 0; c < 3; c++) {
            var cellAddr = XLSX.utils.encode_cell({ r: R, c: c });
            if (!ws[cellAddr]) ws[cellAddr] = { t: "s", v: "" };
            ws[cellAddr].s ||= {};
        }
        var cellA = ws[XLSX.utils.encode_cell({ r: R, c: 0 })];
        if (typeof cellA.v === "string" && cellA.v.indexOf("Total:") !== -1) {
            for (var c2 = 0; c2 < 3; c2++) {
                var addr = XLSX.utils.encode_cell({ r: R, c: c2 });
                ws[addr].s = {
                    font: { bold: true, color: { rgb: "FFFFFF" } },
                    fill: { fgColor: { rgb: themeRGB } },
                    alignment: { horizontal: "left" }
                };
            }
            if (!ws['!merges']) ws['!merges'] = [];
            ws['!merges'].push({ s: { r: R, c: 0 }, e: { r: R, c: 2 } });
        }
        if (cellA.v === "#" && (ws[XLSX.utils.encode_cell({ r: R, c: 1 })]?.v === "FR" || ws[XLSX.utils.encode_cell({ r: R, c: 1 })]?.v === "Case ID")) {
            for (var c3 = 0; c3 < 3; c3++) {
                var addr2 = XLSX.utils.encode_cell({ r: R, c: c3 });
                ws[addr2].s = {
                    font: { bold: true, color: { rgb: "333333" } },
                    fill: { fgColor: { rgb: "F6F6F6" } },
                    alignment: { horizontal: "center" },
                    border: {
                        top: { style: "thin", color: { rgb: "CCCCCC" } },
                        bottom: { style: "thin", color: { rgb: "CCCCCC" } },
                        left: { style: "thin", color: { rgb: "CCCCCC" } },
                        right: { style: "thin", color: { rgb: "CCCCCC" } }
                    }
                };
            }
        }
        if (typeof cellA.v === "number") {
            for (var c4 = 0; c4 < 3; c4++) {
                var addr3 = XLSX.utils.encode_cell({ r: R, c: c4 });
                var cell = ws[addr3];
                cell.s ||= {};
                cell.s.alignment = {
                    vertical: "top",
                    horizontal: c4 === 2 ? "left" : "center",
                    wrapText: true
                };
                cell.s.border = {
                    top: { style: "thin", color: { rgb: "DDDDDD" } },
                    bottom: { style: "thin", color: { rgb: "DDDDDD" } },
                    left: { style: "thin", color: { rgb: "DDDDDD" } },
                    right: { style: "thin", color: { rgb: "DDDDDD" } }
                };
            }
        }
    }
    ws['!cols'] = [{ wch: 6 }, { wch: 14 }, { wch: 80 }];
    XLSX.utils.book_append_sheet(wb, ws, "Report");
    XLSX.writeFile(wb, fileName + ".xlsx");
    showToast('✅ Excel report exported successfully!');
}

