/* ==================== دالة آمنة لإنشاء العناصر ==================== */

function createElementSafe(tag, attributes = {}, textContent = '') {
const element = document.createElement(tag);
Object.entries(attributes).forEach(([key, value]) => {
    if (key === 'className') element.className = value;
    else if (key === 'style' && typeof value === 'object') Object.assign(element.style, value);
    else element.setAttribute(key, value);
});
if (textContent) element.textContent = textContent;
return element;
}

function safeSetText(element, text) {
if (element) element.textContent = text;
}

function isExcludedElement(element) {
if (!element) return true;
for (const selector of CONFIG.excludedSelectors) {
    if (element.closest(selector)) return true;
}
const style = window.getComputedStyle(element);
if (style.position === 'fixed' || style.position === 'absolute') {
    const rect = element.getBoundingClientRect();
    if (rect.width < 300 && rect.height < 200) return true;
}
return false;
}

function getUptime() {
const s = Math.floor((Date.now() - state.stats.startTime) / 1000);
return `${Math.floor(s / 3600)}h ${Math.floor((s % 3600) / 60)}m`;
}

/* ==================== دوال التمرير التلقائي ==================== */

function findChatContainer() {
const possibleContainers = [
    '.ts-message-list-container',
    '[data-tid="chat-pane"]',
    '.message-pane',
    '.fui-Chat',
    '.thread-wrapper',
    '.message-list',
    'div[class*="message-list"]',
    'div[class*="chat-pane"]',
    'div[role="log"]'
];

for (const sel of possibleContainers) {
    const els = document.querySelectorAll(sel);
    for (const el of els) {
        if (el.offsetParent !== null && (el.querySelector('.fr-badge') || el.querySelector('[data-tid="message"]'))) {
            return el;
        }
    }
}

const allElements = document.querySelectorAll('div, section');
for (const el of allElements) {
    if (el.scrollHeight > el.clientHeight + 20) {
        const style = window.getComputedStyle(el);
        const overflowY = style.overflowY;
        if (overflowY === 'auto' || overflowY === 'scroll') {
            if (el.querySelector('.fr-badge') || el.querySelector('[data-tid="message"]') || /(fr|du)/i.test(el.innerText)) {
                return el;
            }
        }
    }
}

const activeElement = document.activeElement;
if (activeElement && activeElement.closest) {
    const chatContainer = activeElement.closest('[class*="message-list"], [class*="chat-pane"], [role="log"]');
    if (chatContainer) return chatContainer;
}
return null;
}

let cachedChatContainer = null;
let lastContainerCheck = 0;

function getChatContainer() {
if (Date.now() - lastContainerCheck > 1000) {
    cachedChatContainer = findChatContainer();
    lastContainerCheck = Date.now();
}
return cachedChatContainer;
}

