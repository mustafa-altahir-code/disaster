function getVisibleRows() {
return Array.from(tbody.children).filter(row => row.style.display !== 'none');
}

function toggleRowSelection(row, frValue) {
if (!frValue) return;
const frLower = frValue.toLowerCase();
const visibleRows = getVisibleRows();
const currentIndex = visibleRows.indexOf(row);
if (currentIndex === -1) return;

if (state.firstSelectedFR === null) {
    state.firstSelectedFR = frLower;
    state.selectedFRs.clear();
    state.selectedFRs.add(frLower);
} else {
    const firstIndex = visibleRows.findIndex(
        r => (r.cells[1]?.textContent || '').toLowerCase() === state.firstSelectedFR
    );
    if (firstIndex === -1) {
        state.firstSelectedFR = frLower;
        state.selectedFRs.clear();
        state.selectedFRs.add(frLower);
    } else {
        const start = Math.min(firstIndex, currentIndex);
        const end = Math.max(firstIndex, currentIndex);
        state.selectedFRs.clear();
        for (let i = start; i <= end; i++) {
            const fr = visibleRows[i].cells[1]?.textContent;
            if (fr) state.selectedFRs.add(fr.toLowerCase());
        }
        state.firstSelectedFR = null;
    }
}

updateRowSelectionStyles();
updateStats();
}

function updateRowSelectionStyles() {
Array.from(tbody.children).forEach(row => {
    const fr = row.cells[1]?.textContent;
    if (fr && state.selectedFRs.has(fr.toLowerCase())) {
        row.style.background = 'linear-gradient(90deg, rgba(139, 92, 246, 0.2), rgba(139, 92, 246, 0.05))';
        row.style.borderLeft = '3px solid var(--theme-primary)';
        row.style.boxShadow = 'inset 0 0 20px rgba(139, 92, 246, 0.1)';
    } else {
        row.style.background = '';
        row.style.borderLeft = '';
        row.style.boxShadow = '';
    }
});
}

function clearAllSelections() {
state.selectedFRs.clear();
state.firstSelectedFR = null;
updateRowSelectionStyles();
updateStats();
}

function selectAllVisible() {
