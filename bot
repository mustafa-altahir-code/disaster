async function updateFRData(fr, updates) {
if (!fr) return;
const frUpper = fr.toString().toUpperCase();
if (!frUpper.startsWith("FR") && !frUpper.startsWith("DU")) {
    console.warn("❌ Invalid FR/DU ID. Not saving.");
    return;
}
const frLower = fr.toString().toLowerCase();

if (typeof chrome !== 'undefined' && chrome.storage) {
    return new Promise((resolve) => {
        chrome.storage.local.get(['fr_database'], (result) => {
            let database = result.fr_database || { frs: {}, lastUpdate: null, version: '1.0' };
            const existing = database.frs[frLower] || {};
            const updatedData = {
                ...existing,
                fr: frLower,
                ...updates,
                timestamp: new Date().toLocaleString()
            };
            
            database.frs[frLower] = updatedData;
            database.lastUpdate = new Date().toISOString();
            
            chrome.storage.local.set({ fr_database: database }, () => {
                console.log(`💾 Chrome Storage: تم تحديث ${frLower}`, updatedData);
                resolve(updatedData);
            });
        });
    });
} else {
    const key = `REQ_${frLower}`;
    const existing = JSON.parse(localStorage.getItem(key) || '{}');
    const updatedData = { ...existing, ...updates, timestamp: new Date().toLocaleString() };
    localStorage.setItem(key, JSON.stringify(updatedData));
    return updatedData;
}
}

function extractMessageTime(messageElement) {
try {
    const timeElement = messageElement.querySelector('time, [datetime], [data-tid="timestamp"], .fui-ChatMessage__timestamp');
    if (timeElement) {
        if (timeElement.hasAttribute('datetime')) {
            const datetime = timeElement.getAttribute('datetime');
            const date = new Date(datetime);
            if (!isNaN(date.getTime())) {
                const dateStr = date.toLocaleDateString('ar-SA', { day: '2-digit', month: '2-digit', year: '2-digit' });
                const timeStr = date.toLocaleTimeString('ar-SA', { hour: '2-digit', minute: '2-digit' });
                return { date: dateStr, time: timeStr, fullDate: date, timestamp: date.getTime() };
            }
        }
        
        const timeText = timeElement.textContent.trim();
        if (timeText) {
            const now = new Date();
            return {
                date: now.toLocaleDateString('ar-SA', { day: '2-digit', month: '2-digit', year: '2-digit' }),
                time: timeText,
                fullDate: now,
                timestamp: now.getTime()
            };
        }
    }
    
    const messageId = messageElement.id || '';
    const idMatch = messageId.match(/message-body-(\d+)/);
    if (idMatch) {
        const timestamp = parseInt(idMatch[1]);
        if (!isNaN(timestamp) && timestamp > 1000000000000) {
            const date = new Date(timestamp);
            const dateStr = date.toLocaleDateString('ar-SA', { day: '2-digit', month: '2-digit', year: '2-digit' });
            const timeStr = date.toLocaleTimeString('ar-SA', { hour: '2-digit', minute: '2-digit' });
            return { date: dateStr, time: timeStr, fullDate: date, timestamp: timestamp };
        }
    }
} catch (e) {
    console.log('خطأ في استخراج وقت الرسالة:', e);
}
return null;
}

function findSenderName(messageElement) {
let currentElement = messageElement;
let attempts = 0;
const maxAttempts = 10;

while (currentElement && attempts < maxAttempts) {
    const authorByTid = currentElement.querySelector('[data-tid="message-author-name"]');
    if (authorByTid && authorByTid.textContent.trim()) return authorByTid.textContent.trim();
    
    const authorById = currentElement.querySelector('[id^="author-"]');
    if (authorById && authorById.textContent.trim()) return authorById.textContent.trim();
    
    const authorByClass = currentElement.querySelector('.fui-StyledText, [class*="author"] span');
    if (authorByClass && authorByClass.textContent.trim()) return authorByClass.textContent.trim();
    
    currentElement = currentElement.parentElement;
    attempts++;
}

let previousMessage = messageElement.closest('.fui-ChatMessage, [data-tid="chat-pane-message"]')?.previousElementSibling;
let prevAttempts = 0;
const maxPrevAttempts = 5;

while (previousMessage && prevAttempts < maxPrevAttempts) {
    const authorInPrev = previousMessage.querySelector('[data-tid="message-author-name"], [id^="author-"]');
    if (authorInPrev && authorInPrev.textContent.trim()) return authorInPrev.textContent.trim();
    previousMessage = previousMessage.previousElementSibling;
    prevAttempts++;
}

return 'غير معروف';
}

const TextAnalyzer = {
analyze(text) {
    const results = [];
    const regex = /\b((?:fr|du)\d+)\b/gi;
    let match;
    while ((match = regex.exec(text)) !== null) {
        results.push({
            value: match[1].toLowerCase(),
            original: match[1],
            position: match.index,
            length: match[0].length
        });
    }
    return results;
}
};

function exportFRs() {
try {
    const visibleRows = getVisibleRows();
    if (visibleRows.length === 0) {
        alert('❌ لا توجد بيانات مرئية للتصدير');
        return;
    }
    
    const rows = [];
    rows.push(['#', 'Case Number', 'المرسل', 'التاريخ', 'الوقت', 'الحالة', 'زمن المعالجة']);
    
    visibleRows.forEach((row, index) => {
        const frValue = row.cells[1]?.textContent || '';
        const sender = row.cells[2]?.textContent.replace('🚫 ', '').trim() || '';
        const date = row.cells[3]?.textContent || '';
        const time = row.cells[4]?.textContent || '';
        const status = row.cells[5]?.textContent || '';
        const processingTime = row.cells[6]?.textContent || '';
        
        rows.push([index + 1, frValue, sender, date, time, status, processingTime]);
    });
    
    const csvContent = rows.map(row => row.map(cell => `"${String(cell).replace(/"/g, '""')}"`).join(',')).join('\n');
    const blob = new Blob(['\uFEFF' + csvContent], {type: 'text/csv;charset=utf-8;'});
    const url = URL.createObjectURL(blob);
    const a = createElementSafe("a", { href: url, download: `requests_export_${new Date().toISOString().slice(0,10)}.csv` });
    a.click();
    URL.revokeObjectURL(url);
    console.log(`📥 تم تصدير ${rows.length - 1} طلب (مرئي) إلى CSV`);
} catch (e) {
    console.error('❌ خطأ في التصدير:', e);
}
}

function filterTable(searchText = '', filterType = 'الكل') {
