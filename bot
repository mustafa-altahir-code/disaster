function isUserBlocked(senderName) {
if (!senderName || senderName === 'غير معروف') return false;

if (state.blockedUsers.has(senderName)) return true;

const tempBlock = state.tempBlockedUsers.get(senderName);
if (tempBlock && tempBlock.until > Date.now()) return true;

if (tempBlock && tempBlock.until <= Date.now()) {
    state.tempBlockedUsers.delete(senderName);
    saveBlockedUsers();
    refreshBlockedUsersUI();
}

return false;
}

function tempBlockUser(senderName) {
const blockData = {
    username: senderName,
    until: Date.now() + CONFIG.tempBlockDuration,
    reason: 'تلقائي - أكثر من 10 طلبات في دقيقة',
    timestamp: new Date().toLocaleString()
};

state.tempBlockedUsers.set(senderName, blockData);
saveBlockedUsers();

showBlockNotification(senderName, 'تلقائي', '5 دقائق');
console.log(`🚫 حظر مؤقت للمستخدم ${senderName} لمدة 5 دقائق`);
refreshBlockedUsersUI();
}

function checkAutoTempBlock(senderName) {
if (!senderName || senderName === 'غير معروف') return;

const now = Date.now();
const userRequests = state.userRequestCounts.get(senderName) || [];

const recentRequests = userRequests.filter(time => now - time < CONFIG.tempBlockWindow);
recentRequests.push(now);
state.userRequestCounts.set(senderName, recentRequests);

if (recentRequests.length >= CONFIG.tempBlockThreshold) {
    if (!isUserBlocked(senderName)) {
        tempBlockUser(senderName);
        state.userRequestCounts.delete(senderName);
    }
}
}

function saveBlockedUsers() {
const blockedData = {};

state.blockedUsers.forEach((data, user) => {
    blockedData[user] = { ...data, permanent: true };
});

state.tempBlockedUsers.forEach((data, user) => {
    if (data.until > Date.now()) {
        blockedData[user] = { ...data, permanent: false };
    }
});

localStorage.setItem(CONFIG.blockedUsersKey, JSON.stringify(blockedData));
}

