function updateBlockButtonState() {
if (state.blockedUsers.size > 0 || state.tempBlockedUsers.size > 0) {
    blockBtn.style.opacity = '0.8';
    blockBtn.style.color = '#ef4444';
} else {
    blockBtn.style.opacity = '0.5';
    blockBtn.style.color = '#d1d5db';
}
}

function updatePauseButtonState() {
if (state.autoOpenPaused) {
    pauseBtn.classList.add('active');
    pauseBtn.innerHTML = '⏸️';
    const remaining = state.pauseUntil ? Math.max(0, Math.ceil((state.pauseUntil - Date.now()) / 1000 / 60)) : null;
    pauseBtn.title = remaining ? `متوقف - يستأنف بعد ${remaining} دقيقة (اضغط للإلغاء)` : 'الفتح التلقائي متوقف - اضغط للتشغيل';
} else {
