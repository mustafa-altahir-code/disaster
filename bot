async function autoReopenPendingRequests() {
if (state.pendingReopenRunning || state.randomOpenRunning || state.autoOpenPaused) return;
state.pendingReopenRunning = true;

try {
    const rows = Array.from(tbody.querySelectorAll('tr'));
    const pendingRows = rows.filter(row => row.cells[5]?.textContent.trim() === '⏳');
    if (!pendingRows.length) return;
    
    const now = Date.now();
    const rowsToOpen = pendingRows.filter(row => {
        const frValue = (row.cells[1]?.textContent || '').trim().toLowerCase();
        const senderName = (row.cells[2]?.textContent || '').replace('🚫 ', '').trim();
        
        if (isUserBlocked(senderName)) return false;
        
        const lastOpen = state.pendingReopenTracker.get(frValue) || 0;
        return (now - lastOpen) > 300000;
    });
    
    if (!rowsToOpen.length) return;
    console.log(`🔄 إعادة فتح ${rowsToOpen.length} طلب Pending`);
    
    for (const row of rowsToOpen) {
        const frValue = (row.cells[1]?.textContent || '').trim().toLowerCase();
        state.pendingReopenTracker.set(frValue, Date.now());
        openFRInBackground(frValue);
        console.log(`📌 Pending Reopen: ${frValue}`);
        await new Promise(resolve => setTimeout(resolve, 7000));
    }
} finally {
    state.pendingReopenRunning = false;
}
}

function openRandomFRsIfIdle() {
if (state.pendingReopenRunning || state.randomOpenRunning || state.autoOpenPaused) return;

const now = Date.now();
const idleTime = now - lastNewFRTime;

if (idleTime < 90000) return;

const rows = Array.from(tbody.querySelectorAll('tr'))
    .filter(r => !isUserBlocked((r.cells[2]?.textContent || '').replace('🚫 ', '').trim()));

if (rows.length === 0) return;

const shuffled = rows.sort(() => 0.5 - Math.random());
const selectedRows = shuffled.slice(0, Math.min(5, rows.length));

state.randomOpenRunning = true;
console.log(`🎲 فتح ${selectedRows.length} طلبًا عشوائيًا`);

selectedRows.forEach((row, index) => {
    setTimeout(() => {
        const frValue = (row.cells[1]?.textContent || '').trim().toLowerCase();
        openFRInBackground(frValue);
        console.log(`📌 فتح عشوائي: ${frValue}`);
    }, index * 7000);
});

setTimeout(() => {
    state.randomOpenRunning = false;
    lastNewFRTime = Date.now();
}, selectedRows.length * 7000 + 1000);
}

