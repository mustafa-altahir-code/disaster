}

function togglePauseState() {
state.autoOpenPaused = !state.autoOpenPaused;
state.pauseUntil = null;

if (state.autoOpenPaused) {
    startSuccessInterval();
    console.log('⏸️ تم إيقاف الفتح التلقائي - فتح طلبات ناجحة كل 5 ثواني');
} else {
    stopSuccessInterval();
    console.log('▶️ تم استئناف الفتح التلقائي');
}

updatePauseButtonState();
updateStats();
}

