/* ==================== نظام Chrome Storage ==================== */

function readSharedFile() {
return new Promise(resolve => {
    if (typeof chrome !== 'undefined' && chrome.storage) {
        chrome.storage.local.get(['fr_database'], result => resolve(result.fr_database || { frs: {}, lastUpdate: null }));
    } else {
        resolve({ frs: {}, lastUpdate: null });
    }
});
}

async function updateTableFromSharedFile() {
const db = await readSharedFile();
const frs = db.frs || {};
const rows = tbody.querySelectorAll('tr');
let updated = 0;

requestAnimationFrame(() => {
    rows.forEach(row => {
        const fr = row.cells[1]?.textContent;
        if (!fr) return;
        const frLower = fr.toLowerCase();
        const data = frs[frLower];
        const statusCell = row.cells[5];
        const timeCell = row.cells[6];
        
        if (data) {
            let icon = '';
            if (data.message === 'SUCCESS') icon = '✅';
            else if (data.message === 'FAILED') icon = '❌';
            else if (data.message === 'PENDING') icon = '⏳';
            else if (data.message === 'CLIENT_RETURN_FAILED') icon = '⚠️';
            
            if (statusCell.textContent !== icon) {
                statusCell.textContent = icon;
                statusCell.title = icon ? `${icon} ${data.timestamp || ''}` : '';
                updated++;
            }
            
            // عرض زمن المعالجة
            if (data.processingTimeFormatted) {
                if (timeCell) {
                    timeCell.textContent = data.processingTimeFormatted;
                    timeCell.title = `زمن المعالجة: ${data.processingTime} ثانية`;
                }
            } else if (data.processingTime) {
                const formatted = formatProcessingTimeDisplay(data.processingTime);
                if (timeCell) {
                    timeCell.textContent = formatted;
