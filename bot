function formatProcessingTimeDisplay(seconds) {
if (seconds < 60) {
    return `${seconds}ث`;
} else {
    const minutes = Math.floor(seconds / 60);
    const remainingSeconds = seconds % 60;
    return `${minutes}:${remainingSeconds.toString().padStart(2, '0')}د`;
}
}

