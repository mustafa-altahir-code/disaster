function processTextNode(textNode) {
if (state.processedNodes.has(textNode)) return;
const parent = textNode.parentNode;
if (!parent || parent.closest(".fr-badge") || (CONFIG.viewportOnly && !isElementInViewport(parent))) return;
if (isExcludedElement(parent)) return;

const teamsMessage = parent.closest('.fui-ChatMessage, [class*="message"], [data-tid="chat-pane-message"], .___1gzszts');
const text = textNode.textContent;
if (!text) return;

const matches = TextAnalyzer.analyze(text);
if (matches.length === 0) return;

let senderName = 'غير معروف';
let messageTime = null;

if (teamsMessage) {
    senderName = findSenderName(teamsMessage);
    messageTime = extractMessageTime(teamsMessage);
}

const fragment = document.createDocumentFragment();
let lastIndex = 0;

matches.sort((a, b) => a.position - b.position).forEach(match => {
    const value = match.value;
    
    if (lastIndex < match.position) {
        fragment.appendChild(document.createTextNode(text.slice(lastIndex, match.position)));
    }
    
    const existing = state.frsData.find(f => f.value === value);
    const status = existing?.message || 'PENDING';
    fragment.appendChild(createBadge(value, senderName, status));
    
    const now = Date.now();
    const lastSeen = state.lastSeenFRs.get(value) || 0;
    
    if (!state.extractedSet.has(value)) {
        state.extractedSet.add(value);
        addFRToTable(value, senderName, messageTime);
        checkAutoTempBlock(senderName);
    }
    
    if (!state.autoOpenPaused && (now - lastSeen) > CONFIG.requestCooldown && !isUserBlocked(senderName)) {
        state.lastSeenFRs.set(value, now);
        if (CONFIG.autoOpenTabs) {
            state.tabQueue.push({ value, senderName });
        }
    } else if (isUserBlocked(senderName)) {
        console.log(`🚫 تم منع الفتح التلقائي لـ ${value} - المستخدم ${senderName} محظور`);
    } else if (state.autoOpenPaused) {
        console.log(`⏸️ تم منع الفتح التلقائي لـ ${value} - الفتح متوقف`);
    }
    
    lastIndex = match.position + match.length;
});

if (lastIndex < text.length) {
    fragment.appendChild(document.createTextNode(text.slice(lastIndex)));
}

state.processedNodes.add(textNode);
parent.replaceChild(fragment, textNode);
}

function processElement(element) {
if (!element || element.nodeType !== 1 || element.closest(".fr-badge")) return;
if (["SCRIPT", "STYLE", "NOSCRIPT", "META", "LINK"].includes(element.tagName)) return;
if (isExcludedElement(element)) return;

const walker = document.createTreeWalker(element, NodeFilter.SHOW_TEXT, {
    acceptNode(node) {
        if (!node.textContent?.trim()) return NodeFilter.FILTER_REJECT;
        const p = node.parentNode;
        if (!p || p.closest(".fr-badge")) return NodeFilter.FILTER_REJECT;
        return NodeFilter.FILTER_ACCEPT;
    }
});

let node;
const nodesToProcess = [];
while ((node = walker.nextNode())) {
    nodesToProcess.push(node);
}
nodesToProcess.forEach(node => processTextNode(node));
}

