    background: linear-gradient(135deg, #f59e0b, #d97706);
    color: white;
    border: none;
    border-radius: 40px;
    padding: 10px 16px;
    cursor: pointer;
    font-size: 14px;
    font-weight: 600;
    flex: 1;
    transition: all 0.2s;
`;
confirmBtn.onmouseover = () => { confirmBtn.style.transform = 'translateY(-2px)'; };
confirmBtn.onmouseout = () => { confirmBtn.style.transform = 'none'; };

confirmBtn.onclick = () => {
    const minutes = parseInt(durationSelect.value);
    
    if (minutes === 0) {
        state.autoOpenPaused = true;
        state.pauseUntil = null;
    } else {
        state.autoOpenPaused = true;
        state.pauseUntil = Date.now() + minutes * 60 * 1000;
        
        setTimeout(() => {
            if (state.pauseUntil && Date.now() >= state.pauseUntil) {
                state.autoOpenPaused = false;
                state.pauseUntil = null;
                stopSuccessInterval();
                updatePauseButtonState();
                updateStats();
                console.log('▶️ تم استئناف الفتح التلقائي تلقائياً');
            }
        }, minutes * 60 * 1000);
    }
    
    startSuccessInterval();
    updatePauseButtonState();
    updateStats();
    console.log(`⏸️ تم إيقاف الفتح التلقائي${minutes > 0 ? ' لمدة ' + minutes + ' دقيقة' : ' حتى الإلغاء'}`);
