{
  "manifest_version": 3,
  "name": "Bot3.0",
  "description": "Transfer cases everywhere.",
  "version": "1.0",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://teams.cloud.microsoft/*",
    "https://ops.rer.sa/*",
    "https://ops-sso.rer.sa/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://teams.cloud.microsoft/*"],
      "js": ["teams-content.js"],
      "run_at": "document_idle"
    },
    {
      "matches": ["https://ops.rer.sa/*", "https://ops-sso.rer.sa/*"],
      "js": ["platform-content.js"],
      "run_at": "document_end"
    }
  ]
}
