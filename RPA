const MAX_RETRIES = 1;
const SUCCESS_TIMEOUT = 8000;
const LONG_TIMEOUT = 20000; // 20 ثانية
let currentFR = null;
let pageClosed = false;
let processStartTime = null; // وقت بدء معالجة الطلب

// ========================
// دوال مساعدة
// ========================

function extractFR() {
try {
// محاولة استخراج FR من الصفحة الحالية
const frElement = document.querySelector('#__next span.uppercase, [class*="fr"], [class*="FR"], .font-mono, code');
if (frElement) {
const frMatch = frElement.textContent?.match(/FR\d+/i);
if (frMatch) {
return frMatch[0].toLowerCase();
}
}

// محاولة من URL
const urlMatch = window.location.href.match(/FR\d+/i);
if (urlMatch) {
return urlMatch[0].toLowerCase();
}

return null;
} catch (err) {
console.error('❌ Error extracting FR:', err);
return null;
}
}

function updateFRData(fr, updates) {
return new Promise((resolve) => {
if (!fr || !fr.startsWith("fr")) { console.warn("❌ Invalid FR"); return resolve(); }
const frLower = fr.toLowerCase();

// إذا كان التحديث يحتوي على message (SUCCESS/FAILED) وكان لدينا وقت بدء
if ((updates.message === 'SUCCESS' || updates.message === 'FAILED' || updates.message === 'CLIENT_RETURN_FAILED') && processStartTime) {
const processingTime = Math.floor((Date.now() - processStartTime) / 1000);
updates.processingTime = processingTime;
updates.processingTimeFormatted = formatProcessingTime(processingTime);
console.log(`⏱️ زمن المعالجة لـ ${frLower}: ${updates.processingTimeFormatted}`);
}

if (typeof chrome !== 'undefined' && chrome.storage) {
chrome.storage.local.get(['fr_database'], (result) => {
let db = result.fr_database || { frs: {} };
db.frs[frLower] = { ...db.frs[frLower], fr: frLower, ...updates, timestamp: new Date().toLocaleString() };
db.lastUpdate = new Date().toISOString();
chrome.storage.local.set({ fr_database: db }, () => {
console.log(`💾 تم تحديث ${frLower}`, updates);
resolve();
});
});
} else {
const key = `FR_${frLower}`;
const existing = JSON.parse(localStorage.getItem(key) || '{}');
localStorage.setItem(key, JSON.stringify({ ...existing, ...updates, timestamp: new Date().toLocaleString() }));
resolve();
}
});
}

// دالة تنسيق زمن المعالجة
function formatProcessingTime(seconds) {
if (seconds < 60) {
return `${seconds}ث`;
} else {
const minutes = Math.floor(seconds / 60);
const remainingSeconds = seconds % 60;
return `${minutes}:${remainingSeconds.toString().padStart(2, '0')}د`;
}
}

function getFRData(fr) {
return new Promise((resolve) => {
const frLower = fr.toLowerCase();
if (typeof chrome !== 'undefined' && chrome.storage) {
chrome.storage.local.get(['fr_database'], (result) => {
resolve(result.fr_database?.frs?.[frLower] || null);
});
} else {
const key = `FR_${frLower}`;
const data = localStorage.getItem(key);
resolve(data ? JSON.parse(data) : null);
}
});
}

// دالة انتظار العناصر
function waitForElement(selector, timeout = LONG_TIMEOUT) {
return new Promise((resolve) => {
const startTime = Date.now();
const interval = setInterval(() => {
const el = document.querySelector(selector);
if (el) {
clearInterval(interval);
resolve(el);
} else if (Date.now() - startTime > timeout) {
clearInterval(interval);
console.warn(`⚠️ لم يتم العثور على "${selector}" بعد ${timeout}ms`);
resolve(null);
}
}, 300);
});
}

function delay(ms) {
return new Promise(res => setTimeout(res, ms));
}

function checkForUnauthorized() {
const bodyText = document.body.innerText || '';
const htmlText = document.body.innerHTML || '';
const accessDeniedBox = document.querySelector('.flex.justify-between.w-full.p-5');
const keywords = [
'غير مصرح',
'الصلاحية',
'Authorized',
'You are not authorized to claim the case',
'ليس لديك صلاحية',
'لا تملك الصلاحية',
'رفض الوصول',
'تم رفض الوصول',
'403 Forbidden',
'Access Denied'
];

const hasAccessDeniedBox = [...document.querySelectorAll('p')]
.some(p => p.textContent.trim() === 'تم رفض الوصول');

return (
keywords.some(k => bodyText.includes(k) || htmlText.includes(k))
|| hasAccessDeniedBox
);
}

async function closeTabSafely() {
try {
if (typeof chrome !== 'undefined' && chrome.runtime) chrome.runtime.sendMessage({ action: "closeTab" });
else window.close();
setTimeout(() => { if (!pageClosed) window.close(); }, 500);
} catch (e) { window.close(); }
}

async function checkAndCloseIfUnauthorized(stepName = '', fr = null) {
if (pageClosed) return true;
if (checkForUnauthorized()) {
console.log(`❌ منع وصول في ${stepName}`);
const frToSave = fr || currentFR;
if (frToSave) await updateFRData(frToSave, { message: "SUCCESS", retryCount: 0 });
pageClosed = true;
await delay(500);
await closeTabSafely();
return true;
}
return false;
}

function createTimer() {
const el = document.createElement('div');
el.id = 'global-timer';

el.style = `
position: fixed;
top: 10px;
left: 10px;
background: black;
color: lime;
padding: 8px 12px;
font-size: 14px;
z-index: 999999;
border-radius: 6px;
font-family: monospace;
`;

document.body.appendChild(el);

const start = performance.now();

setInterval(() => {
const sec = ((performance.now() - start) / 1000).toFixed(2);
el.innerText = `⏱ ${sec}s`;
}, 100);
}

