// ========================
// platform-content.js - النسخة النهائية (إغلاق فوري بعد ثانية من المتابعة)
// ========================

const LONG_TIMEOUT = 20000;
let currentFR = null;
let pageClosed = false;
let processStartTime = null;

// ========================
// دوال مساعدة
// ========================

function extractFR() {
  try {
    const el = document.querySelector('#__next span.uppercase, [class*="fr"], [class*="FR"], [class*="du"], [class*="DU"], .font-mono, code');
    if (el) {
      const match = el.textContent?.match(/(?:FR|DU)\d+/i);
      if (match) return match[0].toLowerCase();
    }

    const urlMatch = window.location.href.match(/(?:FR|DU)\d+/i);
    if (urlMatch) return urlMatch[0].toLowerCase();

    return null;
  } catch (err) {
    console.error('❌ Error extracting Case ID:', err);
    return null;
  }
}

function updateFRData(fr, updates) {
  return new Promise((resolve) => {
    if (!fr) return resolve();
    const frLower = fr.toLowerCase();
    if (!frLower.startsWith("fr") && !frLower.startsWith("du")) {
      console.warn("❌ Invalid Case ID");
      return resolve();
    }

    if ((updates.message === 'SUCCESS' || updates.message === 'FAILED' || updates.message === 'CLIENT_RETURN_FAILED') && processStartTime) {
      const processingTime = Math.floor((Date.now() - processStartTime) / 1000);
      updates.processingTime = processingTime;
      updates.processingTimeFormatted = formatProcessingTime(processingTime);
      console.log(`⏱️ زمن المعالجة لـ ${frLower}: ${updates.processingTimeFormatted}`);
    }

    if (typeof chrome !== 'undefined' && chrome.storage) {
      chrome.storage.local.get(['fr_database'], (result) => {
        let db = result.fr_database || { frs: {} };
        db.frs[frLower] = { ...db.frs[frLower], fr: frLower, ...updates, timestamp: new Date().toLocaleString() };
        db.lastUpdate = new Date().toISOString();
        chrome.storage.local.set({ fr_database: db }, () => {
          console.log(`💾 تم تحديث ${frLower}`, updates);
          resolve();
        });
      });
    } else {
      const key = `REQ_${frLower}`;
      const existing = JSON.parse(localStorage.getItem(key) || '{}');
      localStorage.setItem(key, JSON.stringify({ ...existing, ...updates, timestamp: new Date().toLocaleString() }));
      resolve();
    }
  });
}

function formatProcessingTime(seconds) {
  if (seconds < 60) {
    return `${seconds}ث`;
  } else {
    const minutes = Math.floor(seconds / 60);
    const remainingSeconds = seconds % 60;
    return `${minutes}:${remainingSeconds.toString().padStart(2, '0')}د`;
  }
}

function delay(ms) {
  return new Promise(res => setTimeout(res, ms));
}

function checkForUnauthorized() {
  const bodyText = document.body.innerText || '';
  const htmlText = document.body.innerHTML || '';
  const keywords = [
    'غير مصرح', 'الصلاحية', 'Authorized', 'You are not authorized to claim the case',
    'ليس لديك صلاحية', 'لا تملك الصلاحية', 'رفض الوصول', 'تم رفض الوصول',
    '403 Forbidden', 'Access Denied'
  ];

  const hasAccessDeniedBox = [...document.querySelectorAll('p')]
    .some(p => p.textContent.trim() === 'تم رفض الوصول');

  return (keywords.some(k => bodyText.includes(k) || htmlText.includes(k)) || hasAccessDeniedBox);
}

async function closeTabSafely() {
  try {
    if (typeof chrome !== 'undefined' && chrome.runtime) chrome.runtime.sendMessage({ action: "closeTab" });
    else window.close();
    setTimeout(() => { if (!pageClosed) window.close(); }, 500);
  } catch (e) { window.close(); }
}

async function checkAndCloseIfUnauthorized(stepName = '', fr = null) {
  if (pageClosed) return true;
  if (checkForUnauthorized()) {
    console.log(`❌ منع وصول في ${stepName}`);
    const frToSave = fr || currentFR;
    if (frToSave) await updateFRData(frToSave, { message: "SUCCESS", retryCount: 0 });
    pageClosed = true;
    await delay(500);
    await closeTabSafely();
    return true;
  }
  return false;
}

function createTimer() {
  const el = document.createElement('div');
  el.id = 'global-timer';
  el.style = `
    position: fixed;
    top: 10px;
    left: 10px;
    background: black;
    color: lime;
    padding: 8px 12px;
    font-size: 14px;
    z-index: 999999;
    border-radius: 6px;
    font-family: monospace;
  `;
  document.body.appendChild(el);
  const start = performance.now();
  setInterval(() => {
    const sec = ((performance.now() - start) / 1000).toFixed(2);
    el.innerText = `⏱ ${sec}s`;
  }, 100);
}

// ========================
// Step 2 - تحميل الطلبات على نفس القطعة
// ========================

async function step2_clickLoadSamePiece() {
  try {
    const timeout = 6000;
    const interval = 400;

    console.log('⏳ انتظار زر Step2 أو Step3...');

    for (let elapsed = 0; elapsed < timeout; elapsed += interval) {
      if (await checkAndCloseIfUnauthorized('Step2 wait', currentFR)) return false;

      const loadBtn = [...document.querySelectorAll('button')]
        .find(b => b.textContent?.trim() === 'تحميل الطلبات على نفس القطعة');

      const processBtn = [...document.querySelectorAll('button')]
        .find(b => b.textContent?.trim() === 'المعالجة');

      if (loadBtn) {
        console.log('✅ تم العثور على زر Step2');
        loadBtn.click();
        await delay(250);
        return true;
      }

      if (processBtn) {
        console.log('⏭️ تخطي Step2 → زر Step3 موجود');
        return true;
      }

      await delay(interval);
    }

    console.log('✅ لا يوجد زر تحميل أو معالجة → اعتبر Success');
    if (currentFR) {
      await updateFRData(currentFR, {
        message: "SUCCESS",
        retryCount: 0,
        status: "مكتمل - لا يحتاج معالجة"
      });
    }

    await delay(500);
    await closeTabSafely();
    pageClosed = true;
    return false;

  } catch (err) {
    console.error('❌ Step2 error:', err);
    return false;
  }
}

// ========================
// Step 3 - المعالجة مع بدء حساب الوقت
// ========================

async function step3_clickProcess() {
  try {
    processStartTime = Date.now();
    console.log(`⏱️ بدء معالجة الطلب ${currentFR} في ${new Date(processStartTime).toLocaleTimeString()}`);

    const processBtn = [...document.querySelectorAll('button')]
      .find(b => b.textContent?.trim() === 'المعالجة');

    if (processBtn) {
      console.log('✅ تم العثور على زر المعالجة');
      processBtn.click();
      await checkAndCloseIfUnauthorized('Step3', currentFR);
      return true;
    }

    const fallbackSelector = '#__next > div > div.w-full.p-8.transition-all.duration-700 > div > div.mt-12 > div.flex.justify-between.items-center > div.flex.justify-between.items-center > div > div > button';
    const fallbackBtn = document.querySelector(fallbackSelector);

    if (fallbackBtn) {
      console.log('✅ تم العثور على الزر البديل - استمرار العملية');
      return true;
    }

    console.log('✅ لا يوجد زر معالجة ولا زر بديل → اعتبر Success');
    if (currentFR) {
      await updateFRData(currentFR, {
        message: "SUCCESS",
        retryCount: 0,
        status: "مكتمل - لا يحتاج معالجة"
      });
    }

    await delay(500);
    await closeTabSafely();
    pageClosed = true;
    return false;

  } catch (err) {
    console.error('❌ Step3 error:', err);
    return false;
  }
}

// ========================
// Step 4 - الأسهم (بدون سكرول)
// ========================

async function step4_clickArrowFast(maxClicks = 6, interval = 120) {
  console.log(`🔎 البدء بالنقر على الأسهم (بحد أقصى ${maxClicks} نقرات)...`);
  let clicked = 0;
  let emptyRetries = 0;

  while (clicked < maxClicks) {
    if (await checkAndCloseIfUnauthorized(`Step4 click ${clicked}`, currentFR)) return;

    const img = document.querySelector('button img[src$="left.svg"]');
    if (!img) {
      emptyRetries++;
      if (emptyRetries >= 3) {
        console.log("✅ اختفى السهم تماماً - الانتقال للخطوة التالية");
        break;
      }
      await delay(250);
      continue;
    }

    emptyRetries = 0;
    const btn = img.closest("button");

    if (btn) {
      try {
        btn.dispatchEvent(new MouseEvent("click", { bubbles: true, cancelable: true, view: window }));
        clicked++;
        console.log(`🔘 Arrow click ${clicked}/${maxClicks} ✅`);
      } catch (e) {
        console.error("❌ Click error:", e);
      }
    }

    await delay(interval);
  }

  console.log(`✅ انتهى الضغط على الأسهم (${clicked} نقرة)`);
}

// ========================
// Step 5 - اختيار القوائم
// ========================

function pressKey(el, key) {
  el.dispatchEvent(new KeyboardEvent('keydown', { key, code: key, bubbles: true }));
}

async function selectBothMenusFast() {
  try {
    console.log('🚀 Step5: بدء اختيار القوائم');
    const dropdowns = document.querySelectorAll('.drop-down-box.css-b62m3t-container');
    if (!dropdowns.length) throw new Error('❌ لم يتم العثور على القوائم');

    // القائمة الأولى
    const actionMenu = dropdowns[0];
    const control = actionMenu.querySelector('input, [role="combobox"], .css-8mjqw9-control');
    if (!control) throw new Error('❌ control غير موجود');

    control.focus();
    await delay(60);
    pressKey(control, 'ArrowDown');
    await delay(60);
    pressKey(control, 'Enter');
    console.log('✅ Step5: اختيار -> تعيين الطلب للمشرف الجيومكاني');

    await delay(400);

    // القائمة الثانية
    const arrow = document.querySelector('svg.css-8mmkcg');
    if (!arrow) throw new Error('❌ سهم القائمة الثانية غير موجود');

    const parent = arrow.closest('div, button, span') || arrow;
    parent.dispatchEvent(new MouseEvent('mousedown', { bubbles: true }));
    parent.click();

    await delay(250);

    const options = [...document.querySelectorAll('[id*="react-select"][id*="option"]')];
    if (!options.length) throw new Error('❌ لا توجد خيارات في القائمة الثانية');

    const first = options[0];
    first.dispatchEvent(new MouseEvent('mousedown', { bubbles: true }));
    first.click();
    console.log('✅ Step5: تم اختيار أول مشرف بنجاح');

  } catch (err) {
    console.error('❌ Step5 error:', err);
  }
}

// ========================
// Step 6 & 7 - النقر على المتابعة ثم الإغلاق بعد ثانية
// ========================

async function step6_clickFinalButtonAndClose() {
  try {
    if (await checkAndCloseIfUnauthorized('Step6 before search', currentFR)) return;

    const btn = [...document.querySelectorAll('button')]
      .find(b => b.textContent?.trim() === 'المتابعة');

    if (!btn) throw new Error('زر المتابعة غير موجود');

    btn.click();
    console.log('✅ Step6 clicked (المتابعة)');

    // اعتماد الحالة SUCCESS مباشرة وتحديث زمن المعالجة
    const frValue = currentFR || extractFR();
    if (frValue) {
      await updateFRData(frValue, {
        message: "SUCCESS",
        retryCount: 0
      });
      console.log(`✅ تم تسجيل الطلب ${frValue} كـ SUCCESS بنجاح`);
    }

    // الانتظار ثانية واحدة (1000ms) لإتمام طلب الشبكة ثم إغلاق التبويب
    console.log('⏱️ جاري إغلاق التبويب بعد ثانية واحدة...');
    await delay(1000);

    pageClosed = true;
    await closeTabSafely();

  } catch (err) {
    console.error('❌ Step6 error:', err);
  }
}

// ========================
// المحرك الرئيسي
// ========================

async function runProcess() {
  currentFR = extractFR();
  console.log(`📌 الطلب الحالي: ${currentFR}`);

  const step2Success = await step2_clickLoadSamePiece();
  if (pageClosed || !step2Success) return;

  const step3Success = await step3_clickProcess();
  if (pageClosed || !step3Success) return;

  await delay(200);

  // تشغيل الأسهم بالنظام السريع
  await step4_clickArrowFast(6, 120);
  if (pageClosed) return;

  await delay(400);

  await selectBothMenusFast();
  if (pageClosed) return;

  await delay(300);

  // النقر على المتابعة والتسجيل والإغلاق بعد ثانية
  await step6_clickFinalButtonAndClose();
}

// ========================
// بدء التشغيل
// ========================

(async () => {
  createTimer();

  if (checkForUnauthorized()) {
    console.log('❌ منع وصول في البداية');
    const frToSave = currentFR || extractFR();
    if (frToSave) await updateFRData(frToSave, { message: "SUCCESS", retryCount: 0 });
    await delay(500);
    await closeTabSafely();
    return;
  }

  runProcess();

  setInterval(async () => {
    if (checkForUnauthorized()) {
      console.log('❌ منع وصول - إعادة تحميل');
      location.reload();
    }
  }, 2000);
})();

window.showSharedFile = () => { if (chrome?.storage) chrome.storage.local.get('fr_database', r => console.log(r)); };
window.clearSharedFile = () => { if (chrome?.storage) chrome.storage.local.remove('fr_database', () => console.log('🗑️ Cleared')); };
