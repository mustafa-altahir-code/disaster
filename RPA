// ========================
// Step 7 - انتظار النتيجة وإغلاق التبويب
// ========================

async function step7_closeTab() {
try {
console.log('🛑 Waiting for success...');
const target = 'تم تقديم الطلب';
const timeout = SUCCESS_TIMEOUT;
const baseInterval = 300;
const start = Date.now();
let detected = false;

// استخراج FR من الصفحة الحالية إذا لم يكن موجوداً
if (!currentFR) {
currentFR = extractFR();
}

const frValue = currentFR;

while (Date.now() - start < timeout && !pageClosed) {
const paras = document.querySelectorAll('p');
for (const p of paras) {
if (p.textContent.trim() === target) { detected = true; break; }
}

if (await checkAndCloseIfUnauthorized('Step7 wait', frValue)) return;

if (detected) break;

await delay(baseInterval);
}

if (pageClosed) return;
if (!frValue) { console.warn("FR not found"); return; }

const current = await getFRData(frValue);
const retryCount = current?.retryCount || 0;

if (detected) {
console.log("✅ SUCCESS");
await updateFRData(frValue, {
message: "SUCCESS",
retryCount: 0
});
} else {
console.warn("❌ FAILED");

const statusElement = document.querySelector('[class*="status"], [class*="حالة"], .bg-\\#BF524D1A, .bg-lightBlue');
const statusText = statusElement?.textContent?.trim() || '';

const isReturnedFromClient = statusText.includes('معادة من العميل');

if (isReturnedFromClient) {
console.warn(`⚠️ ${frValue} فشل وهو معاد من العميل`);
await updateFRData(frValue, {
status: statusText,
message: "CLIENT_RETURN_FAILED",
flag: "⚠️",
retryCount: 0
});
} else if (retryCount < MAX_RETRIES) {
await updateFRData(frValue, {
message: "PENDING",
retryCount: retryCount + 1
});
if (chrome?.runtime)
chrome.runtime.sendMessage({ action: "retryFR", fr: frValue, delay: 5000 });
else
setTimeout(() => window.open(`https://ops.rer.sa/?q=${frValue}+&filteredGraph=all`), 5000);
} else {
await updateFRData(frValue, {
message: "FAILED",
retryCount
});
}
}

await delay(500);

if (chrome?.runtime)
chrome.runtime.sendMessage({ action: "closeTab" });
else
window.close();

} catch (err) {
console.error('❌ Step7 error:', err);
}
}

