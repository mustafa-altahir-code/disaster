async function step4_clickArrow7Times(clicks = 10, baseInterval = 350) {
console.log(`🛠️ Step4: بدء الضغط على الأسهم (الحد الأقصى ${clicks} مرات)`);

let clickedCount = 0;
for (let i = 1; i <= clicks; i++) {
if (await checkAndCloseIfUnauthorized(`Step4 before ${i}`, currentFR)) return;

const btn = document.querySelector('button img[src$="left.svg"]')?.closest('button');

if (!btn) {
console.log(`✅ لا يوجد سهم إضافي (الضغط ${i}/${clicks}) - الانتقال للخطوة التالية`);
break;
}

btn.dispatchEvent(new MouseEvent('click', { bubbles: true }));
clickedCount++;
console.log(`🔘 Arrow ${clickedCount}/${clicks} ✅`);

await delay(Math.max(120, baseInterval));

if (await checkAndCloseIfUnauthorized(`Step4 after ${i}`, currentFR)) return;
}

console.log(`✅ Step4 done - تم الضغط ${clickedCount} مرات`);
}

