// ========================
// platform-content.js - النسخة الهادئة مع إشعار تقرير ملخص قبل الإغلاق
// ========================

let currentFR = null;
let pageClosed = false;
let processStartTime = null;

function delay(ms) {
  return new Promise(res => setTimeout(res, ms));
}

// ========================
// نافذة الإشعار والتقرير الملخص قبل الإغلاق
// ========================

function showSummaryToast(title, caseId, statusText, durationSec = 2) {
  const toast = document.createElement('div');
  toast.id = 'case-summary-toast';
  
  const processingTime = processStartTime 
    ? `${Math.floor((Date.now() - processStartTime) / 1000)}s` 
    : '-';

  toast.style = `
    position: fixed;
    top: 24px;
    right: 24px;
    background: linear-gradient(145deg, #1e293b, #0f172a);
    color: #f8fafc;
    border: 2px solid #38bdf8;
    border-radius: 16px;
    padding: 16px 24px;
    font-size: 13px;
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    z-index: 999999999;
    box-shadow: 0 20px 35px -5px rgba(0, 0, 0, 0.7), 0 0 15px rgba(56, 189, 248, 0.3);
    direction: rtl;
    min-width: 280px;
    animation: toastSlideIn 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  `;

  toast.innerHTML = `
    <div style="display: flex; align-items: center; gap: 8px; margin-bottom: 8px;">
      <span style="font-size: 18px;">📋</span>
      <strong style="color: #38bdf8; font-size: 15px;">${title}</strong>
    </div>
    <div style="display: flex; flex-direction: column; gap: 4px; color: #cbd5e1; font-size: 12px;">
      <div>🆔 <b>الطلب:</b> <span style="color: #facc15; font-family: monospace; font-size: 13px;">${(caseId || 'غير معروف').toUpperCase()}</span></div>
      <div>📌 <b>الحالة:</b> <span style="color: #4ade80;">${statusText}</span></div>
      <div>⏱️ <b>زمن المعالجة:</b> <span style="color: #94a3b8;">${processingTime}</span></div>
    </div>
    <div style="margin-top: 10px; font-size: 11px; color: #64748b; text-align: left; font-family: monospace;">
      Closing in ${durationSec}s...
    </div>
  `;

  const styleSheet = document.createElement("style");
  styleSheet.textContent = `
    @keyframes toastSlideIn {
      from { transform: translateX(120%); opacity: 0; }
      to { transform: translateX(0); opacity: 1; }
    }
  `;
  document.head.appendChild(styleSheet);
  document.body.appendChild(toast);
}

// دالة إغلاق مهدأة تظهر التقرير لمدة ثانيتين
async function closeTabWithSummary(title, caseId, statusText) {
  if (pageClosed) return;
  pageClosed = true;

  showSummaryToast(title, caseId, statusText, 2);
  await delay(2000); // عرض التقرير لمدة ثانيتين كاملتين

  if (typeof chrome !== 'undefined' && chrome.runtime) {
    chrome.runtime.sendMessage({ action: "closeTab" });
  } else {
    window.close();
  }
}

// دالة انتظار معتدلة
function waitForCondition(checkFn, timeout = 5000) {
  return new Promise((resolve) => {
    const start = Date.now();
    const interval = setInterval(() => {
      if (pageClosed) {
        clearInterval(interval);
        return resolve(null);
      }
      const res = checkFn();
      if (res) {
        clearInterval(interval);
        return resolve(res);
      }
      if (Date.now() - start > timeout) {
        clearInterval(interval);
        return resolve(null);
      }
    }, 100);
  });
}

function extractFR() {
  try {
    const urlMatch = window.location.href.match(/(?:FR|DU)\d+/i);
    if (urlMatch) return urlMatch[0].toLowerCase();

    const el = document.querySelector('#__next span.uppercase, [class*="fr"], [class*="du"], .font-mono, code');
    if (el) {
      const match = el.textContent?.match(/(?:FR|DU)\d+/i);
      if (match) return match[0].toLowerCase();
    }
    return null;
  } catch {
    return null;
  }
}

function updateFRData(fr, updates) {
  return new Promise((resolve) => {
    if (!fr) return resolve();
    const frLower = fr.toLowerCase();

    if ((updates.message === 'SUCCESS' || updates.message === 'FAILED') && processStartTime) {
      const processingTime = Math.floor((Date.now() - processStartTime) / 1000);
      updates.processingTime = processingTime;
      updates.processingTimeFormatted = processingTime < 60 
        ? `${processingTime}ث` 
        : `${Math.floor(processingTime / 60)}:${(processingTime % 60).toString().padStart(2, '0')}د`;
    }

    if (typeof chrome !== 'undefined' && chrome.storage) {
      chrome.storage.local.get(['fr_database'], (result) => {
        let db = result.fr_database || { frs: {} };
        db.frs[frLower] = { ...db.frs[frLower], fr: frLower, ...updates, timestamp: new Date().toLocaleString() };
        db.lastUpdate = new Date().toISOString();
        chrome.storage.local.set({ fr_database: db }, () => resolve());
      });
    } else {
      const key = `REQ_${frLower}`;
      const existing = JSON.parse(localStorage.getItem(key) || '{}');
      localStorage.setItem(key, JSON.stringify({ ...existing, ...updates, timestamp: new Date().toLocaleString() }));
      resolve();
    }
  });
}

function fastCheckUnauthorized() {
  const alertBox = document.querySelector('.flex.justify-between.w-full.p-5, [role="alert"]');
  if (alertBox) {
    const text = alertBox.textContent || '';
    if (
      text.includes('رفض') || 
      text.includes('صلاحية') || 
      text.includes('Authorized') || 
      text.includes('مصرح') ||
      text.includes('403') ||
      text.includes('Denied')
    ) {
      return true;
    }
  }
  return false;
}

function findProcessButton() {
  const buttons = document.querySelectorAll('button');
  for (let i = 0; i < buttons.length; i++) {
    const txt = buttons[i].textContent?.trim().toUpperCase() || '';
    if (txt === 'المعالجة' || txt === 'CLAIM' || txt.includes('CLAIM') || txt.includes('المعالجة')) {
      return buttons[i];
    }
  }
  return null;
}

function findLoadButton() {
  const buttons = document.querySelectorAll('button, a[role="button"]');
  for (let i = 0; i < buttons.length; i++) {
    const txt = buttons[i].textContent?.trim().toUpperCase() || '';
    if (
      txt.includes('LOAD REQUESTS') ||
      txt.includes('LOAD CASES') ||
      txt.includes('LOAD REQUEST') ||
      txt.includes('تحميل الطلبات') ||
      txt.includes('تحميل')
    ) {
      return buttons[i];
    }
  }
  return null;
}

// ========================
// الخطوة 1: التحميل والتحقق من العمود السادس
// ========================

async function step1_loadAndVerifyAuditorStatus() {
  await delay(800);

  if (fastCheckUnauthorized()) {
    const fr = currentFR || extractFR();
    if (fr) await updateFRData(fr, { message: "SUCCESS", retryCount: 0 });
    await closeTabWithSummary('منع وصول / صلاحية', fr, 'غير مصرح أو مسحوب');
    return false;
  }

  // 1. الضغط على زر التحميل إذا وُجد
  const loadBtn = findLoadButton();
  if (loadBtn) {
    loadBtn.click();
    await delay(1200); // مهلة هادئة لتحميل محتوى الجدول
  }

  // 2. فحص حالة الطلب في الجدول
  const matchedRow = await waitForCondition(() => {
    const rows = document.querySelectorAll('table tbody tr, [role="row"]');
    if (!rows.length) return null;
    for (let i = 0; i < rows.length; i++) {
      if (currentFR && rows[i].textContent?.toLowerCase().includes(currentFR.toLowerCase())) {
        return rows[i];
      }
    }
    return null;
  }, 4000);

  if (matchedRow) {
    const col6 = matchedRow.querySelector('td:nth-child(6), [role="cell"]:nth-child(6)') || matchedRow.children[5];

    if (col6) {
      const statusText = col6.textContent?.trim() || '';
      const statusUpper = statusText.toUpperCase();

      const isGeospatialAuditor = 
        statusUpper.includes('مدقق جيومكاني') ||
        statusUpper.includes('المدقق الجيومكاني') ||
        statusUpper.includes('GEOSPATIAL SPECIALIST') ||
        statusUpper.includes('GEOSPATIAL AUDITOR') ||
        statusUpper.includes('GEOSPATIAL REVIEWER') ||
        statusUpper.includes('SPECIALIST') ||
        statusUpper.includes('AUDITOR') ||
        statusUpper.includes('مدقق');

      // إذا لم يكن عند المدقق -> يكتمل كـ SUCCESS ويقفل مع التقرير
      if (!isGeospatialAuditor && statusUpper.length > 0) {
        if (currentFR) {
          await updateFRData(currentFR, {
            message: "SUCCESS",
            retryCount: 0,
            status: statusText
          });
        }
        await closeTabWithSummary('تقرير: مكتمل لا يحتاج تدقيق', currentFR, statusText);
        return false;
      }
    }
  }

  // 3. الضغط على المعالجة/CLAIM إن وجد
  const processBtn = findProcessButton();
  if (processBtn) {
    processStartTime = Date.now();
    processBtn.click();
    await delay(800);
  }

  return true;
}

// ========================
// الخطوة 2: الانتقال لتبويب المراجعة
// ========================

function findReviewTab() {
  const directSelector = document.querySelector(
    'div.mt-10.mb-10 div.flex.items-center.justify-center > div.cursor-pointer:nth-of-type(6)'
  );
  if (directSelector) return directSelector;

  const elements = document.querySelectorAll('div.cursor-pointer, button, span.cursor-pointer');
  for (let i = 0; i < elements.length; i++) {
    const txt = elements[i].textContent?.trim().toUpperCase() || '';
    if (txt === 'المراجعة' || txt === 'REVIEW') {
      return elements[i];
    }
  }
  return null;
}

async function step2_navigateToReview() {
  await delay(600);

  const reviewTab = findReviewTab();
  if (reviewTab) {
    reviewTab.dispatchEvent(new MouseEvent('mousedown', { bubbles: true }));
    reviewTab.click();

    const reached = await waitForCondition(() => {
      return document.querySelector('.drop-down-box, [class*="drop-down-box"], svg.css-8mmkcg');
    }, 1500);

    if (reached) return true;
  }

  // Fallback بالأسهم بهدوء وثبات (400ms بين كل نقرة)
  let clicked = 0;
  while (clicked < 6 && !pageClosed) {
    const img = document.querySelector('button img[src$="left.svg"]');
    if (!img) break;

    const btn = img.closest('button');
    if (btn) {
      btn.dispatchEvent(new MouseEvent('click', { bubbles: true, cancelable: true, view: window }));
      clicked++;
    }
    await delay(400);
  }

  return true;
}

// ========================
// الخطوة 3: اختيار المشرف الجيومكاني
// ========================

function pressKey(el, key) {
  el.dispatchEvent(new KeyboardEvent('keydown', { key, code: key, bubbles: true }));
}

async function step3_selectSupervisor() {
  await delay(700);

  const targetDropdown = await waitForCondition(() => {
    const directOpt = document.querySelector('#react-select-2-option-0, [id*="react-select"][id*="option"]');
    if (directOpt) return directOpt;

    const dropdowns = document.querySelectorAll('.drop-down-box.css-b62m3t-container, [class*="drop-down-box"]');
    if (dropdowns.length > 0) return dropdowns[dropdowns.length - 1];

    const arrow = document.querySelector('svg.css-8mmkcg, .drop-down-box svg');
    if (arrow) return arrow;

    return null;
  }, 4000);

  if (!targetDropdown) return;

  // خيار مباشر
  if (targetDropdown.id && targetDropdown.id.includes('option')) {
    targetDropdown.dispatchEvent(new MouseEvent('mousedown', { bubbles: true }));
    targetDropdown.click();
    await delay(500);
    return;
  }

  // لوحة المفاتيح
  const control = targetDropdown.querySelector?.('input, [role="combobox"], .css-8mjqw9-control, [class*="control"]');
  if (control) {
    control.focus();
    await delay(200);
    pressKey(control, 'ArrowDown');
    await delay(200);
    pressKey(control, 'Enter');
    await delay(500);
    return;
  }

  // الضغط على سهم الـ Dropdown
  const arrow = targetDropdown.tagName === 'svg' ? targetDropdown : targetDropdown.querySelector?.('svg');
  if (arrow) {
    const parent = arrow.closest('div, button, span') || arrow;
    parent.dispatchEvent(new MouseEvent('mousedown', { bubbles: true }));
    parent.click();
    await delay(400);

    const opt = await waitForCondition(() => {
      const opts = document.querySelectorAll('[id*="react-select"][id*="option"]');
      if (!opts.length) return null;
      return Array.from(opts).find(o => o.innerText.toUpperCase().includes('GEOSPATIAL')) || opts[0];
    }, 2000);

    if (opt) {
      opt.dispatchEvent(new MouseEvent('mousedown', { bubbles: true }));
      opt.click();
      await delay(500);
    }
  }
}

// ========================
// الخطوة 4: المتابعة / Proceed ثم عرض التقرير والإغلاق
// ========================

async function step4_clickProceed() {
  await delay(600);

  const proceedBtn = await waitForCondition(() => {
    const buttons = document.querySelectorAll('button');
    for (let i = 0; i < buttons.length; i++) {
      const txt = buttons[i].textContent?.trim().toUpperCase() || '';
      if (txt === 'المتابعة' || txt === 'PROCEED' || txt.includes('PROCEED') || txt.includes('المتابعة')) {
        return buttons[i];
      }
    }
    return null;
  }, 3000);

  if (proceedBtn) {
    proceedBtn.click();

    const frValue = currentFR || extractFR();
    if (frValue) {
      await updateFRData(frValue, { message: "SUCCESS", retryCount: 0 });
    }

    // عرض التقرير الصغير لمدة ثانيتين ثم إغلاق التبويب
    await closeTabWithSummary('تم تعيين الطلب بنجاح ✅', frValue, 'ASSIGNED TO SUPERVISOR');
  }
}

// ========================
// المحرك الرئيسي
// ========================

async function runProcess() {
  await delay(600);
  currentFR = extractFR();

  // 1. فحص التحميل وحالة المدقق
  const canContinue = await step1_loadAndVerifyAuditorStatus();
  if (!canContinue || pageClosed) return;

  // 2. الوصول لتبويب المراجعة
  await step2_navigateToReview();
  if (pageClosed) return;

  // 3. اختيار المشرف
  await step3_selectSupervisor();
  if (pageClosed) return;

  // 4. المتابعة وعرض التقرير لمدة ثانيتين ثم الإغلاق
  await step4_clickProceed();
}

runProcess();
