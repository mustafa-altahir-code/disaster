// ========================
// platform-content.js - ثنائي اللغة (AR/EN) + تخطي قائمة Action
// ========================

let currentFR = null;
let pageClosed = false;
let processStartTime = null;

// ========================
// دوال مساعدة
// ========================

function extractFR() {
  try {
    const urlMatch = window.location.href.match(/(?:FR|DU)\d+/i);
    if (urlMatch) return urlMatch[0].toLowerCase();

    const el = document.querySelector('#__next span.uppercase, [class*="fr"], [class*="du"], .font-mono, code');
    if (el) {
      const match = el.textContent?.match(/(?:FR|DU)\d+/i);
      if (match) return match[0].toLowerCase();
    }
    return null;
  } catch {
    return null;
  }
}

function updateFRData(fr, updates) {
  return new Promise((resolve) => {
    if (!fr) return resolve();
    const frLower = fr.toLowerCase();

    if ((updates.message === 'SUCCESS' || updates.message === 'FAILED') && processStartTime) {
      const processingTime = Math.floor((Date.now() - processStartTime) / 1000);
      updates.processingTime = processingTime;
      updates.processingTimeFormatted = formatProcessingTime(processingTime);
    }

    if (typeof chrome !== 'undefined' && chrome.storage) {
      chrome.storage.local.get(['fr_database'], (result) => {
        let db = result.fr_database || { frs: {} };
        db.frs[frLower] = { ...db.frs[frLower], fr: frLower, ...updates, timestamp: new Date().toLocaleString() };
        db.lastUpdate = new Date().toISOString();
        chrome.storage.local.set({ fr_database: db }, () => resolve());
      });
    } else {
      const key = `REQ_${frLower}`;
      const existing = JSON.parse(localStorage.getItem(key) || '{}');
      localStorage.setItem(key, JSON.stringify({ ...existing, ...updates, timestamp: new Date().toLocaleString() }));
      resolve();
    }
  });
}

function formatProcessingTime(seconds) {
  if (seconds < 60) return `${seconds}ث`;
  const minutes = Math.floor(seconds / 60);
  return `${minutes}:${(seconds % 60).toString().padStart(2, '0')}د`;
}

function delay(ms) {
  return new Promise(res => setTimeout(res, ms));
}

async function closeTabSafely() {
  pageClosed = true;
  if (typeof chrome !== 'undefined' && chrome.runtime) {
    chrome.runtime.sendMessage({ action: "closeTab" });
  } else {
    window.close();
  }
}

function fastCheckUnauthorized() {
  const alertBox = document.querySelector('.flex.justify-between.w-full.p-5, [role="alert"]');
  if (alertBox) {
    const text = alertBox.textContent || '';
    if (
      text.includes('رفض') || 
      text.includes('صلاحية') || 
      text.includes('Authorized') || 
      text.includes('مصرح') ||
      text.includes('403') ||
      text.includes('Denied')
    ) {
      return true;
    }
  }
  return false;
}

async function handleUnauthorizedExit(reason = '') {
  if (pageClosed) return true;
  console.log(`❌ منع وصول أو طلب مسحوب: ${reason}`);
  const fr = currentFR || extractFR();
  if (fr) await updateFRData(fr, { message: "SUCCESS", retryCount: 0 });
  await closeTabSafely();
  return true;
}

// دالة فحص زر المعالجة/الاستلام (AR/EN)
function findProcessButton() {
  return [...document.querySelectorAll('button')].find(b => {
    const txt = b.textContent?.trim().toUpperCase();
    return txt === 'المعالجة' || txt === 'CLAIM';
  });
}

// دالة فحص زر تحميل الطلبات (AR/EN)
function findLoadButton() {
  return [...document.querySelectorAll('button')].find(b => {
    const txt = b.textContent?.trim().toUpperCase();
    return txt === 'تحميل الطلبات على نفس القطعة' || txt === 'LOAD REQUESTS';
  });
}

// ========================
// الخطوة المدمجة السريعة: تحديد حالة الطلب وزر البدء فوراً
// ========================

function detectInitialStateAndStart() {
  return new Promise((resolve) => {
    const startTime = Date.now();
    const MAX_WAIT = 3500;

    const interval = setInterval(async () => {
      if (pageClosed) {
        clearInterval(interval);
        return resolve(false);
      }

      // 1. فحص فوري لمنع الوصول
      if (fastCheckUnauthorized()) {
        clearInterval(interval);
        await handleUnauthorizedExit('Fast Alert Box');
        return resolve(false);
      }

      // 2. البحث عن الأزرار
      const processBtn = findProcessButton();
      const loadBtn = findLoadButton();

      // إذا وُجد زر المعالجة / CLAIM مباشرة
      if (processBtn) {
        clearInterval(interval);
        processStartTime = Date.now();
        console.log('⚡ زر المعالجة/CLAIM متاح فوراً');
        processBtn.click();
        return resolve(true);
      }

      // إذا وُجد زر تحميل الطلبات / LOAD REQUESTS
      if (loadBtn) {
        clearInterval(interval);
        console.log('⚡ زر تحميل الطلبات/LOAD REQUESTS متاح');
        loadBtn.click();
        
        const pBtn = await waitForProcessButton(2500);
        if (pBtn) {
          processStartTime = Date.now();
          pBtn.click();
          return resolve(true);
        } else {
          if (currentFR) await updateFRData(currentFR, { message: "SUCCESS", retryCount: 0 });
          await closeTabSafely();
          return resolve(false);
        }
      }

      // 3. تجاوز الوقت: إذا لم يظهر أي زر
      if (Date.now() - startTime > MAX_WAIT) {
        clearInterval(interval);
        console.log('⚡ لا توجد أزرار تفاعلية -> مكتمل');
        if (currentFR) await updateFRData(currentFR, { message: "SUCCESS", retryCount: 0 });
        await closeTabSafely();
        return resolve(false);
      }

    }, 50);
  });
}

function waitForProcessButton(timeout = 2500) {
  return new Promise((resolve) => {
    const start = Date.now();
    const timer = setInterval(() => {
      const btn = findProcessButton();
      if (btn) {
        clearInterval(timer);
        resolve(btn);
      } else if (Date.now() - start > timeout) {
        clearInterval(timer);
        resolve(null);
      }
    }, 50);
  });
}

// ========================
// Step 4 - الأسهم السريعة
// ========================

async function step4_clickArrowFast(maxClicks = 6, interval = 90) {
  let clicked = 0;
  let emptyRetries = 0;

  while (clicked < maxClicks) {
    if (pageClosed) return;

    const img = document.querySelector('button img[src$="left.svg"]');
    if (!img) {
      emptyRetries++;
      if (emptyRetries >= 2) break;
      await delay(120);
      continue;
    }

    emptyRetries = 0;
    const btn = img.closest("button");
    if (btn) {
      btn.dispatchEvent(new MouseEvent("click", { bubbles: true, cancelable: true, view: window }));
      clicked++;
    }
    await delay(interval);
  }
}

// ========================
// Step 5 - اختيار المشرف مباشرة (تخطي قائمة action)
// ========================

function pressKey(el, key) {
  el.dispatchEvent(new KeyboardEvent('keydown', { key, code: key, bubbles: true }));
}

async function selectSupervisorMenuFast() {
  try {
    console.log('🚀 Step5: فتح واختيار قائمة المشرف مباشرة');

    // 1. فحص وجود خيار تعيين المشرف المباشر إن كان معروضاً
    const directOption = document.querySelector('#react-select-2-option-0');
    if (directOption) {
      directOption.dispatchEvent(new MouseEvent('mousedown', { bubbles: true }));
      directOption.click();
      console.log('✅ تم اختيار خيار المشرف المباشر');
      return;
    }

    // 2. البحث عن القائمة المنسدلة واختيار الخيار الأول
    const dropdowns = document.querySelectorAll('.drop-down-box.css-b62m3t-container');
    if (dropdowns.length > 0) {
      // التعامل مع القائمة المطلوبة (سواء كانت الأولى أو الوحيدة المعروضة)
      const targetMenu = dropdowns[dropdowns.length - 1];
      const control = targetMenu.querySelector('input, [role="combobox"], .css-8mjqw9-control');

      if (control) {
        control.focus();
        await delay(50);
        pressKey(control, 'ArrowDown');
        await delay(50);
        pressKey(control, 'Enter');
        console.log('✅ تم الاختيار عبر لوحة المفاتيح');
        return;
      }
    }

    // 3. مسار بديل عبر فتح السهم (SVG Arrow)
    const arrow = document.querySelector('svg.css-8mmkcg');
    if (arrow) {
      const parent = arrow.closest('div, button, span') || arrow;
      parent.dispatchEvent(new MouseEvent('mousedown', { bubbles: true }));
      parent.click();

      await delay(120);

      const firstOpt = document.querySelector('[id*="react-select"][id*="option"]');
      if (firstOpt) {
        firstOpt.dispatchEvent(new MouseEvent('mousedown', { bubbles: true }));
        firstOpt.click();
        console.log('✅ تم اختيار أول مشرف من القائمة المفتوحة');
      }
    }
  } catch (err) {
    console.error('❌ Step5 Error:', err);
  }
}

// ========================
// Step 6 - المتابعة / Proceed والإغلاق بعد ثانية
// ========================

async function step6_clickFinalButtonAndClose() {
  try {
    const btn = [...document.querySelectorAll('button')].find(b => {
      const txt = b.textContent?.trim().toUpperCase();
      return txt === 'المتابعة' || txt === 'PROCEED';
    });

    if (!btn) {
      console.warn('⚠️ لم يتم العثور على زر المتابعة/PROCEED');
      return;
    }

    btn.click();
    console.log('✅ تم الضغط على المتابعة / Proceed');

    const frValue = currentFR || extractFR();
    if (frValue) {
      await updateFRData(frValue, { message: "SUCCESS", retryCount: 0 });
    }

    await delay(1000);
    await closeTabSafely();
  } catch (err) {
    console.error('❌ Step6 Error:', err);
  }
}

// ========================
// المحرك الرئيسي
// ========================

async function runProcess() {
  currentFR = extractFR();

  const canContinue = await detectInitialStateAndStart();
  if (!canContinue || pageClosed) return;

  await delay(150);
  await step4_clickArrowFast(6, 90);
  if (pageClosed) return;

  await delay(200);
  await selectSupervisorMenuFast();
  if (pageClosed) return;

  await delay(200);
  await step6_clickFinalButtonAndClose();
}

// بدء التشغيل الفوري
runProcess();
